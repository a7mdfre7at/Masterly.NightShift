@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections
@using System.Collections.Generic
@using System.Globalization
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Queue);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.EnqueuedCount(Queue));
    JobList<EnqueuedJobDto?> enqueuedJobs = monitor.EnqueuedJobs(Queue, pager.FromRecord, pager.RecordsPerPage);

    // The queue's health and whether it is paused: one read each for the page, none per row
    QueueHealth? health = null;
    DrainModeStatus? drain = null;
    if (!IsListRefresh)
    {
        using (IStorageConnection connection = Storage.GetReadOnlyConnection())
        {
            health = QueueInsights.Read(connection, Queue);
            drain = DrainMode.Read(connection);
        }
    }

    string? pauseReason = null;
    bool paused = drain != null && drain.PausedQueues.TryGetValue(Queue, out pauseReason);
    bool stalled = health != null && drain != null && health.IsStalled(pager.TotalRecordCount) && !paused && !drain.Active;
    TimeSpan? clearsIn = health != null ? health.EstimateDrain(pager.TotalRecordCount) : null;
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(Queue, new Dictionary<string, string>
        {
            { Strings.QueuesPage_Title, Url.LinkToQueues() }
        })

        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Queue, Strings.QueuesPage_Table_Queue, pager.TotalRecordCount)
                @if (paused || stalled)
                {
                    <div class="ns-page-facts">
                        @if (paused)
                        {
                            <span class="ns-chip ns-chip-status ns-recurring-paused" title="@pauseReason">@Html.Icon("pause-fill") @Strings.QueuesPage_Paused</span>
                        }
                        @if (stalled)
                        {
                            <span class="ns-chip ns-chip-status ns-queue-stalled" title="@Strings.QueuesPage_Stalled_Tooltip">@Html.Icon("exclamation-triangle-fill") @Strings.QueuesPage_Stalled</span>
                        }
                    </div>
                }
            </div>
            @if (pager.TotalPageCount > 0 || (!IsReadOnly && drain != null))
            {
                <div class="ns-page-actions">
                    @if (!IsReadOnly && pager.TotalPageCount > 0)
                    {
                        <button class="btn btn-sm ns-btn-outlined-error btn-delete-all"
                                data-ajax="@Url.To("/jobs/enqueued/delete-all/" + RouteValues.Encode(Queue))"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                        <span class="ns-actions-divider" aria-hidden="true"></span>
                    }
                    @if (pager.TotalPageCount > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/enqueued/export/" + RouteValues.Encode(Queue))" data-filename="nightshift-enqueued-jobs-@(Queue).csv">
                            @Html.Icon("download")
                            @Strings.Common_DownloadCsv
                        </button>
                    }
                    @if (!IsReadOnly && drain != null)
                    {
                        if (paused)
                        {
                            <button class="btn btn-sm btn-primary" data-ajax="@Url.To("/queues/resume/" + RouteValues.Encode(Queue))" data-loading-text="@Strings.QueuesPage_Resume">
                                @Html.Icon("play-fill") @Strings.QueuesPage_Resume
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm ns-btn-tonal" data-ajax="@Url.To("/queues/pause/" + RouteValues.Encode(Queue))" data-loading-text="@Strings.QueuesPage_Pause" data-confirm="@Strings.QueuesPage_PauseConfirm">
                                @Html.Icon("pause-fill") @Strings.QueuesPage_Pause
                            </button>
                        }
                    }
                </div>
            }
        </header>

        @if (health != null && health.Samples > 0)
        {
            <div class="ns-summary">
                <section class="ns-summary-tile ns-state-enqueued" aria-labelledby="queue-latency">
                    <h2 id="queue-latency" class="ns-summary-label" title="@Strings.QueuesPage_Table_Latency_Hint">@Html.Icon("hourglass-split") @Strings.QueuesPage_Table_Latency</h2>
                    <p class="ns-summary-value">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(health.MedianLatencyMs), false)</p>
                    <p class="ns-summary-sub">p95 @Html.ToHumanDuration(TimeSpan.FromMilliseconds(health.P95LatencyMs), false)</p>
                </section>
                <section class="ns-summary-tile ns-state-processing" aria-labelledby="queue-throughput">
                    <h2 id="queue-throughput" class="ns-summary-label">@Html.Icon("lightning-fill") @Strings.QueuesPage_Table_Throughput</h2>
                    <p class="ns-summary-value">@health.PerMinute.ToString("0.#", CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile ns-state-succeeded" aria-labelledby="queue-clears">
                    <h2 id="queue-clears" class="ns-summary-label">@Html.Icon("clock") @Strings.QueuesPage_Table_ClearsIn</h2>
                    @if (pager.TotalRecordCount == 0)
                    {
                        <p class="ns-summary-value ns-summary-muted">&ndash;</p>
                    }
                    else if (clearsIn.HasValue)
                    {
                        <p class="ns-summary-value">@Html.ToHumanDuration(clearsIn, false)</p>
                    }
                    else
                    {
                        <p class="ns-summary-value ns-summary-muted">&infin;</p>
                    }
                </section>
            </div>
        }

        @if (pager.TotalPageCount == 0)
        {
            @Html.EmptyState("inbox-fill", Strings.EnqueuedJobsPage_NoJobs, null, Url.LinkToQueues(), Strings.QueuesPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/jobs/enqueued/delete")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteSelected
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="ns-time-cell">@Strings.Common_Enqueued</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, EnqueuedJobDto?> job in enqueuedJobs)
                                {
                                    bool current = job.Value != null && job.Value.InEnqueuedState;
                                    <tr class="js-jobs-list-row @(current ? "hover" : "obsolete-data")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @if (current)
                                                {
                                                    @Html.JobCheckbox(job.Key)
                                                }
                                            </td>
                                        }
                                        @if (job.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="2">
                                                <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(job.Value.State)
                                                    @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                    @if (!current)
                                                    {
                                                        <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                                    }
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                    @if (!current)
                                                    {
                                                        <span>@Html.StateLabel(job.Value.State)</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="ns-time-cell">
                                                @if (job.Value.EnqueuedAt.HasValue)
                                                {
                                                    @Html.RelativeTime(job.Value.EnqueuedAt.Value)
                                                }
                                                else
                                                {
                                                    <em>@Strings.Common_NotAvailable</em>
                                                }
                                            </td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (current && !IsReadOnly)
                                                {
                                                    @Html.JobDeleteButton(Url.To("/jobs/enqueued/delete"), job.Key)
                                                }
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
