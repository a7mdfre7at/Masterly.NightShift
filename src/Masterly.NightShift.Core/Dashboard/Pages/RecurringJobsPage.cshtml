@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: true *@
@using System
@using System.Collections.Generic
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.RecurringJobsPage_Title);
	List<RecurringJobDto> recurringJobs;

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    Pager? pager = null;
    RecurringJobDto? editJob = null;

	using (IStorageConnection connection = Storage.GetReadOnlyConnection())
	{
	    JobStorageConnection? storageConnection = connection as JobStorageConnection;
	    if (storageConnection != null)
	    {
	        pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, storageConnection.GetRecurringJobCount());
	        recurringJobs = storageConnection.GetRecurringJobs(pager.FromRecord, pager.FromRecord + pager.RecordsPerPage - 1);
	    }
	    else
	    {
            recurringJobs = connection.GetRecurringJobs();
	    }

	    // /recurring?edit={id} (search, the forecast, the catalog) opens the editor for a job of any page
	    editJob = FindJobToEdit(connection, recurringJobs);
	}

    DateTime now = StorageUtcNow ?? ApplicationUtcNow;
    int lateCount = 0;
    foreach (RecurringJobDto recurringJob in recurringJobs)
    {
        if (DashboardHealth.IsLate(recurringJob, now)) lateCount++;
    }

    long total = pager != null ? pager.TotalRecordCount : recurringJobs.Count;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.RecurringJobsPage_Title, null, total)
            </div>
            <div class="ns-page-actions">
                @if (!IsReadOnly && recurringJobs.Count > 0)
                {
                    <button class="btn btn-sm ns-btn-outlined-error btn-delete-all"
                            data-ajax="@Url.To("/recurring/remove-all")"
                            data-loading-text="@Strings.Common_Deleting"
                            @Html.ConfirmAttributes(Strings.RecurringJobsPage_RemoveAllConfirm_Title, Strings.RecurringJobsPage_RemoveAllConfirm, Strings.RecurringJobsPage_RemoveAll, destructive: true)>
                        @Html.Icon("trash-fill")
                        @Strings.RecurringJobsPage_RemoveAll
                    </button>
                    <span class="ns-actions-divider" aria-hidden="true"></span>
                }
                <a href="@Url.To("/recurring/forecast")" class="btn btn-sm btn-outline-secondary">
                    @Html.Icon("calendar3")
                    @Strings.RecurringJobsPage_Forecast
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary js-manifest-export" data-url="@Url.To("/recurring/export")" title="@Strings.RecurringJobsPage_Export_Hint">
                    @Html.Icon("download")
                    @Strings.RecurringJobsPage_Export
                </button>
                @if (!IsReadOnly)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary js-manifest-import" aria-haspopup="dialog">
                        @Html.Icon("upload")
                        @Strings.RecurringJobsPage_Import
                    </button>
                }
            </div>
        </header>

        @if (recurringJobs.Count == 0)
        {
            @Html.EmptyState("clock", Strings.RecurringJobsPage_EmptyTitle, Strings.RecurringJobsPage_Empty, Url.To("/catalog"), Strings.NavigationMenu_Catalog)
        }
        else
        {
            if (lateCount > 0)
            {
                <div class="alert alert-danger">
                    @Html.Icon("clock")
                    @* Only the jobs of this page were checked; say so when there are other pages *@
                    @String.Format(pager != null && pager.TotalPageCount > 1 ? Strings.RecurringJobsPage_LateSummary_Page : Strings.RecurringJobsPage_LateSummary, lateCount)
                </div>
            }

            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/recurring/trigger")"
                                    data-loading-text="@Strings.RecurringJobsPage_Triggering"
                                    disabled="disabled">
                                @Html.Icon("play-circle")
                                @Strings.RecurringJobsPage_TriggerNow
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/recurring/pause")"
                                    data-loading-text="@Strings.RecurringJobsPage_Pausing"
                                    disabled="disabled">
                                @Html.Icon("pause-fill")
                                @Strings.RecurringJobsPage_Pause
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/recurring/resume")"
                                    data-loading-text="@Strings.RecurringJobsPage_Resuming"
                                    disabled="disabled">
                                @Html.Icon("play-fill")
                                @Strings.RecurringJobsPage_Resume
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/recurring/remove")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.RecurringJobsPage_RemoveAllConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteSelected
                            </button>
                        </div>
                    }
                    @if (pager != null)
                    {
                        @: @Html.PerPageSelector(pager)
                    }
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow ns-recurring-table" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox(Strings.RecurringJobsPage_SelectAll)
                                        </th>
                                    }
                                    <th scope="col">@Strings.RecurringJobDetailsPage_Kind</th>
                                    <th scope="col" class="ns-time-cell">@Strings.RecurringJobsPage_Table_NextExecution</th>
                                    <th scope="col" class="ns-time-cell">@Strings.RecurringJobsPage_Table_LastExecution</th>
                                    @if (!IsReadOnly)
                                    {
                                        @Html.ActionsColumnHeader()
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RecurringJobDto job in recurringJobs)
                                {
                                    string encodedId = RouteValues.Encode(job.Id);
                                    string? cronDescription = null;
                                    bool cronError = false;

                                    if (!String.IsNullOrEmpty(job.Cron))
                                    {
                                        try
                                        {
                                            RecurringJobEntity.ParseCronExpression(job.Cron);
                                            cronDescription = Cron.TryDescribe(job.Cron);
                                        }
                                        catch (Exception ex) when (ex.IsCatchableExceptionType())
                                        {
                                            cronDescription = ex.Message;
                                            cronError = true;
                                        }
                                    }

                                    <tr class="js-jobs-list-row hover@(job.Paused ? " ns-recurring-row-paused" : null)">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @Html.JobCheckbox(job.Id, String.Format(Strings.RecurringJobsPage_SelectJob, job.Id))
                                            </td>
                                        }
                                        <td class="ns-job-cell">
                                            <div class="ns-job-title">
                                                <a class="job-method" href="@Url.To("/recurring/details/" + encodedId)">@job.Id</a>
                                                @if (job.Job != null)
                                                {
                                                    <span class="ns-recurring-method">@Html.JobName(job.Job)</span>
                                                }
                                                else if (job.LoadException != null && job.LoadException.InnerException != null)
                                                {
                                                    <em class="ns-recurring-method">@job.LoadException.InnerException.Message</em>
                                                }
                                                else if (job.LoadException != null)
                                                {
                                                    <em class="ns-recurring-method">@job.LoadException.Message</em>
                                                }
                                                else
                                                {
                                                    <em class="ns-recurring-method">@Strings.Common_NotAvailable</em>
                                                }
                                            </div>
                                            <div class="ns-job-meta">
                                                <span class="ns-recurring-schedule">
                                                    @if (cronDescription != null && !cronError)
                                                    {
                                                        <span>@cronDescription</span>
                                                    }
                                                    @if (cronError)
                                                    {
                                                        <code title="@cronDescription" class="cron-badge">@Html.Icon("exclamation-circle-fill") @job.Cron</code>
                                                    }
                                                    else
                                                    {
                                                        <code class="cron-badge">@job.Cron</code>
                                                    }
                                                </span>
                                                @if (!String.IsNullOrWhiteSpace(job.TimeZoneId))
                                                {
                                                    string? displayName;
                                                    Exception? exception = null;

                                                    try
                                                    {
                                                        ITimeZoneResolver resolver = DashboardOptions.TimeZoneResolver ?? new DefaultTimeZoneResolver();
                                                        displayName = resolver.GetTimeZoneById(job.TimeZoneId).DisplayName;
                                                    }
                                                    catch (Exception ex) when (ex.IsCatchableExceptionType())
                                                    {
                                                        displayName = null;
                                                        exception = ex;
                                                    }

                                                    <span title="@displayName" data-bs-container="body">@job.TimeZoneId
                                                        @if (exception != null)
                                                        {
                                                            <span class="hf-icon" title="@exception.Message" role="img" aria-label="@exception.Message">@Html.Icon("exclamation-circle-fill")</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>UTC</span>
                                                }
                                                @Html.QueueChip(job.Queue ?? EnqueuedState.DefaultQueue)
                                                @if (job.Policy != null)
                                                {
                                                    <a class="ns-chip ns-chip-assist" href="@Url.To("/policies#policy-" + job.Policy)" title="@Strings.RecurringJobDetailsPage_Policy">@Html.Icon("calendar3") @job.Policy</a>
                                                }
                                                @if (job.Declared)
                                                {
                                                    <span class="ns-chip ns-chip-status ns-recurring-declared" title="@Strings.RecurringJobDetailsPage_Declared_Tooltip">@Html.Icon("terminal-fill") @Strings.RecurringJobDetailsPage_Declared</span>
                                                }
                                                @if (job.Paused)
                                                {
                                                    <span class="ns-chip ns-chip-status ns-recurring-paused" title="@Strings.RecurringJobsPage_Paused_Tooltip">@Html.Icon("pause-fill") @Strings.RecurringJobsPage_Paused</span>
                                                }
                                                @if (job.Retired)
                                                {
                                                    <span class="ns-chip ns-chip-status ns-recurring-retired">@Html.Icon("exclamation-triangle-fill") @Strings.RecurringJobDetailsPage_Retired</span>
                                                }
                                            </div>
                                            @if (job.Error != null)
                                            {
                                                string firstLine = job.Error.Split('\n')[0].Trim();
                                                <div class="ns-job-error">
                                                    <code class="ns-exception-type">@Strings.Common_Error</code>
                                                    <span class="ns-job-error-message">@firstLine</span>
                                                    <button type="button" class="btn btn-sm ns-btn-text js-sheet-open" aria-haspopup="dialog" data-sheet-title="@job.Id" data-sheet-overline="@Strings.Common_Error">@Strings.Common_MoreDetails</button>
                                                    <template class="js-sheet-template">
                                                        <p class="ns-sheet-lead">@firstLine</p>
                                                        <pre class="stack-trace"><code>@Html.StackTrace(job.Error)</code></pre>
                                                        <div class="js-sheet-actions">
                                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.To("/recurring/details/" + encodedId)">@String.Format(Strings.Common_ViewJob, job.Id)</a>
                                                        </div>
                                                    </template>
                                                </div>
                                            }
                                        </td>
                                        <td class="ns-time-cell ns-recurring-when" data-label="@Strings.RecurringJobsPage_Table_NextExecution">
                                            @if (job.Paused)
                                            {
                                                <span class="ns-recurring-muted" title="@Strings.RecurringJobsPage_Paused_Tooltip">@Strings.RecurringJobsPage_Paused</span>
                                            }
                                            else if (!job.NextExecution.HasValue && job.Error == null && job.EndAt.HasValue && job.EndAt.Value < now)
                                            {
                                                <span class="ns-chip ns-chip-status ns-recurring-ended" title="@Strings.RecurringJobsPage_Ended_Tooltip">@Strings.RecurringJobsPage_Ended</span>
                                                <span class="ns-time-exact">@Html.LocalTime(job.EndAt.Value)</span>
                                            }
                                            else if (!job.NextExecution.HasValue)
                                            {
                                                if (job.Error != null)
                                                {
                                                    <span class="ns-chip ns-chip-status ns-recurring-error">@Html.Icon("exclamation-circle-fill") @Strings.Common_Error</span>
                                                }
                                                else
                                                {
                                                    <span class="ns-chip ns-chip-status ns-recurring-disabled" title="@Strings.RecurringJobsPage_RecurringJobDisabled_Tooltip">@Strings.Common_Disabled</span>
                                                }
                                            }
                                            else if (job.StartAt.HasValue && job.StartAt.Value > now)
                                            {
                                                <span class="ns-recurring-muted">@Html.Raw(String.Format(Html.HtmlEncode(Strings.RecurringJobsPage_StartsAt), Html.LocalTime(job.StartAt.Value)))</span>
                                            }
                                            else if (DashboardHealth.IsLate(job, now))
                                            {
                                                <span class="ns-chip ns-chip-status ns-recurring-late" title="@Strings.RecurringJobsPage_Late_Tooltip">@Html.Icon("clock") @Strings.RecurringJobsPage_Late</span>
                                                <span class="ns-time-exact">@Html.RelativeTime(job.NextExecution.Value)</span>
                                            }
                                            else
                                            {
                                                <span class="ns-chip ns-chip-status@(job.RetryAttempt > 0 ? " ns-recurring-retrying" : null)">@Html.Icon(job.RetryAttempt > 0 ? "arrow-repeat" : "hourglass-split") @Html.RelativeTime(job.NextExecution.Value)</span>
                                                <span class="ns-time-exact">@Html.LocalTime(job.NextExecution.Value)</span>
                                            }
                                            @if (!job.Paused && job.NextExecution.HasValue && job.EndAt.HasValue)
                                            {
                                                <span class="ns-time-exact">@Html.Raw(String.Format(Html.HtmlEncode(Strings.RecurringJobsPage_EndsAt), Html.LocalTime(job.EndAt.Value)))</span>
                                            }
                                        </td>
                                        <td class="ns-time-cell ns-recurring-when" data-label="@Strings.RecurringJobsPage_Table_LastExecution">
                                            @if (job.LastExecution != null)
                                            {
                                                if (!String.IsNullOrEmpty(job.LastJobId))
                                                {
                                                    string lastState = job.LastJobState ?? EnqueuedState.StateName;
                                                    <a class="ns-recurring-last" href="@Url.JobDetails(job.LastJobId)">@Html.StateLabel(lastState, HtmlHelper.StateDisplayName(lastState), hover: true)</a>
                                                }
                                                else
                                                {
                                                    <span class="ns-recurring-last" title="@Strings.RecurringJobsPage_Canceled">@Html.StateLabel(DeletedState.StateName, Strings.RecurringJobsPage_Canceled)</span>
                                                }
                                                <span class="ns-time-exact">@Html.RelativeTime(job.LastExecution.Value) &middot; @Html.LocalTime(job.LastExecution.Value)</span>
                                            }
                                            else
                                            {
                                                <span class="ns-recurring-muted">@Strings.Common_NotAvailable</span>
                                            }
                                        </td>
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-actions-cell">
                                                <div class="ns-row-actions">
                                                    @RowAction("/recurring/trigger-one/" + encodedId, "play-circle", Strings.RecurringJobsPage_TriggerJob, job.Id, Strings.RecurringJobsPage_Triggering)
                                                    @if (job.Paused)
                                                    {
                                                        @RowAction("/recurring/resume-one/" + encodedId, "play-fill", Strings.RecurringJobsPage_ResumeJob, job.Id, Strings.RecurringJobsPage_Resuming)
                                                    }
                                                    else
                                                    {
                                                        @RowAction("/recurring/pause-one/" + encodedId, "pause-fill", Strings.RecurringJobsPage_PauseJob, job.Id, Strings.RecurringJobsPage_Pausing)
                                                    }
                                                    @EditButton(job, false)
                                                    <span class="ns-actions-divider" aria-hidden="true"></span>
                                                    <button type="button" class="ns-icon-button ns-row-danger js-job-command" data-url="@Url.To("/recurring/remove")" data-job="@job.Id" data-loading-text="@Strings.Common_Deleting" aria-label="@String.Format(Strings.RecurringJobsPage_DeleteJob, job.Id)" title="@String.Format(Strings.RecurringJobsPage_DeleteJob, job.Id)"
                                                            @Html.ConfirmAttributes(String.Format(Strings.RecurringJobsPage_DeleteConfirmOne, job.Id), Strings.RecurringJobsPage_RemoveAllConfirm, Strings.Common_Delete, destructive: true)>
                                                        @Html.Icon("trash-fill")
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (pager != null)
                {
                    @: @Html.Paginator(pager)
                }
            </div>
        }
    </div>
</div>

@if (!IsReadOnly)
{
    if (editJob != null)
    {
        @EditButton(editJob, true)
    }
    @* The schedule editor opens in the side sheet with a copy of the template; the element keeps its addresses *@
    <div id="recurringJobEditor" hidden="hidden"
         data-preview-url="@Url.To("/recurring/preview")"
         data-update-url="@Url.To("/recurring/update/")"
         data-preview-unavailable="@Strings.RecurringJobsPage_PreviewUnavailable"
         data-text-title="@Strings.RecurringJobsPage_EditSchedule">
        <template class="js-recurring-edit-template">
            <form id="recurringJobEditorForm" class="ns-sheet-form js-recurring-edit-form" novalidate="novalidate">
                <fieldset class="ns-fieldset">
                    <legend>@Strings.RecurringJobsPage_Group_When</legend>
                    <div class="ns-field">
                        <label for="recurringJobEditorCron">@Strings.RecurringJobsPage_Schedule</label>
                        <input type="text" class="form-control ns-mono js-recurring-edit-cron" id="recurringJobEditorCron" name="cron" required="required" autocomplete="off" spellcheck="false" />
                        <div class="ns-field-supporting">@Strings.RecurringJobsPage_ScheduleHint</div>
                        <p class="cron-description js-recurring-edit-description" aria-live="polite"></p>
                    </div>
                    <div class="ns-field">
                        <label for="recurringJobEditorTimeZone">@Strings.RecurringJobsPage_Table_TimeZone</label>
                        <select class="form-select js-recurring-edit-timezone" id="recurringJobEditorTimeZone" name="timezone">
                            @foreach (TimeZoneInfo zone in TimeZoneInfo.GetSystemTimeZones())
                            {
                                <option value="@zone.Id">@zone.DisplayName</option>
                            }
                        </select>
                    </div>
                </fieldset>
                <fieldset class="ns-fieldset">
                    <legend>@Strings.RecurringJobsPage_Group_How</legend>
                    <div class="ns-field">
                        <label for="recurringJobEditorQueue">@Strings.RecurringJobsPage_Queue</label>
                        <input type="text" class="form-control js-recurring-edit-queue" id="recurringJobEditorQueue" name="queue" placeholder="@EnqueuedState.DefaultQueue" autocomplete="off" spellcheck="false" />
                        <div class="ns-field-supporting">@Strings.RecurringJobsPage_QueueHint</div>
                    </div>
                    <div class="ns-field">
                        <label for="recurringJobEditorMisfire">@Strings.RecurringJobsPage_Misfire</label>
                        <select class="form-select js-recurring-edit-misfire" id="recurringJobEditorMisfire" name="misfire">
                            <option value="Relaxed">@Strings.RecurringJobsPage_Misfire_Relaxed</option>
                            <option value="Strict">@Strings.RecurringJobsPage_Misfire_Strict</option>
                            <option value="Ignorable">@Strings.RecurringJobsPage_Misfire_Ignorable</option>
                            <option value="RunLatest">@Strings.RecurringJobsPage_Misfire_RunLatest</option>
                        </select>
                    </div>
                </fieldset>
                <section class="ns-recurring-preview" aria-labelledby="recurringJobEditorNextRuns">
                    <h3 id="recurringJobEditorNextRuns">@Strings.RecurringJobsPage_NextRuns <code class="js-recurring-edit-resolved"></code></h3>
                    <ol class="ns-next-runs js-recurring-edit-preview" aria-live="polite"></ol>
                </section>
                <div class="alert alert-danger js-recurring-edit-error" role="alert" style="display: none"></div>
                <div class="js-sheet-actions">
                    <button type="button" class="btn btn-sm ns-btn-text js-sheet-close">@Strings.RecurringJobsPage_Cancel</button>
                    <button type="submit" form="recurringJobEditorForm" class="btn btn-sm btn-primary js-recurring-edit-save" data-loading-text="@Strings.RecurringJobsPage_Saving">@Strings.RecurringJobsPage_Save</button>
                </div>
            </form>
        </template>
    </div>
}

@if (!IsReadOnly)
{
    <div class="modal fade" id="manifestImport" tabindex="-1" role="dialog" aria-labelledby="manifestImportTitle" data-import-url="@Url.To("/recurring/import")" data-text-result="@Strings.RecurringJobsPage_Import_Result">
        <div class="modal-dialog" role="document">
            <form class="modal-content js-manifest-form">
                <div class="modal-header">
                    <h2 class="modal-title" id="manifestImportTitle">@Strings.RecurringJobsPage_Import_Title</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Strings.RecurringJobsPage_Cancel"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Strings.RecurringJobsPage_Import_Hint</p>
                    <div class="mb-3">
                        <textarea class="form-control hf-mono js-manifest-text" name="manifest" rows="12" spellcheck="false" aria-label="@Strings.RecurringJobsPage_Import_Title" placeholder="{ &quot;version&quot;: 1, &quot;recurringJobs&quot;: [ ... ] }"></textarea>
                    </div>
                    <div class="hf-manifest-row">
                        <label class="btn btn-sm btn-outline-secondary hf-file-button">
                            @Html.Icon("folder2-open") @Strings.RecurringJobsPage_Import_File
                            <input type="file" accept=".json,application/json" class="js-manifest-file" />
                        </label>
                        <div class="form-check form-check-inline"><input type="checkbox" class="form-check-input" id="manifestImportPrune" name="prune" value="true" /><label class="form-check-label" for="manifestImportPrune">@Strings.RecurringJobsPage_Import_Prune</label></div>
                    </div>
                    <div class="alert alert-danger js-manifest-error" style="display: none"></div>
                    <div class="alert alert-success js-manifest-result" style="display: none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Strings.RecurringJobsPage_Cancel</button>
                    <button type="submit" class="btn btn-primary js-manifest-apply" data-loading-text="@Strings.RecurringJobsPage_Import_Applying">@Strings.RecurringJobsPage_Import_Apply</button>
                </div>
            </form>
        </div>
    </div>
}
