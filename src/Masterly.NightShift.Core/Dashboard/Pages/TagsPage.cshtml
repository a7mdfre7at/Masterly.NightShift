@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.TagsPage_Title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);
    string filter = (Query("filter") ?? String.Empty).Trim();

    System.Collections.Generic.IReadOnlyList<JobTagSummary> tags;
    Pager pager;
    int allTags;

    // Tags in name order, a page at a time: only the tags shown are counted, which stays fast with many tags. The
    // filter applies to every name before paging, so it finds tags on any page.
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        IReadOnlyList<string> names = JobTags.GetNames(connection);
        allTags = names.Count;

        if (filter.Length > 0)
        {
            names = names.Where(name => name.IndexOf(filter, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
        }

        pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, names.Count)
        {
            QuerySuffix = filter.Length > 0 ? "&filter=" + Uri.EscapeDataString(filter) : null
        };
        tags = names.Skip(pager.FromRecord).Take(pager.RecordsPerPage).Select(name => new JobTagSummary(name, JobTags.Count(connection, name))).ToList();
    }

    long largest = tags.Count > 0 ? Math.Max(1, tags.Max(x => x.Count)) : 1;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.TagsPage_Title, null, allTags)
                <p class="ns-page-subtitle">@Strings.TagsPage_Hint</p>
            </div>
        </header>

        @if (allTags == 0)
        {
            <div class="ns-empty-state">
                @Html.Icon("tag-fill")
                <h2 class="ns-empty-state-title">@Strings.TagsPage_EmptyTitle</h2>
                <p>@Html.Raw(Strings.TagsPage_NoTags_Html)</p>
            </div>
        }
        else
        {
            <div class="hf-catalog-toolbar">
                <form method="get" class="hf-tags-filter-form" role="search">
                    <input type="search" name="filter" value="@filter" class="form-control js-tags-filter" placeholder="@Strings.TagsPage_Search" aria-label="@Strings.TagsPage_Search" autocomplete="off" spellcheck="false" />
                    <input type="hidden" name="count" value="@pager.RecordsPerPage" />
                </form>
                <span class="hf-catalog-summary text-muted">@pager.TotalRecordCount @Strings.TagsPage_Title.ToLowerInvariant()</span>
                @Html.PerPageSelector(pager)
            </div>

            if (tags.Count == 0)
            {
                @Html.EmptyState("search", String.Format(Strings.TagsPage_NoMatch, filter), null, Url.To("/tags"), Strings.TagsPage_Title)
            }
            else
            {
                <div class="ns-tags-cloud">
                    @foreach (JobTagSummary tag in tags)
                    {
                        <a class="ns-chip ns-chip-assist ns-tag-chip js-tag" href="@Url.To("/tags/" + RouteValues.Encode(tag.Tag))" data-tag="@tag.Tag" style="--ns-weight: @(((double)tag.Count / largest).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                            @Html.Icon("tag-fill") @tag.Tag <span class="ns-tag-count">@tag.Count</span>
                        </a>
                    }
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table hf-tags-table" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.TagsPage_Table_Tag</th>
                                    <th scope="col" class="min-width align-right">@Strings.TagsPage_Table_Jobs</th>
                                    @if (!IsReadOnly)
                                    {
                                        @Html.ActionsColumnHeader()
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (JobTagSummary tag in tags)
                                {
                                    <tr class="hover js-tag-row" data-tag="@tag.Tag">
                                        <td><a href="@Url.To("/tags/" + RouteValues.Encode(tag.Tag))" class="ns-chip ns-chip-assist ns-tag-chip">@Html.Icon("tag-fill") @tag.Tag</a></td>
                                        <td class="align-right ns-tabular">@tag.Count</td>
                                        @if (!IsReadOnly)
                                        {
                                            string forgetName = String.Format(Strings.TagsPage_ForgetTag, tag.Tag);
                                            <td class="ns-actions-cell">
                                                <div class="ns-row-actions">
                                                    <button type="button" class="ns-icon-button ns-row-danger" data-ajax="@Url.To("/tags/forget/" + RouteValues.Encode(tag.Tag))" data-loading-text="@Strings.Common_Deleting" aria-label="@forgetName" title="@forgetName"
                                                            @Html.ConfirmAttributes(Strings.TagsPage_ForgetConfirm, null, Strings.TagsPage_Forget, destructive: true)>
                                                        @Html.Icon("x-lg")
                                                    </button>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @Html.Paginator(pager)
        }
    </div>
</div>
