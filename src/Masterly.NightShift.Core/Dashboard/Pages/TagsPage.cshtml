@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.TagsPage_Title);

    System.Collections.Generic.IReadOnlyList<JobTagSummary> tags;
    using (var connection = Storage.GetReadOnlyConnection())
    {
        tags = JobTags.GetAll(connection);
    }

    var total = tags.Sum(x => x.Count);
    var largest = tags.Count > 0 ? Math.Max(1, tags[0].Count) : 1;
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">@Strings.TagsPage_Title <small class="text-muted">@Strings.TagsPage_Hint</small></h1>

        @if (tags.Count == 0)
        {
            <div class="alert alert-info">@Html.Raw(Strings.TagsPage_NoTags_Html)</div>
        }
        else
        {
            <div class="hf-catalog-toolbar">
                <input type="search" class="form-control js-tags-filter" placeholder="@Strings.TagsPage_Search" autocomplete="off" spellcheck="false" />
                <span class="hf-catalog-summary text-muted">@tags.Count @Strings.TagsPage_Title.ToLowerInvariant() &middot; @String.Format(Strings.FailedJobsPage_Clusters_Jobs, total)</span>
            </div>

            <div class="hf-tags-cloud">
                @foreach (var tag in tags)
                {
                    <a class="hf-tag hf-tag-lg js-tag" href="@Url.To("/tags/" + Uri.EscapeDataString(tag.Tag))" data-tag="@tag.Tag" style="--hf-weight: @(((double)tag.Count / largest).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                        <span class="glyphicon glyphicon-tag"></span> @tag.Tag <span class="hf-tag-count">@tag.Count</span>
                    </a>
                }
            </div>

            <div class="table-responsive hf-card">
                <table class="table hf-tags-table" aria-describedby="page-title">
                    <thead>
                        <tr>
                            <th>@Strings.TagsPage_Table_Tag</th>
                            <th class="min-width align-right">@Strings.TagsPage_Table_Jobs</th>
                            @if (!IsReadOnly)
                            {
                                <th class="min-width"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in tags)
                        {
                            <tr class="js-tag-row" data-tag="@tag.Tag">
                                <td><a href="@Url.To("/tags/" + Uri.EscapeDataString(tag.Tag))" class="hf-tag"><span class="glyphicon glyphicon-tag"></span> @tag.Tag</a></td>
                                <td class="align-right">@tag.Count</td>
                                @if (!IsReadOnly)
                                {
                                    <td>
                                        <button class="btn btn-xs btn-default" data-ajax="@Url.To("/tags/forget/" + Uri.EscapeDataString(tag.Tag))" data-loading-text="@Strings.Common_Deleting" data-confirm="@Strings.TagsPage_ForgetConfirm">
                                            <span class="glyphicon glyphicon-remove"></span> @Strings.TagsPage_Forget
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
