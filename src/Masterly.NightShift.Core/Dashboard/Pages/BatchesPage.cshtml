@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.BatchesPage_Title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IReadOnlyList<JobBatch> batches;
    Pager pager;

    // Read only: expired batches are skipped here and removed from the index when new batches start
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, BatchJob.Count(connection));
        batches = BatchJob.List(connection, pager.FromRecord, pager.RecordsPerPage);
    }
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.BatchesPage_Title, null, pager.TotalRecordCount)
                <p class="ns-page-subtitle">@Strings.BatchesPage_Hint</p>
            </div>
        </header>

        @if (batches.Count == 0)
        {
            <div class="ns-empty-state">
                @Html.Icon("grid-fill")
                <h2 class="ns-empty-state-title">@Strings.BatchesPage_EmptyTitle</h2>
                <p>@Html.Raw(Strings.BatchesPage_NoBatches_Html)</p>
            </div>
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow hf-batches" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.BatchesPage_Table_Batch</th>
                                    <th scope="col" class="ns-progress-cell">@Strings.BatchesPage_Table_Progress</th>
                                    <th scope="col" class="min-width align-right">@Strings.BatchesPage_Table_Jobs</th>
                                    <th scope="col" class="ns-time-cell">@Strings.BatchesPage_Table_Created</th>
                                    @if (!IsReadOnly)
                                    {
                                        @Html.ActionsColumnHeader()
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (JobBatch batch in batches)
                                {
                                    string url = Url.To("/batches/" + RouteValues.Encode(batch.Id));
                                    double percent = BatchDetailsPage.FinishedPercent(batch);
                                    string counts = String.Format(Strings.BatchesPage_Counts, batch.Succeeded, batch.Failed, batch.Pending);

                                    <tr class="hover hf-row-link" data-href="@url">
                                        <td class="ns-job-cell">
                                            <div class="ns-job-title">
                                                @Html.StateDot(BatchDetailsPage.StatusState(batch))
                                                <a class="job-method" href="@url">@(batch.Description ?? batch.Id)</a>
                                            </div>
                                            <div class="ns-job-meta">
                                                @if (batch.Description != null)
                                                {
                                                    <code class="ns-job-id">@batch.Id</code>
                                                }
                                                @BatchDetailsPage.StatusLabel(Html, batch)
                                            </div>
                                        </td>
                                        <td class="ns-progress-cell">
                                            <div class="ns-progress-text"><span>@counts</span></div>
                                            <div class="ns-meter" role="progressbar" aria-label="@Strings.BatchesPage_Table_Progress" aria-valuetext="@counts" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent.ToString("0", CultureInfo.InvariantCulture)">
                                                <span style="width: @percent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
                                            </div>
                                        </td>
                                        <td class="align-right ns-tabular">@batch.Total</td>
                                        <td class="ns-time-cell">
                                            @if (batch.CreatedAt.HasValue)
                                            {
                                                @Html.RelativeTime(batch.CreatedAt.Value)
                                            }
                                        </td>
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-actions-cell">
                                                <div class="ns-row-actions">
                                                    @if (batch.Failed > 0)
                                                    {
                                                        string requeueName = String.Format(Strings.BatchesPage_RequeueFailed, batch.Description ?? batch.Id);
                                                        <button type="button" class="ns-icon-button" data-ajax="@Url.To("/batches/requeue-failed/" + RouteValues.Encode(batch.Id))" data-loading-text="@Strings.Common_Enqueueing" aria-label="@requeueName" title="@requeueName">
                                                            @Html.Icon("arrow-repeat")
                                                        </button>
                                                    }
                                                    @if (batch.Pending + batch.Failed > 0)
                                                    {
                                                        string deleteName = String.Format(Strings.BatchesPage_DeletePending, batch.Description ?? batch.Id);
                                                        <button type="button" class="ns-icon-button ns-row-danger" data-ajax="@Url.To("/batches/delete/" + RouteValues.Encode(batch.Id))" data-loading-text="@Strings.Common_Deleting" aria-label="@deleteName" title="@deleteName"
                                                                @Html.ConfirmAttributes(Strings.BatchDetailsPage_DeletePendingConfirm, null, Strings.Common_Delete, destructive: true)>
                                                            @Html.Icon("trash-fill")
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
