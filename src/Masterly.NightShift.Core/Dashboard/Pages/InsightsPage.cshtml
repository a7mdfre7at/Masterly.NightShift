@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.InsightsPage_Title);

    IReadOnlyList<JobInsight> insights = new List<JobInsight>();
    List<CircuitBreakerAttribute.CircuitState> circuits = [];
    bool supported;

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        // Insights are kept in lists and counters, which only storages with the extended API can read
        supported = connection is JobStorageConnection && Storage.HasFeature(JobStorageFeatures.ExtendedApi);

        if (supported)
        {
            insights = JobInsightsAttribute.ReadAll(connection);
            circuits = connection.GetAllItemsFromSet(CircuitBreakerAttribute.CircuitsSetKey)
                .Select(resource => CircuitBreakerAttribute.ReadCircuit(connection, resource))
                .OrderBy(circuit => circuit.State == CircuitBreakerAttribute.ClosedState ? 1 : 0)
                .ThenBy(circuit => circuit.Resource)
                .ToList();
        }
    }

    JobInvokerStatistics invokers = JobInvokerRegistry.GetStatistics();
    long totalRuns = insights.Sum(x => x.Total);
    long totalFailed = insights.Sum(x => x.Failed);
    DateTime now = StorageUtcNow ?? ApplicationUtcNow;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.InsightsPage_Title)
            </div>
        </header>

        @if (!supported)
        {
            <div class="alert alert-warning">@Strings.InsightsPage_NotSupported</div>
        }
        else
        {
            <div class="ns-summary insights-summary">
                <section class="ns-summary-tile" aria-labelledby="insights-methods">
                    <h2 id="insights-methods" class="ns-summary-label">@Html.Icon("list-task") @Strings.InsightsPage_Summary_Methods</h2>
                    <p class="ns-summary-value insights-tile-value">@insights.Count</p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="insights-runs">
                    <h2 id="insights-runs" class="ns-summary-label">@Html.Icon("play-circle") @Strings.InsightsPage_Summary_Runs</h2>
                    <p class="ns-summary-value insights-tile-value">@totalRuns.ToString("N0")</p>
                </section>
                <section class="ns-summary-tile@(totalRuns > 0 && totalFailed * 10 > totalRuns ? " ns-state-failed insights-tile-danger" : null)" aria-labelledby="insights-failure-rate">
                    <h2 id="insights-failure-rate" class="ns-summary-label">@Html.Icon("x-circle-fill") @Strings.InsightsPage_Summary_FailureRate</h2>
                    <p class="ns-summary-value insights-tile-value">@(totalRuns == 0 ? "–" : ((double)totalFailed / totalRuns).ToString("P1"))</p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="insights-invokers" title="@Strings.InsightsPage_Summary_Invokers_Hint">
                    <h2 id="insights-invokers" class="ns-summary-label">@Html.Icon("lightning-fill") @Strings.InsightsPage_Summary_Invokers</h2>
                    <p class="ns-summary-value insights-tile-value">
                        <span class="badge text-bg-success">@invokers.Generated</span>
                        <span class="badge text-bg-info">@invokers.Compiled</span>
                        <span class="badge text-bg-secondary">@invokers.Reflection</span>
                    </p>
                </section>
            </div>

            List<JobInsight> anomalies = insights.Where(x => x.IsAnomalous).ToList();
            if (insights.Count > 0)
            {
                <div class="ns-section-head">
                    <h2 id="insights-anomalies">@Strings.InsightsPage_Anomalies</h2>
                    <span class="ns-section-hint">@Strings.InsightsPage_Anomalies_Hint</span>
                </div>
                if (anomalies.Count == 0)
                {
                    <div class="hf-card hf-anomalies hf-anomalies-ok">@Html.Icon("check-circle", "text-success") @Strings.InsightsPage_Anomalies_None</div>
                }
                else
                {
                    <div class="hf-card hf-anomalies" role="group" aria-labelledby="insights-anomalies">
                        @foreach (JobInsight anomaly in anomalies)
                        {
                            <div class="hf-anomaly">
                                @Html.Icon("exclamation-circle-fill", "text-warning")
                                <code>@anomaly.Key</code>
                                <span class="hf-anomaly-reasons">
                                    @if (anomaly.IsSlowingDown)
                                    {
                                        <span class="badge text-bg-warning">@String.Format(Strings.InsightsPage_Anomaly_SlowingDown, Html.ToHumanDuration(TimeSpan.FromMilliseconds(anomaly.RecentMedianMs), false), Html.ToHumanDuration(TimeSpan.FromMilliseconds(anomaly.EarlierMedianMs), false))</span>
                                    }
                                    @if (anomaly.HasHighFailureRate)
                                    {
                                        <span class="badge text-bg-danger">@String.Format(Strings.InsightsPage_Anomaly_FailureRate, anomaly.FailureRate.ToString("P0"))</span>
                                    }
                                    @if (anomaly.LastRunWasSlow)
                                    {
                                        <span class="badge text-bg-warning">@String.Format(Strings.InsightsPage_Anomaly_SlowRun, Html.ToHumanDuration(TimeSpan.FromMilliseconds(anomaly.LastDurationMs), false))</span>
                                    }
                                </span>
                                @if (anomaly.LastJobId != null)
                                {
                                    <span class="hf-anomaly-link">@Html.JobIdLink(anomaly.LastJobId)</span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            {
                @* Activity heatmap: seven days, hour by hour *@
                DateTime heatNow = StorageUtcNow ?? ApplicationUtcNow;
                IReadOnlyList<IReadOnlyList<HeatmapCell>> heatRows = ActivityHeatmap.Read(Storage, heatNow);
                long heatMax = ActivityHeatmap.Max(heatRows);

                <div class="ns-section-head">
                    <h2 id="insights-heatmap">@Strings.InsightsPage_Heatmap</h2>
                    <span class="ns-section-hint">@Strings.InsightsPage_Heatmap_Hint</span>
                </div>
                <div class="hf-card hf-heatmap-card" role="group" aria-labelledby="insights-heatmap">
                    @if (ActivityHeatmap.IsEmpty(heatRows))
                    {
                        <p class="text-muted hf-heatmap-empty">@Strings.InsightsPage_Heatmap_Empty</p>
                    }
                    <div class="hf-heatmap">
                        <div class="hf-heatmap-corner"></div>
                        @for (int hour = 0; hour < 24; hour++)
                        {
                            <div class="hf-heatmap-hour">@(hour % 3 == 0 ? hour.ToString("00", System.Globalization.CultureInfo.InvariantCulture) : "")</div>
                        }
                        @foreach (IReadOnlyList<HeatmapCell> row in heatRows)
                        {
                            <div class="hf-heatmap-day">@row[0].HourUtc.ToString("ddd", System.Globalization.CultureInfo.CurrentCulture)</div>
                            foreach (HeatmapCell cell in row)
                            {
                                double intensity = cell.Total == 0 ? 0 : Math.Max(0.15, Math.Sqrt((double)cell.Total / heatMax));
                                bool future = cell.HourUtc > heatNow;
                                <div class="hf-heatmap-cell @(future ? "hf-heatmap-future" : cell.Failed > cell.Succeeded ? "hf-heatmap-bad" : null)"
                                     style="--hf-heat: @intensity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                     title="@String.Format(Strings.InsightsPage_Heatmap_Cell, cell.HourUtc.ToString("ddd HH:00", System.Globalization.CultureInfo.CurrentCulture), cell.Succeeded, cell.Failed)"></div>
                            }
                        }
                    </div>
                </div>
            }

            if (circuits.Count > 0)
            {
                <section class="hf-card ns-table-card" aria-labelledby="insights-circuits">
                    <div class="hf-card-header">
                        <h2 id="insights-circuits">@Strings.InsightsPage_Circuits</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table ns-table-reflow" aria-labelledby="insights-circuits">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.InsightsPage_Circuits_Resource</th>
                                    <th scope="col" class="min-width">@Strings.Common_State</th>
                                    <th scope="col" class="min-width">@Strings.InsightsPage_Circuits_Failures</th>
                                    <th scope="col" class="min-width align-right">@Strings.InsightsPage_Circuits_Since</th>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="min-width"><span class="visually-hidden">@Strings.Common_Actions</span></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CircuitBreakerAttribute.CircuitState circuit in circuits)
                                {
                                    string labelClass = circuit.State == CircuitBreakerAttribute.OpenState ? "text-bg-danger"
                                        : circuit.State == CircuitBreakerAttribute.HalfOpenState ? "text-bg-warning"
                                        : "text-bg-success";

                                    <tr>
                                        <td class="word-break"><code>@circuit.Resource</code></td>
                                        <td class="min-width"><span class="badge @labelClass text-uppercase">@circuit.State</span></td>
                                        <td class="min-width">@circuit.Failures</td>
                                        <td class="min-width align-right">
                                            @if (circuit.OpenedAt > DateTime.MinValue)
                                            {
                                                @Html.RelativeTime(circuit.OpenedAt)
                                            }
                                        </td>
                                        @if (!IsReadOnly)
                                        {
                                            <td class="min-width">
                                                @if (circuit.State != CircuitBreakerAttribute.ClosedState || circuit.Failures > 0)
                                                {
                                                    <button class="btn hf-btn-xs btn-outline-secondary" data-ajax="@Url.To("/insights/circuits/reset/" + RouteValues.Encode(circuit.Resource))" data-loading-text="@Strings.InsightsPage_Circuits_Reset">
                                                        @Html.Icon("arrow-clockwise") @Strings.InsightsPage_Circuits_Reset
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            if (insights.Count == 0)
            {
                <div class="ns-note">
                    @Html.Icon("info-circle-fill")
                    <span class="ns-note-text">@Html.Raw(Strings.InsightsPage_NoData_Html)</span>
                </div>
            }
            else
            {
                @* The job's name with its invoker and last run under it, and the three durations in one column, so the
                   table fits a 1024px window *@
                <section class="hf-card ns-table-card" aria-labelledby="insights-jobs">
                    <div class="hf-card-header">
                        <h2 id="insights-jobs">@Strings.Common_Job</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table insights-table ns-table-reflow" aria-labelledby="insights-jobs">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="min-width align-right">@Strings.InsightsPage_Table_Runs</th>
                                    <th scope="col" class="min-width align-right">@Strings.InsightsPage_Table_Failed</th>
                                    <th scope="col" class="min-width align-right">@Strings.InsightsPage_Table_Median <span class="text-muted">/ @Strings.InsightsPage_Table_P95 / @Strings.InsightsPage_Table_Max</span></th>
                                    <th scope="col" class="min-width">@Strings.InsightsPage_Table_Trend</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (JobInsight insight in insights)
                                {
                                    string failureClass = insight.FailureRate >= 0.25 ? "text-bg-danger" : insight.FailureRate > 0 ? "text-bg-warning" : "text-bg-secondary";

                                    <tr>
                                        <td class="ns-job-cell word-break">
                                            <div class="ns-job-title">
                                                <code>@insight.Key</code>
                                                @if (insight.LastRunWasSlow)
                                                {
                                                    <span class="hf-icon text-warning" title="@Strings.InsightsPage_SlowRun_Tooltip" role="img" aria-label="@Strings.InsightsPage_SlowRun_Tooltip">@Html.Icon("exclamation-triangle-fill")</span>
                                                }
                                            </div>
                                            <div class="ns-job-meta">
                                                @if (insight.Invoker != null)
                                                {
                                                    string invokerClass = insight.Invoker == "Generated" ? "text-bg-success" : insight.Invoker == "Compiled" ? "text-bg-info" : "text-bg-secondary";
                                                    <span class="badge @invokerClass" title="@Strings.InsightsPage_Table_Invoker">@insight.Invoker</span>
                                                }
                                                @if (insight.LastRunAt.HasValue)
                                                {
                                                    <span title="@Strings.InsightsPage_Table_LastRun">
                                                        @if (insight.LastJobId != null)
                                                        {
                                                            <a href="@Url.JobDetails(insight.LastJobId)" class="text-decoration-none">@Html.RelativeTime(insight.LastRunAt.Value)</a>
                                                        }
                                                        else
                                                        {
                                                            @Html.RelativeTime(insight.LastRunAt.Value)
                                                        }
                                                        (@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.LastDurationMs), false)?.Trim())
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="min-width align-right">@insight.Total.ToString("N0")</td>
                                        <td class="min-width align-right">
                                            <span class="badge @failureClass">@insight.Failed.ToString("N0") (@insight.FailureRate.ToString("P0"))</span>
                                        </td>
                                        <td class="min-width align-right ns-insight-durations">
                                            @Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.MedianMs), false)
                                            <div class="ns-job-meta">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.P95Ms), false) / @Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.MaxMs), false)</div>
                                        </td>
                                        <td class="min-width">@Sparkline.Render(insight.Durations, 96, 26, insight.LastFailed)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    </div>
</div>
