@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.RetriesPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    Pager? pager = null;
    List<string>? jobIds = null;

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        JobStorageConnection? storageConnection = connection as JobStorageConnection;

        // Paging through the "retries" set needs the extended API
        if (storageConnection != null && Storage.HasFeature(JobStorageFeatures.ExtendedApi))
        {
            pager = new Pager(@from, perPage, DashboardOptions.DefaultRecordsPerPage, storageConnection.GetSetCount("retries"));
            jobIds = storageConnection.GetRangeFromSet("retries", pager.FromRecord, pager.FromRecord + pager.RecordsPerPage - 1);
        }
    }
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.RetriesPage_Title, null, pager?.TotalRecordCount)
            </div>
            @if (jobIds != null && jobIds.Count > 0 && !IsReadOnly)
            {
                <div class="ns-page-actions">
                    <button class="btn btn-sm ns-btn-outlined-error btn-delete-all"
                            data-ajax="@Url.To("/retries/delete-all")"
                            data-loading-text="@Strings.Common_Deleting"
                            @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                        @Html.Icon("trash-fill")
                        @Strings.Common_DeleteAll
                    </button>
                </div>
            }
        </header>

        @if (pager == null || jobIds == null)
        {
            <div class="ns-note" role="note">
                @Html.Icon("info-circle-fill")
                <div class="ns-note-text">@Html.Raw(String.Format(Strings.RetriesPage_Warning_Html, Url.To("/jobs/scheduled")))</div>
            </div>
        }
        else if (jobIds.Count == 0)
        {
            @Html.EmptyState("check-circle", Strings.RetriesPage_NoJobs, null, Url.To("/jobs/failed"), Strings.FailedJobsPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/jobs/scheduled/enqueue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("play-fill")
                                @Strings.Common_EnqueueButton_Text
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/jobs/scheduled/delete")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteSelected
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="min-width">@Strings.Common_Retry</th>
                                    <th scope="col" class="ns-time-cell">@Strings.Common_Created</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (string jobId in jobIds)
                                {
                                    JobData? jobData;
                                    StateData? stateData;

                                    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
                                    {
                                        jobData = connection.GetJobData(jobId);
                                        stateData = connection.GetStateData(jobId);
                                    }

                                    <tr class="js-jobs-list-row @(jobData != null ? "hover" : "obsolete-data")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @Html.JobCheckbox(jobId)
                                            </td>
                                        }
                                        @if (jobData == null)
                                        {
                                            <td class="ns-job-cell" colspan="3">
                                                <div class="ns-job-title">@Html.JobIdLink(jobId)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(jobData.State)
                                                    @Html.JobNameLink(jobId, jobData.Job, false)
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(jobId)</span>
                                                    <span>@Html.StateLabel(jobData.State)</span>
                                                    @if (jobData.Job?.Queue != null)
                                                    {
                                                        @Html.QueueChip(jobData.Job.Queue)
                                                    }
                                                </div>
                                                @if (!String.IsNullOrEmpty(stateData?.Reason))
                                                {
                                                    <div class="ns-job-error">
                                                        <span class="ns-job-error-message">@stateData.Reason</span>
                                                    </div>
                                                }
                                            </td>
                                            <td class="min-width" data-label="@Strings.Common_Retry">
                                                @{ DateTime? retryAt = stateData != null && stateData.Data.TryGetValue("EnqueueAt", out string? enqueueAt) ? StateDataValues.ReadDateTime(enqueueAt) : null; }
                                                @if (retryAt.HasValue)
                                                {
                                                    @Html.RelativeTime(retryAt.Value)
                                                }
                                            </td>
                                            <td class="ns-time-cell">@Html.RelativeTime(jobData.CreatedAt)</td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (jobData != null && !IsReadOnly)
                                                {
                                                    @Html.JobCommandButton(Url.To("/jobs/scheduled/enqueue"), jobId, "play-fill", Strings.Common_EnqueueJob)
                                                    @Html.JobDeleteButton(Url.To("/jobs/scheduled/delete"), jobId)
                                                }
                                                @Html.CopyJobIdButton(jobId)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
