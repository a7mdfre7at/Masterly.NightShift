@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.RetriesPage_Title);
    
    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    Pager? pager = null;
    List<string>? jobIds = null;

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        JobStorageConnection? storageConnection = connection as JobStorageConnection;

        // Paging through the "retries" set needs the extended API
        if (storageConnection != null && Storage.HasFeature(JobStorageFeatures.ExtendedApi))
        {
            pager = new Pager(@from, perPage, DashboardOptions.DefaultRecordsPerPage, storageConnection.GetSetCount("retries"));
            jobIds = storageConnection.GetRangeFromSet("retries", pager.FromRecord, pager.FromRecord + pager.RecordsPerPage - 1);
        }
    }
}

@if (pager == null)
{
    <div class="alert alert-warning">
        @Html.Raw(String.Format(Strings.RetriesPage_Warning_Html, Url.To("/jobs/scheduled")))
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <h1 id="page-title" class="hf-page-header">@Strings.RetriesPage_Title</h1>
            @if (jobIds!.Count == 0)
            {
                <div class="alert alert-success">
                    @Strings.RetriesPage_NoJobs
                </div>
            }
            else
            {
                <div class="js-jobs-list">
                    <div class="btn-toolbar btn-toolbar-top">
                        @if (!IsReadOnly)
                        {
                            <button class="btn btn-sm btn-outline-secondary btn-delete-all"
                                    data-ajax="@Url.To("/retries/delete-all")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteAll
                            </button>
                        }
                        @if (!IsReadOnly)
                        {
                            <button class="js-jobs-list-command btn btn-sm btn-primary"
                                    data-url="@Url.To("/jobs/scheduled/enqueue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("arrow-repeat")
                                @Strings.Common_EnqueueButton_Text
                            </button>
                        }
                        @if (!IsReadOnly)
                        {
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/jobs/scheduled/delete")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("x-lg")
                                @Strings.Common_DeleteSelected
                            </button>
                        }
                        @Html.PerPageSelector(pager)
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="min-width">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col" class="min-width">@Strings.Common_Id</th>
                                    <th scope="col" class="min-width">@Strings.Common_State</th>
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col">@Strings.Common_Reason</th>
                                    <th scope="col" class="align-right">@Strings.Common_Retry</th>
                                    <th scope="col" class="align-right">@Strings.Common_Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (string jobId in jobIds)
                                {
                                    JobData? jobData;
                                    StateData? stateData;

                                    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
                                    {
                                        jobData = connection.GetJobData(jobId);
                                        stateData = connection.GetStateData(jobId);
                                    }

                                    <tr class="js-jobs-list-row @(jobData != null ? "hover" : null)">
                                        @if (!IsReadOnly)
                                        {
                                            <td>
                                                @Html.JobCheckbox(jobId)
                                            </td>
                                        }
                                        <td class="min-width">
                                            @Html.JobIdLink(jobId)
                                        </td>
                                        @if (jobData == null)
                                        {
                                            <td colspan="5"><em>Job expired.</em></td>
                                        }
                                        else
                                        {
                                            <td class="min-width">
                                                @Html.StateLabel(jobData.State)
                                            </td>
                                            <td class="word-break">
                                                @Html.JobNameLink(jobId, jobData.Job)
                                            </td>
                                            <td>
                                                @(stateData?.Reason)
                                            </td>
                                            <td class="align-right">
                                                @{ DateTime? retryAt = stateData != null && stateData.Data.TryGetValue("EnqueueAt", out string? enqueueAt) ? StateDataValues.ReadDateTime(enqueueAt) : null; }
                                                @if (retryAt.HasValue)
                                                {
                                                    @Html.RelativeTime(retryAt.Value)
                                                }
                                            </td>
                                            <td class="align-right">
                                                @Html.RelativeTime(jobData.CreatedAt)
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @Html.Paginator(pager)
                </div>
            }
        </div>
    </div>
}