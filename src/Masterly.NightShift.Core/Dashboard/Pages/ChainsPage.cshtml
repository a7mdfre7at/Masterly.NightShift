@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.ChainsPage_Title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    Pager? pager;
    List<JobChainInfo> chains = ReadChains(from, perPage, out pager);
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">@Strings.ChainsPage_Title</h1>

        @if (chains.Count == 0)
        {
            <div class="alert alert-info">@Strings.ChainsPage_NoChains</div>
        }
        else
        {
            if (pager != null && pager.TotalPageCount > 1)
            {
                <div class="btn-toolbar btn-toolbar-top">
                    @Html.PerPageSelector(pager)
                </div>
            }
            <div class="table-responsive">
                <table class="table" aria-describedby="page-title">
                    <thead>
                        <tr>
                            <th class="min-width">@Strings.Common_Id</th>
                            <th class="min-width">@Strings.Common_State</th>
                            <th>@Strings.ChainsPage_FirstStep</th>
                            <th class="min-width">@Strings.ChainsPage_Steps</th>
                            <th class="align-right">@Strings.Common_Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (JobChainInfo chain in chains)
                        {
                            JobChainStepInfo? first = chain.Steps.FirstOrDefault();
                            <tr class="hover">
                                <td class="min-width"><a href="@Url.To("/chains/" + chain.ChainId)"><code>@chain.ChainId.Substring(0, Math.Min(8, chain.ChainId.Length))</code></a></td>
                                <td class="min-width">@StatusLabel(chain)</td>
                                <td class="word-break">@(first?.Job != null ? Html.JobName(first.Job) : String.Empty)</td>
                                <td class="min-width">@chain.Steps.Count</td>
                                <td class="align-right">@Html.RelativeTime(chain.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            if (pager != null)
            {
                @Html.Paginator(pager)
            }
        }
    </div>
</div>
