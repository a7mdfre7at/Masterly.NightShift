@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.ChainsPage_Title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    Pager? pager;
    List<JobChainInfo> chains = ReadChains(from, perPage, out pager);
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.ChainsPage_Title, null, pager != null ? pager.TotalRecordCount : chains.Count)
            </div>
        </header>

        @if (chains.Count == 0)
        {
            @Html.EmptyState("shuffle", Strings.ChainsPage_EmptyTitle, Strings.ChainsPage_EmptyText)
        }
        else
        {
            if (pager != null && pager.TotalPageCount > 1)
            {
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @Html.PerPageSelector(pager)
                </div>
            }
            <div class="hf-card ns-table-card">
                <div class="table-responsive">
                    <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                        <thead>
                            <tr>
                                <th scope="col">@Strings.ChainsPage_FirstStep</th>
                                <th scope="col" class="ns-progress-cell">@Strings.ChainsPage_Steps</th>
                                <th scope="col" class="ns-time-cell">@Strings.Common_Created</th>
                                @if (!IsReadOnly)
                                {
                                    @Html.ActionsColumnHeader()
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (JobChainInfo chain in chains)
                            {
                                JobChainStepInfo? first = chain.Steps.FirstOrDefault();
                                ChainFlowStatus status = ChainFlowchart.StatusOf(chain);
                                ChainStepCounts counts = CountSteps(chain);
                                string url = Url.To("/chains/" + RouteValues.Encode(chain.ChainId));
                                string shortId = chain.ChainId.Substring(0, Math.Min(8, chain.ChainId.Length));
                                <tr class="hover hf-row-link" data-href="@url">
                                    <td class="ns-job-cell">
                                        <div class="ns-job-title">
                                            @Html.StateDot(ChainFlowchart.StatusState(status))
                                            <a class="job-method" href="@url">@(first?.Job != null ? Html.JobName(first.Job) : String.Format(Strings.ChainDetailsPage_Title, shortId))</a>
                                        </div>
                                        <div class="ns-job-meta">
                                            <code class="ns-job-id">@shortId</code>
                                            @StatusLabel(Html, chain)
                                        </div>
                                    </td>
                                    <td class="ns-progress-cell">
                                        <div class="ns-progress-text">
                                            <span>@String.Format(Strings.BatchesPage_Counts, counts.Succeeded, counts.Failed, counts.Pending)</span>
                                        </div>
                                        <div class="ns-meter" role="progressbar" aria-label="@Strings.ChainsPage_Steps" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@counts.Percent.ToString("0", CultureInfo.InvariantCulture)">
                                            <span style="width: @counts.Percent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
                                        </div>
                                    </td>
                                    <td class="ns-time-cell">@Html.RelativeTime(chain.CreatedAt)</td>
                                    @if (!IsReadOnly)
                                    {
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (!chain.IsSettled)
                                                {
                                                    string deleteName = String.Format(Strings.ChainsPage_DeleteChain, shortId);
                                                    <button type="button" class="ns-icon-button ns-row-danger" data-ajax="@Url.To("/chains/delete/" + RouteValues.Encode(chain.ChainId))" data-loading-text="@Strings.Common_Deleting" aria-label="@deleteName" title="@deleteName"
                                                            @Html.ConfirmAttributes(Strings.ChainDetailsPage_DeleteConfirm, null, Strings.Common_Delete, destructive: true)>
                                                        @Html.Icon("trash-fill")
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            if (pager != null)
            {
                @Html.Paginator(pager)
            }
        }
    </div>
</div>
