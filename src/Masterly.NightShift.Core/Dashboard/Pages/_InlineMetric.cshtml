@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True TrimLeadingUnderscores : true *@
@using Masterly.NightShift.Dashboard
@inherits RazorPage
@{
    Metric? metric = DashboardMetric.Func(this);
    string className = metric == null ? "metric-null" : metric.Style.ToClassName();
    string? highlighted = metric != null && metric.Highlighted ? "highlighted" : null;
}
<span data-metric="@DashboardMetric.Name" class="metric @className @highlighted">@(metric?.Value)</span>