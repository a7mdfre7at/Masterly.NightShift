@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.FailedJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.FailedCount());
    JobList<FailedJobDto?> failedJobs = monitor.FailedJobs(pager.FromRecord, pager.RecordsPerPage);

    // Acknowledgements left on the listed jobs. There is no API to read the notes of many jobs at once, so only
    // the first rows of a long page are checked, one read per job.
    const int MaxAcknowledgementReads = 100;
    Dictionary<string, JobNote> acknowledgements = [];
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        foreach (KeyValuePair<string, FailedJobDto?> failedJob in failedJobs.Take(MaxAcknowledgementReads))
        {
            if (failedJob.Value == null || !failedJob.Value.InFailedState) continue;
            JobNote? ack = JobNotes.GetAcknowledgement(JobNotes.Read(connection, failedJob.Key));
            if (ack != null) acknowledgements[failedJob.Key] = ack;
        }
    }
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="hf-page-header">@Strings.FailedJobsPage_Title</h1>

        @if (pager.TotalPageCount == 0)
        {
            <div class="alert alert-success">
               @Strings.FailedJobsPage_NoJobs
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                @Html.Raw(Strings.FailedJobsPage_FailedJobsNotExpire_Warning_Html)
            </div>

            @* A live refresh only uses the list: the clusters read five pages of failed jobs *@
            IReadOnlyList<FailureCluster> clusters = IsListRefresh ? (IReadOnlyList<FailureCluster>)new List<FailureCluster>() : FailureClusters.Build(monitor);
            if (clusters.Count > 0)
            {
                <section class="hf-card hf-clusters" aria-labelledby="failed-clusters">
                    <div class="hf-card-header">
                        <h3 id="failed-clusters">@Html.Icon("grid-fill") @Strings.FailedJobsPage_Clusters <small class="text-muted">@String.Format(Strings.FailedJobsPage_Clusters_Hint, FailureClusters.SampleSize)</small></h3>
                    </div>
                    <div class="hf-cluster-list">
                        @foreach (FailureCluster cluster in clusters)
                        {
                            <div class="hf-cluster" data-cluster="@cluster.Key">
                                <div class="hf-cluster-count" title="@String.Format(Strings.FailedJobsPage_Clusters_Jobs, cluster.Count)">@cluster.Count</div>
                                <div class="hf-cluster-body">
                                    <div class="hf-cluster-title"><span class="hf-cluster-exception">@cluster.ExceptionType</span> <code class="hf-cluster-method">@cluster.Method</code></div>
                                    @if (!String.IsNullOrEmpty(cluster.SampleMessage))
                                    {
                                        <div class="hf-cluster-message text-muted">@cluster.SampleMessage</div>
                                    }
                                    <div class="hf-cluster-meta text-muted">
                                        @if (cluster.FirstFailedAt.HasValue)
                                        {
                                            <span>@Strings.FailedJobsPage_Clusters_FirstSeen @Html.RelativeTime(cluster.FirstFailedAt.Value)</span>
                                        }
                                        @if (cluster.LastFailedAt.HasValue)
                                        {
                                            <span>&middot; @Strings.FailedJobsPage_Clusters_LastSeen @Html.RelativeTime(cluster.LastFailedAt.Value)</span>
                                        }
                                    </div>
                                </div>
                                @if (!IsReadOnly)
                                {
                                    <div class="hf-cluster-actions">
                                        <button type="button" class="btn btn-sm btn-primary js-cluster-command" data-url="@Url.To("/jobs/failed/requeue")" data-jobs="@DashboardJson.Serialize(cluster.JobIds)" data-loading-text="@Strings.Common_Enqueueing">
                                            @Html.Icon("arrow-repeat") @String.Format(Strings.FailedJobsPage_Clusters_Requeue, cluster.Count)
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary js-cluster-command" data-url="@Url.To("/jobs/failed/delete")" data-jobs="@DashboardJson.Serialize(cluster.JobIds)" data-confirm="@Strings.FailedJobsPage_Clusters_DeleteConfirm" data-confirm-destructive="true" data-loading-text="@Strings.Common_Deleting">
                                            @Html.Icon("x-lg") @String.Format(Strings.FailedJobsPage_Clusters_Delete, cluster.Count)
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/failed/export")" data-filename="nightshift-failed-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm btn-outline-secondary btn-delete-all"
                                data-ajax="@Url.To("/jobs/failed/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                        <button class="btn btn-sm btn-outline-secondary btn-requeue-all"
                                data-ajax="@Url.To("/jobs/failed/requeue-all")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                @Html.ConfirmAttributes(Strings.FailedJobsPage_RequeueAllConfirm_Title, Strings.FailedJobsPage_RequeueAllConfirm)>
                            @Html.Icon("arrow-repeat")
                            @Strings.FailedJobsPage_RequeueAll
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-primary"
                                data-url="@Url.To("/jobs/failed/requeue")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                disabled="disabled">
                            @Html.Icon("arrow-repeat")
                            @Strings.Common_RequeueJobs
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                data-url="@Url.To("/jobs/failed/delete")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne">
                            @Html.Icon("x-lg")
                            @Strings.Common_DeleteSelected
                        </button>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="table-responsive">
                    <table class="table" aria-describedby="page-title">
                        <thead>
                            <tr>
                                @if (!IsReadOnly)
                                {
                                    <th scope="col" class="min-width">
                                        @Html.SelectAllCheckbox()
                                    </th>
                                }
                                <th scope="col" class="min-width">@Strings.Common_Id</th>
                                <th scope="col">@Strings.Common_Job</th>
                                <th scope="col" class="align-right">@Strings.FailedJobsPage_Table_Failed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = 0; }
                            @foreach (KeyValuePair<string, FailedJobDto?> job in failedJobs)
                            {
                                <tr class="js-jobs-list-row @(job.Value == null || !job.Value.InFailedState ? "obsolete-data" : null) @(job.Value != null && job.Value.InFailedState ? "hover" : null)">
                                    @if (!IsReadOnly)
                                    {
                                        <td rowspan="@(job.Value != null && job.Value.InFailedState ? "2" : "1")">
                                            @if (job.Value != null && job.Value.InFailedState)
                                            {
                                                @Html.JobCheckbox(job.Key)
                                            }
                                        </td>
                                    }
                                    <td class="min-width" rowspan="@(job.Value != null && job.Value.InFailedState ? "2" : "1")">
                                        @Html.JobIdLink(job.Key)
                                        @if (job.Value != null && !job.Value.InFailedState)
                                        {
                                            <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                        }
                                    </td>
                                    @if (job.Value == null)
                                    {
                                        <td colspan="2">
                                            <em>@Strings.Common_JobExpired</em>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <div class="word-break">
                                                @Html.JobNameLink(job.Key, job.Value.Job)
                                                @if (acknowledgements.TryGetValue(job.Key, out JobNote? acknowledgement))
                                                {
                                                    <span class="badge text-bg-info hf-ack" title="@((acknowledgement.User ?? Strings.Common_Anonymous) + (acknowledgement.Text.Length > 0 ? ": " + acknowledgement.Text : String.Empty))">@Html.Icon("check-lg") @Strings.FailedJobsPage_Acknowledged</span>
                                                }
                                            </div>
                                            @if (!String.IsNullOrEmpty(job.Value.ExceptionMessage) || !String.IsNullOrEmpty(job.Value.ExceptionDetails))
                                            {
                                                <div class="text-muted">
                                                    @job.Value.Reason <a class="expander" href="#">@(index == 0 ? Strings.Common_LessDetails : Strings.Common_MoreDetails)</a>
                                                </div>
                                            }
                                        </td>
                                        <td class="align-right">
                                            @if (job.Value.FailedAt.HasValue)
                                            {
                                                @Html.RelativeTime(job.Value.FailedAt.Value)
                                            }
                                        </td>
                                    }
                                </tr>
                                if (job.Value != null && job.Value.InFailedState)
                                {
                                    <tr>
                                        <td colspan="2" class="failed-job-details">
                                            @{
                                                string? displayCss = index++ == 0 ? "display-block" : null;
                                                string? serverId = job.Value.StateData != null && job.Value.StateData.ContainsKey("ServerId") ? $" ({Html.ServerId(job.Value.StateData["ServerId"])})" : null;
                                            }
                                            <div class="expandable @displayCss">
                                                <h4>@job.Value.ExceptionType@Html.Raw(serverId)</h4>
                                                <p class="text-muted">
                                                    @job.Value.ExceptionMessage
                                                </p>

                                                @if (!String.IsNullOrEmpty(job.Value.ExceptionDetails))
                                                {
                                                    <pre class="stack-trace"><code>@Html.StackTrace(job.Value.ExceptionDetails)</code></pre>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>