@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.FailedJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.FailedCount());
    JobList<FailedJobDto?> failedJobs = monitor.FailedJobs(pager.FromRecord, pager.RecordsPerPage);

    // Acknowledgements left on the listed jobs. There is no API to read the notes of many jobs at once, so only
    // the first rows of a long page are checked, one read per job.
    const int MaxAcknowledgementReads = 100;
    Dictionary<string, JobNote> acknowledgements = [];
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        foreach (KeyValuePair<string, FailedJobDto?> failedJob in failedJobs.Take(MaxAcknowledgementReads))
        {
            if (failedJob.Value == null || !failedJob.Value.InFailedState) continue;
            JobNote? ack = JobNotes.GetAcknowledgement(JobNotes.Read(connection, failedJob.Key));
            if (ack != null) acknowledgements[failedJob.Key] = ack;
        }
    }
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.FailedJobsPage_Title, null, pager.TotalRecordCount)
            </div>
            @if (pager.TotalPageCount > 0)
            {
                <div class="ns-page-actions">
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm ns-btn-outlined-error btn-delete-all"
                                data-ajax="@Url.To("/jobs/failed/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                        <span class="ns-actions-divider" aria-hidden="true"></span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/failed/export")" data-filename="nightshift-failed-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm btn-primary btn-requeue-all"
                                data-ajax="@Url.To("/jobs/failed/requeue-all")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                @Html.ConfirmAttributes(Strings.FailedJobsPage_RequeueAllConfirm_Title, Strings.FailedJobsPage_RequeueAllConfirm)>
                            @Html.Icon("arrow-repeat")
                            @Strings.FailedJobsPage_RequeueAll
                        </button>
                    }
                </div>
            }
        </header>

        @if (pager.TotalPageCount == 0)
        {
            @Html.EmptyState("check-circle", Strings.FailedJobsPage_NoJobs, null, Url.To("/jobs/succeeded"), Strings.SucceededJobsPage_Title)
        }
        else
        {
            if (!IsListRefresh)
            {
                <div class="ns-note js-note" data-note="failed-jobs-retention" role="note">
                    @Html.Icon("info-circle-fill")
                    <div class="ns-note-text">@Html.Raw(Strings.FailedJobsPage_FailedJobsNotExpire_Warning_Html)</div>
                    <button type="button" class="ns-icon-button ns-icon-button-sm js-note-dismiss" aria-label="@Strings.Common_Dismiss" title="@Strings.Common_Dismiss">@Html.Icon("x-lg")</button>
                </div>
            }

            @* A live refresh only uses the list: the clusters read five pages of failed jobs *@
            IReadOnlyList<FailureCluster> clusters = IsListRefresh ? (IReadOnlyList<FailureCluster>)new List<FailureCluster>() : FailureClusters.Build(monitor);
            if (clusters.Count > 0)
            {
                <section class="ns-clusters hf-clusters" aria-labelledby="failed-clusters">
                    <div class="ns-section-head">
                        <h2 id="failed-clusters">@Strings.FailedJobsPage_Clusters</h2>
                        <span class="ns-section-hint">@String.Format(Strings.FailedJobsPage_Clusters_Hint, FailureClusters.SampleSize)</span>
                    </div>
                    <div class="hf-cluster-list">
                        @foreach (FailureCluster cluster in clusters)
                        {
                            <div class="hf-cluster" data-cluster="@cluster.Key">
                                <div class="hf-cluster-count" title="@String.Format(Strings.FailedJobsPage_Clusters_Jobs, cluster.Count)">@cluster.Count</div>
                                <div class="hf-cluster-body">
                                    <div class="hf-cluster-title"><span class="hf-cluster-exception" title="@cluster.ExceptionType">@(cluster.ExceptionType.LastIndexOf('.') > 0 ? cluster.ExceptionType.Substring(cluster.ExceptionType.LastIndexOf('.') + 1) : cluster.ExceptionType)</span> <code class="hf-cluster-method">@cluster.Method</code></div>
                                    @if (!String.IsNullOrEmpty(cluster.SampleMessage))
                                    {
                                        <div class="hf-cluster-message text-muted">@cluster.SampleMessage</div>
                                    }
                                    <div class="hf-cluster-meta text-muted">
                                        @if (cluster.FirstFailedAt.HasValue)
                                        {
                                            <span>@Strings.FailedJobsPage_Clusters_FirstSeen @Html.RelativeTime(cluster.FirstFailedAt.Value)</span>
                                        }
                                        @if (cluster.LastFailedAt.HasValue)
                                        {
                                            <span>&middot; @Strings.FailedJobsPage_Clusters_LastSeen @Html.RelativeTime(cluster.LastFailedAt.Value)</span>
                                        }
                                    </div>
                                </div>
                                @if (!IsReadOnly)
                                {
                                    <div class="hf-cluster-actions">
                                        <button type="button" class="btn btn-sm ns-btn-tonal js-cluster-command" data-url="@Url.To("/jobs/failed/requeue")" data-jobs="@DashboardJson.Serialize(cluster.JobIds)" data-loading-text="@Strings.Common_Enqueueing">
                                            @Html.Icon("arrow-repeat") @String.Format(Strings.FailedJobsPage_Clusters_Requeue, cluster.Count)
                                        </button>
                                        <button type="button" class="btn btn-sm ns-btn-text ns-btn-text-error js-cluster-command" data-url="@Url.To("/jobs/failed/delete")" data-jobs="@DashboardJson.Serialize(cluster.JobIds)" data-confirm="@Strings.FailedJobsPage_Clusters_DeleteConfirm" data-confirm-destructive="true" data-loading-text="@Strings.Common_Deleting">
                                            @Html.Icon("trash-fill") @String.Format(Strings.FailedJobsPage_Clusters_Delete, cluster.Count)
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/jobs/failed/requeue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("arrow-repeat")
                                @Strings.Common_RequeueJobs
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/jobs/failed/delete")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteSelected
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="ns-time-cell">@Strings.FailedJobsPage_Table_Failed</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, FailedJobDto?> job in failedJobs)
                                {
                                    bool current = job.Value != null && job.Value.InFailedState;
                                    <tr class="js-jobs-list-row @(current ? "hover" : "obsolete-data")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @if (current)
                                                {
                                                    @Html.JobCheckbox(job.Key)
                                                }
                                            </td>
                                        }
                                        @if (job.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="2">
                                                <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            string? serverId = job.Value.StateData != null && job.Value.StateData.TryGetValue("ServerId", out string? server) ? server : null;
                                            string? exceptionType = job.Value.ExceptionType;
                                            string? shortType = exceptionType != null && exceptionType.LastIndexOf('.') > 0 ? exceptionType.Substring(exceptionType.LastIndexOf('.') + 1) : exceptionType;
                                            bool withDetails = !String.IsNullOrEmpty(job.Value.ExceptionMessage) || !String.IsNullOrEmpty(job.Value.ExceptionDetails);
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(FailedState.StateName)
                                                    @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                    @if (!current)
                                                    {
                                                        <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                                    }
                                                    @if (acknowledgements.TryGetValue(job.Key, out JobNote? acknowledgement))
                                                    {
                                                        <span class="badge text-bg-info hf-ack" title="@((acknowledgement.User ?? Strings.Common_Anonymous) + (acknowledgement.Text.Length > 0 ? ": " + acknowledgement.Text : String.Empty))">@Html.Icon("check-lg") @Strings.FailedJobsPage_Acknowledged</span>
                                                    }
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                    @if (job.Value.Job?.Queue != null)
                                                    {
                                                        @Html.QueueChip(job.Value.Job.Queue)
                                                    }
                                                    @if (serverId != null)
                                                    {
                                                        <span>@Html.ServerId(serverId)</span>
                                                    }
                                                </div>
                                                <div class="ns-job-error">
                                                    @if (!String.IsNullOrEmpty(shortType))
                                                    {
                                                        <code class="ns-exception-type" title="@exceptionType">@shortType</code>
                                                    }
                                                    <span class="ns-job-error-message">@(!String.IsNullOrEmpty(job.Value.ExceptionMessage) ? job.Value.ExceptionMessage : job.Value.Reason)</span>
                                                    @if (withDetails)
                                                    {
                                                        <button type="button" class="btn btn-sm ns-btn-text js-sheet-open" aria-haspopup="dialog" data-sheet-title="@Html.JobName(job.Value.Job, false)" data-sheet-overline="@HtmlHelper.ShortJobId(job.Key)" data-sheet-url="@Url.To("/jobs/failed/details/" + RouteValues.Encode(job.Key))">@Strings.Common_MoreDetails</button>
                                                    }
                                                </div>
                                            </td>
                                            <td class="ns-time-cell">@(job.Value.FailedAt.HasValue ? Html.RelativeTime(job.Value.FailedAt.Value) : null)</td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (current && !IsReadOnly)
                                                {
                                                    @Html.JobCommandButton(Url.To("/jobs/failed/requeue"), job.Key, "arrow-repeat", Strings.Common_RequeueJob)
                                                    @Html.JobDeleteButton(Url.To("/jobs/failed/delete"), job.Key)
                                                }
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
