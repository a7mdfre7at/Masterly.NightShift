@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True TrimLeadingUnderscores : true *@
@using Masterly.NightShift.Dashboard.Resources;
@inherits Masterly.NightShift.Dashboard.RazorPage

@if (_pager.TotalPageCount > 1)
{
    <div class="btn-group paginator float-end d-none d-md-inline-flex">
        <a href="@_pager.PageUrl(_pager.CurrentPage > 1 ? _pager.CurrentPage - 1 : 0)" class="btn btn-outline-secondary btn-sm @(_pager.CurrentPage == 1 ? "disabled" : null)">
            @Strings.Paginator_Prev
        </a>
        <a href="@_pager.PageUrl(_pager.CurrentPage < _pager.TotalPageCount ? _pager.CurrentPage + 1 : 0)" class="btn btn-outline-secondary btn-sm @(_pager.CurrentPage == _pager.TotalPageCount ? "disabled" : null)">
            @Strings.Paginator_Next
        </a>
    </div>
}
    <div class="btn-group float-end paginator">
        @foreach (int count in new[] { 10, 20, 50, 100, 500, Pager.MaxRecordsPerPage })
        {
            <a class="btn btn-sm btn-outline-secondary @(count == _pager.RecordsPerPage ? "active" : null) @(count > 999 ? "d-none d-xl-inline-block" : null)" 
                   href="@_pager.RecordsPerPageUrl(count)">@count.ToString("N0")</a>    
        }
    </div>
    <div class="btn-toolbar-spacer float-end d-none d-md-block"></div>
    <div class="btn-toolbar-label btn-toolbar-label-sm float-end d-none d-md-block">
        @Strings.PerPageSelector_ItemsPerPage:
    </div>
