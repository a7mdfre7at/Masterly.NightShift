@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.CatalogPage_Title);

    IReadOnlyList<JobCatalogEntry> entries = JobCatalog.GetEntries();
    Dictionary<string, JobInsight> insightsByKey = new(StringComparer.Ordinal);

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        if (connection is JobStorageConnection storageConnection)
        {
            // Only the methods JobInsightsAttribute has recorded (one read of its index), not four reads per method
            HashSet<string> recorded = connection.GetAllItemsFromSet(JobInsightsAttribute.IndexKey) ?? new HashSet<string>();

            foreach (string key in entries.Select(e => e.InsightsKey).Distinct(StringComparer.Ordinal).Where(recorded.Contains))
            {
                JobInsight? insight = JobInsightsAttribute.Read(storageConnection, key);
                if (insight != null) insightsByKey[key] = insight;
            }
        }
    }

    int typeCount = entries.Select(e => e.Type).Distinct().Count();
    int groupNumber = 0;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.CatalogPage_Title, null, entries.Count)
                <p class="ns-page-subtitle">@Strings.CatalogPage_Hint</p>
            </div>
        </header>

        @if (entries.Count == 0)
        {
            <div class="ns-empty-state">
                @Html.Icon("book-fill")
                <h2 class="ns-empty-state-title">@Strings.CatalogPage_EmptyTitle</h2>
                <p>@Html.Raw(Strings.CatalogPage_NoEntries_Html)</p>
            </div>
        }
        else
        {
            <div class="hf-catalog-toolbar">
                <div class="ns-catalog-search">
                    @Html.Icon("search")
                    <label for="catalogFilter" class="visually-hidden">@Strings.CatalogPage_Search</label>
                    <input type="search" id="catalogFilter" class="form-control js-catalog-filter" placeholder="@Strings.CatalogPage_Search" autocomplete="off" spellcheck="false" />
                </div>
                <span class="hf-catalog-summary">@entries.Count @Strings.CatalogPage_Summary_Methods &middot; @typeCount @Strings.CatalogPage_Summary_Types</span>
            </div>

            foreach (IGrouping<Type, JobCatalogEntry> group in entries.GroupBy(e => e.Type))
            {
                string groupId = "catalog-type-" + (groupNumber++).ToString(CultureInfo.InvariantCulture);
                <section class="hf-card ns-table-card hf-catalog-group js-catalog-group" data-type="@group.Key.FullName" aria-labelledby="@groupId">
                    <div class="hf-card-header">
                        <h2 id="@groupId">@TypeHeading(group.Key)</h2>
                        <span class="ns-count-chip">@group.Count() @Strings.CatalogPage_Summary_Methods</span>
                    </div>
                    <ul class="ns-list ns-catalog-list">
                        @foreach (JobCatalogEntry entry in group)
                        {
                            JobInsight? insight = insightsByKey.TryGetValue(entry.InsightsKey, out JobInsight? found) ? found : null;
                            List<JobCatalogParameter> userParameters = entry.UserParameters.ToList();
                            string runName = String.Format(Strings.CatalogPage_RunMethod, JobMethodCallRenderer.GetNameWithoutGenericArity(entry.Type) + "." + entry.Method.Name);

                            <li class="ns-list-item js-catalog-entry" data-search="@(entry.Type.FullName + " " + entry.Method.Name + " " + String.Join(" ", userParameters.Select(p => p.Name)))">
                                <div class="ns-list-item-body">
                                    <div class="ns-job-title">
                                        <code class="hf-catalog-method">@(entry.IsAsync ? "async " : null)@entry.Method.Name</code>
                                        @if (entry.Method.IsStatic)
                                        {
                                            <span class="ns-chip ns-chip-status ns-catalog-flag">@Strings.CatalogPage_Static</span>
                                        }
                                        @Signature(entry)
                                    </div>
                                    <div class="ns-job-meta">
                                        @Facts(entry)
                                        @if (insight != null)
                                        {
                                            <span class="hf-catalog-stats">
                                                <span title="@Strings.InsightsPage_Table_Runs">@insight.Total.ToString("N0")&times;</span>
                                                <span title="@Strings.InsightsPage_Table_Median">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.MedianMs), false)</span>
                                                @if (insight.Failed > 0)
                                                {
                                                    <span class="ns-catalog-failures" title="@Strings.InsightsPage_Table_Failed">@insight.FailureRate.ToString("P0")</span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (!IsReadOnly)
                                {
                                    <div class="ns-list-item-end ns-row-actions">
                                        <button type="button" class="ns-icon-button js-catalog-run" aria-haspopup="dialog" aria-label="@runName" title="@runName"
                                                data-id="@entry.Id"
                                                data-type="@JobMethodCallRenderer.GetNameWithoutGenericArity(entry.Type)"
                                                data-method="@entry.Method.Name"
                                                data-parameters="@DashboardJson.Serialize(userParameters.Select(p => JobCatalog.GetFormField(p, JobCatalog.FormatDefault(p.DefaultValue), false)).ToArray())">
                                            @Html.Icon("play-fill")
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            <div class="ns-empty-state ns-empty-state-compact js-catalog-nomatch" hidden="hidden">
                @Html.Icon("search")
                <p>@Strings.CatalogPage_NoMatch</p>
            </div>
        }
    </div>
</div>

@Html.RenderPartial(new JobRunner())
