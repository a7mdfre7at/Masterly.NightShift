@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Server
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.ProcessingJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    var monitor = Storage.GetMonitoringApi();
    var pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.ProcessingCount());
    var processingJobs = monitor.ProcessingJobs(pager.FromRecord, pager.RecordsPerPage);
    var servers = monitor.Servers();

    var progressByJob = new Dictionary<string, JobProgress>();
    var deadlineByJob = new Dictionary<string, DateTime?>();
    var insightByJob = new Dictionary<string, JobInsight>();
    using (var connection = Storage.GetReadOnlyConnection())
    {
        var storageConnection = connection as JobStorageConnection;
        var insightCache = new Dictionary<string, JobInsight>();

        foreach (var processingJob in processingJobs)
        {
            if (processingJob.Value != null && processingJob.Value.InProcessingState)
            {
                progressByJob[processingJob.Key] = JobConsole.ReadProgress(connection, processingJob.Key);
                deadlineByJob[processingJob.Key] = DeadlineAttribute.ReadDeadline(connection, processingJob.Key);

                if (storageConnection != null && processingJob.Value.Job != null)
                {
                    var key = JobInsightsAttribute.GetKey(processingJob.Value.Job);
                    if (!insightCache.TryGetValue(key, out var insight))
                    {
                        insight = JobInsightsAttribute.Read(storageConnection, key);
                        insightCache[key] = insight;
                    }

                    if (insight != null) insightByJob[processingJob.Key] = insight;
                }
            }
        }
    }

    var now = StorageUtcNow ?? ApplicationUtcNow;
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">@Strings.ProcessingJobsPage_Title</h1>

        @if (pager.TotalPageCount == 0)
        {
            <div class="alert alert-info">
                @Strings.ProcessingJobsPage_NoJobs
            </div>
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top">
                    <button type="button" class="btn btn-sm btn-default js-download" data-url="@Url.To("/jobs/processing/export")" data-filename="nightshift-processing-jobs.csv">
                        <span class="glyphicon glyphicon-download-alt"></span>
                        @Strings.Common_DownloadCsv
                    </button>
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm btn-default btn-delete-all"
                                data-ajax="@Url.To("/jobs/processing/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                data-confirm="@Strings.Common_DeleteAllConfirm">
                            <span class="glyphicon glyphicon-trash"></span>
                            @Strings.Common_DeleteAll
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-primary"
                                data-url="@Url.To("/jobs/processing/requeue")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                disabled="disabled">
                            <span class="glyphicon glyphicon-repeat"></span>
                            @Strings.Common_RequeueJobs
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-default"
                                data-url="@Url.To("/jobs/processing/delete")"
                                data-loading-text="@Strings.Common_Deleting"
                                data-confirm="@Strings.Common_DeleteConfirm"
                                disabled="disabled">
                            <span class="glyphicon glyphicon-remove"></span>
                            @Strings.Common_DeleteSelected
                        </button>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="table-responsive">
                    <table class="table" aria-describedby="page-title">
                        <thead>
                            <tr>
                                @if (!IsReadOnly)
                                {
                                    <th class="min-width">
                                        <input type="checkbox" class="js-jobs-list-select-all"/>
                                    </th>
                                }
                                <th class="min-width">@Strings.Common_Id</th>
                                <th class="min-width">@Strings.Common_Server</th>
                                <th>@Strings.Common_Job</th>
                                <th class="min-width">@Strings.ProcessingJobsPage_Table_Progress</th>
                                <th class="align-right">@Strings.ProcessingJobsPage_Table_Started</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in processingJobs)
                            {
                                var deadline = deadlineByJob.TryGetValue(job.Key, out var d) ? d : null;
                                var overdue = deadline.HasValue && deadline.Value < now;

                                <tr class="js-jobs-list-row @(job.Value == null || !job.Value.InProcessingState ? "obsolete-data" : null) @(job.Value != null && job.Value.InProcessingState ? "hover" : null) @(overdue ? "overdue" : null)">
                                    @if (!IsReadOnly)
                                    {
                                        <td>
                                            @if (job.Value != null && job.Value.InProcessingState)
                                            {
                                                <input type="checkbox" class="js-jobs-list-checkbox" name="jobs[]" value="@job.Key"/>
                                            }
                                        </td>
                                    }
                                    <td class="min-width">
                                        @Html.JobIdLink(job.Key)
                                        @if (job.Value != null && !job.Value.InProcessingState)
                                        {
                                            <span title="@Strings.Common_JobStateChanged_Text" class="glyphicon glyphicon-question-sign"></span>
                                        }
                                    </td>
                                    @if (job.Value == null)
                                    {
                                        <td colspan="4"><em>@Strings.Common_JobExpired</em></td>
                                    }
                                    else if (!job.Value.InProcessingState)
                                    {
                                        <td colspan="4">@Strings.Common_JobStateChanged_Text</td>
                                    }
                                    else
                                    {
                                        <td class="min-width">
                                            @Html.ServerId(job.Value.ServerId)
                                        </td>
                                        <td class="word-break">
                                            @if (servers.All(x => x.Name != job.Value.ServerId || x.Heartbeat < (StorageUtcNow ?? ApplicationUtcNow).Add(DashboardOptions.ServerPossiblyAbortedThreshold.Negate())))
                                            {
                                                <span title="@Strings.ProcessingJobsPage_Aborted" class="glyphicon glyphicon-warning-sign glyphicon-sm text-warning"></span>
                                            }

                                            @Html.JobNameLink(job.Key, job.Value.Job)
                                            @if (overdue)
                                            {
                                                <span class="label label-danger text-uppercase" title="@Strings.Common_Overdue_Tooltip">@Strings.Common_Overdue</span>
                                            }
                                            else if (deadline.HasValue)
                                            {
                                                <span class="label label-default" title="@Strings.Common_Deadline">@Strings.Common_Deadline @Html.RelativeTime(deadline.Value)</span>
                                            }
                                        </td>
                                        <td class="min-width job-live-cell js-live-row" data-job-id="@job.Key">
                                            @{
                                                var jobProgress = progressByJob.TryGetValue(job.Key, out var p) ? p : null;
                                                var jobPercent = jobProgress != null ? jobProgress.Percent : 0;
                                                var jobInsight = insightByJob.TryGetValue(job.Key, out var ins) ? ins : null;
                                                var expectedEnd = jobInsight != null && job.Value.StartedAt.HasValue ? jobInsight.EstimateCompletion(job.Value.StartedAt.Value) : null;
                                                var etaPercent = 0;
                                                string etaText = null;
                                                var etaLate = false;

                                                if (jobProgress == null && expectedEnd.HasValue && job.Value.StartedAt.HasValue)
                                                {
                                                    var elapsed = now - job.Value.StartedAt.Value;
                                                    var remaining = expectedEnd.Value - now;
                                                    etaLate = elapsed.TotalMilliseconds > Math.Max(jobInsight.P95Ms, jobInsight.MedianMs * 2);
                                                    etaPercent = (int)Math.Min(97, Math.Max(2, 100.0 * elapsed.Ticks / Math.Max(1, (expectedEnd.Value - job.Value.StartedAt.Value).Ticks)));
                                                    etaText = etaLate
                                                        ? Strings.ProcessingJobsPage_LongerThanUsual
                                                        : String.Format(Strings.ProcessingJobsPage_Eta, Html.ToHumanDuration(TimeSpan.FromSeconds(Math.Max(1, Math.Ceiling(remaining.TotalSeconds))), false));
                                                }
                                            }
                                            <div class="progress job-live-progress-sm @(etaText != null ? "job-live-progress-eta" : null) @(etaLate ? "job-live-progress-late" : null)" title="@(jobProgress != null ? jobProgress.Message : etaText != null ? Strings.ProcessingJobsPage_Eta_Tooltip : null)">
                                                <div class="progress-bar progress-bar-striped active js-live-bar" role="progressbar" style="width: @(jobProgress != null ? jobPercent : etaPercent)%"></div>
                                            </div>
                                            <small class="text-muted js-live-progress-message" data-eta="@etaText">@(jobProgress != null ? (jobProgress.Percent + "% " + jobProgress.Message) : etaText)</small>
                                        </td>
                                        <td class="align-right">
                                            @if (job.Value.StartedAt.HasValue)
                                            {
                                                @Html.RelativeTime(job.Value.StartedAt.Value)
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>