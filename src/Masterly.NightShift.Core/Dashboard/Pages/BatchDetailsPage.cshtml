@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    JobBatch batch;
    var jobs = new List<KeyValuePair<string, JobData>>();
    var continuations = new List<KeyValuePair<string, JobData>>();
    const int maxJobsShown = 500;
    Pager pager = null;

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    using (var connection = Storage.GetReadOnlyConnection())
    {
        batch = BatchJob.Get(connection, Id);

        if (batch != null)
        {
            IEnumerable<string> jobIds;
            var storageConnection = connection as JobStorageConnection;

            if (storageConnection != null && Storage.HasFeature(JobStorageFeatures.ExtendedApi))
            {
                // One page of the batch's jobs, instead of every id of a batch of any size
                var jobsKey = BatchJob.GetJobsKey(Id);
                pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, storageConnection.GetSetCount(jobsKey));
                jobIds = storageConnection.GetRangeFromSet(jobsKey, pager.FromRecord, pager.FromRecord + pager.RecordsPerPage - 1) ?? new List<string>();
            }
            else
            {
                // Without ranges the storage reads the whole set; the first jobs are shown
                jobIds = BatchJob.GetJobIds(connection, Id).Take(maxJobsShown);
            }

            foreach (var jobId in jobIds)
            {
                jobs.Add(new KeyValuePair<string, JobData>(jobId, connection.GetJobData(jobId)));
            }

            foreach (var jobId in batch.Continuations)
            {
                continuations.Add(new KeyValuePair<string, JobData>(jobId, connection.GetJobData(jobId)));
            }
        }
    }

    var title = batch != null ? (batch.Description ?? String.Format(Strings.BatchDetailsPage_Title, batch.Id)) : String.Format(Strings.BatchDetailsPage_Title, Id);
    Layout = new LayoutPage(title);
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">
            @Html.Breadcrumbs(title, new Dictionary<string, string> { { Strings.BatchesPage_Title, Url.To("/batches") } })
        </h1>

        @if (batch == null)
        {
            <div class="alert alert-warning">@String.Format(Strings.BatchDetailsPage_Expired, Id)</div>
        }
        else
        {
            var total = Math.Max(1, batch.Total);
            var stateCss = batch.IsFinished ? "label-success" : batch.IsStuck ? "label-danger" : "label-info";
            var stateText = batch.IsFinished ? Strings.BatchesPage_State_Finished : batch.IsStuck ? Strings.BatchesPage_State_Failed : Strings.BatchesPage_State_Running;

            <section class="hf-card hf-batch-summary">
                <div class="hf-batch-head">
                    <div>
                        <span class="label @stateCss text-uppercase">@stateText</span>
                        <code class="hf-batch-id">@batch.Id</code>
                        @if (batch.CreatedAt.HasValue)
                        {
                            <span class="text-muted">&middot; @Strings.BatchesPage_Table_Created @Html.RelativeTime(batch.CreatedAt.Value)</span>
                        }
                    </div>
                    @if (!IsReadOnly)
                    {
                        <div class="hf-batch-actions">
                            @if (batch.Failed > 0)
                            {
                                <button class="btn btn-sm btn-primary" data-ajax="@Url.To("/batches/requeue-failed/" + Uri.EscapeDataString(batch.Id))" data-loading-text="@Strings.Common_Enqueueing">
                                    <span class="glyphicon glyphicon-repeat"></span> @String.Format(Strings.BatchDetailsPage_RequeueFailed, batch.Failed)
                                </button>
                            }
                            @if (batch.Pending + batch.Failed > 0)
                            {
                                <button class="btn btn-sm btn-default" data-ajax="@Url.To("/batches/delete/" + Uri.EscapeDataString(batch.Id))" data-loading-text="@Strings.Common_Deleting" data-confirm="@Strings.BatchDetailsPage_DeletePendingConfirm">
                                    <span class="glyphicon glyphicon-remove"></span> @String.Format(Strings.BatchDetailsPage_DeletePending, batch.Pending + batch.Failed)
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="hf-batch-bar hf-batch-bar-lg">
                    <span class="hf-batch-seg hf-batch-seg-success" style="width: @((100.0 * batch.Succeeded / total).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                    <span class="hf-batch-seg hf-batch-seg-failed" style="width: @((100.0 * batch.Failed / total).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                    <span class="hf-batch-seg hf-batch-seg-processing" style="width: @((100.0 * batch.Processing / total).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                    <span class="hf-batch-seg hf-batch-seg-deleted" style="width: @((100.0 * batch.Deleted / total).ToString("0.#", CultureInfo.InvariantCulture))%"></span>
                </div>

                <div class="hf-batch-stats">
                    <div class="hf-batch-stat"><span class="hf-batch-stat-value">@batch.Total</span><span class="hf-batch-stat-label">@Strings.BatchesPage_Table_Jobs</span></div>
                    @foreach (var state in BatchJob.TrackedStates)
                    {
                        var count = batch.Count(state);
                        if (count == 0) continue;
                        <div class="hf-batch-stat"><span class="hf-batch-stat-value">@count</span><span class="hf-batch-stat-label">@Html.StateLabel(state)</span></div>
                    }
                </div>
            </section>

            if (continuations.Count > 0)
            {
                <h3 id="batch-continuations">@Strings.BatchDetailsPage_Continuations <small class="text-muted">@Strings.BatchDetailsPage_Continuations_Hint</small></h3>
                <div class="table-responsive">
                    <table class="table" aria-describedby="batch-continuations">
                        <thead>
                            <tr>
                                <th class="min-width">@Strings.Common_Id</th>
                                <th class="min-width">@Strings.Common_State</th>
                                <th>@Strings.Common_Job</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var continuation in continuations)
                            {
                                <tr>
                                    <td class="min-width">@Html.JobIdLink(continuation.Key)</td>
                                    @if (continuation.Value == null)
                                    {
                                        <td colspan="2"><em>@Strings.Common_JobExpired</em></td>
                                    }
                                    else
                                    {
                                        <td class="min-width">@Html.StateLabel(continuation.Value.State)</td>
                                        <td class="word-break">@Html.JobNameLink(continuation.Key, continuation.Value.Job)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h3 id="batch-jobs">@Strings.BatchDetailsPage_JobsInBatch</h3>
            if (pager != null && pager.TotalPageCount > 1)
            {
                <div class="btn-toolbar btn-toolbar-top">
                    @Html.PerPageSelector(pager)
                </div>
            }
            <div class="table-responsive">
                <table class="table" aria-describedby="batch-jobs">
                    <thead>
                        <tr>
                            <th class="min-width">@Strings.Common_Id</th>
                            <th class="min-width">@Strings.Common_State</th>
                            <th>@Strings.Common_Job</th>
                            <th class="align-right">@Strings.Common_Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in jobs)
                        {
                            <tr class="hover">
                                <td class="min-width">@Html.JobIdLink(job.Key)</td>
                                @if (job.Value == null)
                                {
                                    <td colspan="3"><em>@Strings.Common_JobExpired</em></td>
                                }
                                else
                                {
                                    <td class="min-width">@Html.StateLabel(job.Value.State)</td>
                                    <td class="word-break">@Html.JobNameLink(job.Key, job.Value.Job)</td>
                                    <td class="align-right">@Html.RelativeTime(job.Value.CreatedAt)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            if (pager != null)
            {
                @Html.Paginator(pager)
            }
            else if (batch.Total > maxJobsShown)
            {
                <p class="text-muted">@String.Format(Strings.BatchDetailsPage_MoreJobs, batch.Total - maxJobsShown)</p>
            }
        }
    </div>
</div>
