@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    JobBatch? batch;
    List<KeyValuePair<string, JobData?>> jobs = [];
    List<KeyValuePair<string, JobData?>> continuations = [];
    const int maxJobsShown = 500;
    Pager? pager = null;

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        batch = BatchJob.Get(connection, Id);

        if (batch != null)
        {
            IEnumerable<string> jobIds;
            JobStorageConnection? storageConnection = connection as JobStorageConnection;

            if (storageConnection != null && Storage.HasFeature(JobStorageFeatures.ExtendedApi))
            {
                // One page of the batch's jobs, instead of every id of a batch of any size
                string jobsKey = BatchJob.GetJobsKey(Id);
                pager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, storageConnection.GetSetCount(jobsKey));
                jobIds = storageConnection.GetRangeFromSet(jobsKey, pager.FromRecord, pager.FromRecord + pager.RecordsPerPage - 1) ?? new List<string>();
            }
            else
            {
                // Without ranges the storage reads the whole set; the first jobs are shown
                jobIds = BatchJob.GetJobIds(connection, Id).Take(maxJobsShown);
            }

            foreach (string jobId in jobIds)
            {
                jobs.Add(new KeyValuePair<string, JobData?>(jobId, connection.GetJobData(jobId)));
            }

            foreach (string jobId in batch.Continuations)
            {
                continuations.Add(new KeyValuePair<string, JobData?>(jobId, connection.GetJobData(jobId)));
            }
        }
    }

    string title = batch != null ? (batch.Description ?? String.Format(Strings.BatchDetailsPage_Title, batch.Id)) : String.Format(Strings.BatchDetailsPage_Title, Id);
    Layout = new LayoutPage(title);
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(title, new Dictionary<string, string> { { Strings.BatchesPage_Title, Url.To("/batches") } })

        @if (batch == null)
        {
            @Html.PageTitle(title)
            <div class="alert alert-warning">@String.Format(Strings.BatchDetailsPage_Expired, Id)</div>
        }
        else
        {
            string encodedId = RouteValues.Encode(batch.Id);
            double percent = BatchDetailsPage.FinishedPercent(batch);
            bool canRequeue = !IsReadOnly && batch.Failed > 0;
            bool canDelete = !IsReadOnly && batch.Pending + batch.Failed > 0;

            <header class="ns-page-head">
                <div class="ns-page-heading">
                    @Html.PageTitle(title, Strings.JobDetailsPage_Batch)
                    <div class="ns-page-facts">
                        <span class="ns-job-state">@StatusLabel(Html, batch)</span>
                        <code class="ns-job-id">@batch.Id</code>
                    </div>
                </div>
                @if (canRequeue || canDelete)
                {
                    <div class="ns-page-actions">
                        @if (canDelete)
                        {
                            <button class="btn btn-sm ns-btn-outlined-error" data-ajax="@Url.To("/batches/delete/" + encodedId)" data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.BatchDetailsPage_DeletePendingConfirm, null, Strings.Common_Delete, destructive: true)>
                                @Html.Icon("trash-fill") @String.Format(Strings.BatchDetailsPage_DeletePending, batch.Pending + batch.Failed)
                            </button>
                        }
                        @if (canDelete && canRequeue)
                        {
                            <span class="ns-actions-divider" aria-hidden="true"></span>
                        }
                        @if (canRequeue)
                        {
                            <button class="btn btn-sm btn-primary" data-ajax="@Url.To("/batches/requeue-failed/" + encodedId)" data-loading-text="@Strings.Common_Enqueueing">
                                @Html.Icon("arrow-repeat") @String.Format(Strings.BatchDetailsPage_RequeueFailed, batch.Failed)
                            </button>
                        }
                    </div>
                }
            </header>

            <div class="ns-summary">
                <section class="ns-summary-tile" aria-labelledby="summary-jobs">
                    <h2 id="summary-jobs" class="ns-summary-label">@Html.Icon("grid-fill") @Strings.BatchesPage_Table_Jobs</h2>
                    <p class="ns-summary-value">@batch.Total.ToString(CultureInfo.CurrentCulture)</p>
                    <div class="ns-meter" role="progressbar" aria-label="@Strings.BatchesPage_Table_Progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent.ToString("0", CultureInfo.InvariantCulture)">
                        <span style="width: @percent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
                    </div>
                </section>
                <section class="ns-summary-tile ns-state-succeeded" aria-labelledby="summary-succeeded">
                    <h2 id="summary-succeeded" class="ns-summary-label">@Html.Icon(JobHistoryRenderer.GetStateIcon(SucceededState.StateName)) @SucceededState.StateName</h2>
                    <p class="ns-summary-value">@batch.Succeeded.ToString(CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile@(batch.Failed > 0 ? " ns-state-failed" : null)" aria-labelledby="summary-failed">
                    <h2 id="summary-failed" class="ns-summary-label">@Html.Icon(JobHistoryRenderer.GetStateIcon(FailedState.StateName)) @FailedState.StateName</h2>
                    <p class="ns-summary-value">@batch.Failed.ToString(CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-pending">
                    <h2 id="summary-pending" class="ns-summary-label">@Html.Icon("hourglass-split") @Strings.BatchDetailsPage_Pending</h2>
                    <p class="ns-summary-value">@batch.Pending.ToString(CultureInfo.CurrentCulture)</p>
                    @if (batch.Processing > 0 || batch.Deleted > 0)
                    {
                        <p class="ns-summary-sub">
                            @if (batch.Processing > 0)
                            {
                                <span>@ProcessingState.StateName @batch.Processing.ToString(CultureInfo.CurrentCulture)</span>
                            }
                            @if (batch.Deleted > 0)
                            {
                                <span>@DeletedState.StateName @batch.Deleted.ToString(CultureInfo.CurrentCulture)</span>
                            }
                        </p>
                    }
                </section>
                @if (batch.CreatedAt.HasValue)
                {
                    <section class="ns-summary-tile" aria-labelledby="summary-created">
                        <h2 id="summary-created" class="ns-summary-label">@Html.Icon("calendar3") @Strings.BatchesPage_Table_Created</h2>
                        <p class="ns-summary-value">@Html.RelativeTime(batch.CreatedAt.Value)</p>
                        <p class="ns-summary-sub">@Html.LocalTime(batch.CreatedAt.Value)</p>
                    </section>
                }
            </div>

            if (continuations.Count > 0)
            {
                <section class="hf-card ns-table-card" aria-labelledby="batch-continuations">
                    <div class="hf-card-header">
                        <h2 id="batch-continuations">@Strings.BatchDetailsPage_Continuations</h2>
                        <span class="ns-section-hint">@Strings.BatchDetailsPage_Continuations_Hint</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-labelledby="batch-continuations">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="min-width">@Strings.Common_State</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, JobData?> continuation in continuations)
                                {
                                    <tr class="hover@(continuation.Value == null ? " obsolete-data" : null)">
                                        @if (continuation.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="2">
                                                <div class="ns-job-title">@Html.JobIdLink(continuation.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(continuation.Value.State)
                                                    @Html.JobNameLink(continuation.Key, continuation.Value.Job, false)
                                                </div>
                                                <div class="ns-job-meta"><span class="ns-job-id">@Html.JobId(continuation.Key)</span></div>
                                            </td>
                                            <td class="min-width">@Html.StateLabel(continuation.Value.State)</td>
                                        }
                                        <td class="ns-actions-cell"><div class="ns-row-actions">@Html.CopyJobIdButton(continuation.Key)</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            <section class="hf-card ns-table-card" aria-labelledby="batch-jobs">
                <div class="hf-card-header">
                    <h2 id="batch-jobs">@Strings.BatchDetailsPage_JobsInBatch</h2>
                    @if (pager != null && pager.TotalPageCount > 1)
                    {
                        @Html.PerPageSelector(pager)
                    }
                </div>
                <div class="table-responsive">
                    <table class="table ns-job-table ns-table-reflow" aria-labelledby="batch-jobs">
                        <thead>
                            <tr>
                                <th scope="col">@Strings.Common_Job</th>
                                <th scope="col" class="min-width">@Strings.Common_State</th>
                                <th scope="col" class="ns-time-cell">@Strings.Common_Created</th>
                                @Html.ActionsColumnHeader()
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (KeyValuePair<string, JobData?> job in jobs)
                            {
                                <tr class="hover@(job.Value == null ? " obsolete-data" : null)">
                                    @if (job.Value == null)
                                    {
                                        <td class="ns-job-cell" colspan="3">
                                            <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                            <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="ns-job-cell">
                                            <div class="ns-job-title">
                                                @Html.StateDot(job.Value.State)
                                                @Html.JobNameLink(job.Key, job.Value.Job, false)
                                            </div>
                                            <div class="ns-job-meta">
                                                <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                @if (job.Value.Job?.Queue != null)
                                                {
                                                    @Html.QueueChip(job.Value.Job.Queue)
                                                }
                                            </div>
                                        </td>
                                        <td class="min-width">@Html.StateLabel(job.Value.State)</td>
                                        <td class="ns-time-cell">@Html.RelativeTime(job.Value.CreatedAt)</td>
                                    }
                                    <td class="ns-actions-cell">
                                        <div class="ns-row-actions">
                                            @if (!IsReadOnly && job.Value != null && job.Value.State == FailedState.StateName)
                                            {
                                                string requeueName = String.Format(Strings.Common_RequeueJob, HtmlHelper.ShortJobId(job.Key));
                                                <button type="button" class="ns-icon-button" data-ajax="@Url.To("/jobs/actions/requeue/" + RouteValues.Encode(job.Key))" data-loading-text="@Strings.Common_Enqueueing" aria-label="@requeueName" title="@requeueName">
                                                    @Html.Icon("arrow-repeat")
                                                </button>
                                            }
                                            @Html.CopyJobIdButton(job.Key)
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            if (pager != null)
            {
                @Html.Paginator(pager)
            }
            else if (batch.Total > maxJobsShown)
            {
                <p class="text-muted">@String.Format(Strings.BatchDetailsPage_MoreJobs, batch.Total - maxJobsShown)</p>
            }
        }
    </div>
</div>
