@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    RecurringJobDto? job;
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        job = connection.GetRecurringJobs(new[] { Id }).FirstOrDefault(static x => !x.Removed);
    }

    IReadOnlyList<DateTime> nextRuns = Array.Empty<DateTime>();
    IReadOnlyList<RecurringJobRun> runs = Array.Empty<RecurringJobRun>();
    string? cronDescription = null;

    if (job != null)
    {
        cronDescription = job.Cron != null ? Cron.TryDescribe(job.Cron) : null;
        nextRuns = ReadNextRuns(job);
        runs = Storage.GetRecurringJobRuns(Id, RunsShown);
    }

    string title = String.Format(Strings.RecurringJobDetailsPage_Title, Id);
    Layout = new LayoutPage(title);
    string encodedId = RouteValues.Encode(Id);
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(Id, new Dictionary<string, string> { { Strings.RecurringJobsPage_Title, Url.To("/recurring") } })

        @if (job == null)
        {
            <h1 id="page-title" class="hf-page-header">@title</h1>
            <div class="alert alert-warning">@String.Format(Strings.RecurringJobDetailsPage_NotFound, Id)</div>
        }
        else
        {
            <header class="ns-page-head">
                <div class="ns-page-heading">
                    @Html.PageTitle(Id, Strings.RecurringJobDetailsPage_Kind)
                    <div class="ns-page-facts">
                        @if (job.Paused)
                        {
                            <span class="ns-chip ns-chip-status ns-recurring-status ns-recurring-paused" title="@Strings.RecurringJobsPage_Paused_Tooltip">
                                @Html.Icon("pause-fill") @Strings.RecurringJobsPage_Paused
                            </span>
                        }
                        else
                        {
                            <span class="ns-chip ns-chip-status ns-recurring-status ns-recurring-active">
                                @Html.Icon("circle-fill") @Strings.RecurringJobDetailsPage_Active
                            </span>
                        }
                        @if (job.Retired)
                        {
                            <span class="ns-chip ns-chip-status ns-recurring-retired">
                                @Html.Icon("exclamation-triangle-fill") @Strings.RecurringJobDetailsPage_Retired
                            </span>
                        }
                        @if (job.Declared)
                        {
                            <span class="ns-chip ns-chip-status ns-recurring-declared" title="@Strings.RecurringJobDetailsPage_Declared_Tooltip">
                                @Html.Icon("terminal-fill") @Strings.RecurringJobDetailsPage_Declared
                                @if (job.DeclaredBy != null)
                                {
                                    <code>@job.DeclaredBy</code>
                                }
                            </span>
                        }
                        @if (job.Policy != null)
                        {
                            <a class="ns-chip ns-chip-assist" href="@Url.To("/policies#policy-" + job.Policy)" title="@Strings.RecurringJobDetailsPage_Policy">
                                @Html.Icon("calendar3") @job.Policy
                            </a>
                        }
                    </div>
                </div>
                @if (!IsReadOnly)
                {
                    <div class="ns-page-actions">
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.To("/recurring?edit=" + Uri.EscapeDataString(Id))">
                            @Html.Icon("pencil-fill") @Strings.RecurringJobsPage_EditSchedule
                        </a>
                        @if (job.Paused)
                        {
                            <button class="btn btn-sm ns-btn-tonal" data-ajax="@Url.To("/recurring/resume-one/" + encodedId)" data-loading-text="@Strings.RecurringJobsPage_Resuming">
                                @Html.Icon("play-fill") @Strings.RecurringJobsPage_Resume
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm ns-btn-tonal" data-ajax="@Url.To("/recurring/pause-one/" + encodedId)" data-loading-text="@Strings.RecurringJobsPage_Pausing">
                                @Html.Icon("pause-fill") @Strings.RecurringJobsPage_Pause
                            </button>
                        }
                        <button class="btn btn-sm btn-primary" data-ajax="@Url.To("/recurring/trigger-one/" + encodedId)" data-loading-text="@Strings.RecurringJobsPage_Triggering">
                            @Html.Icon("play-circle") @Strings.RecurringJobsPage_TriggerNow
                        </button>
                    </div>
                }
            </header>

            if (job.Error != null)
            {
                <div class="alert alert-danger ns-recurring-error" role="alert">
                    <strong>@Html.Icon("exclamation-circle-fill") @Strings.Common_Error</strong>
                    <pre class="stack-trace"><code>@Html.StackTrace(job.Error)</code></pre>
                </div>
            }

            <div class="ns-summary">
                <section class="ns-summary-tile" aria-labelledby="summary-schedule">
                    <h2 id="summary-schedule" class="ns-summary-label">@Html.Icon("clock") @Strings.RecurringJobsPage_Schedule</h2>
                    <p class="ns-summary-value">@(cronDescription ?? job.Cron ?? Strings.Common_NotAvailable)</p>
                    <p class="ns-summary-sub">
                        <code class="cron-badge">@job.Cron</code>
                        <span>@job.TimeZoneId</span>
                    </p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-next">
                    <h2 id="summary-next" class="ns-summary-label">@Html.Icon("hourglass-split") @Strings.RecurringJobsPage_Table_NextExecution</h2>
                    @if (job.Paused)
                    {
                        <p class="ns-summary-value ns-summary-muted">@Strings.RecurringJobsPage_Paused</p>
                    }
                    else if (job.NextExecution.HasValue)
                    {
                        <p class="ns-summary-value">@Html.RelativeTime(job.NextExecution.Value)</p>
                        <p class="ns-summary-sub">@Html.LocalTime(job.NextExecution.Value)</p>
                    }
                    else
                    {
                        <p class="ns-summary-value ns-summary-muted">@Strings.Common_NotAvailable</p>
                    }
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-last">
                    <h2 id="summary-last" class="ns-summary-label">@Html.Icon("arrow-repeat") @Strings.RecurringJobsPage_Table_LastExecution</h2>
                    @if (job.LastExecution.HasValue)
                    {
                        <p class="ns-summary-value">@Html.RelativeTime(job.LastExecution.Value)</p>
                        <p class="ns-summary-sub">
                            @if (!String.IsNullOrEmpty(job.LastJobId))
                            {
                                <a class="text-decoration-none" href="@Url.JobDetails(job.LastJobId)">@Html.StateLabel(job.LastJobState ?? EnqueuedState.StateName, HtmlHelper.StateDisplayName(job.LastJobState ?? EnqueuedState.StateName), hover: true)</a>
                                @Html.JobIdLink(job.LastJobId)
                            }
                            else
                            {
                                @Html.StateLabel(DeletedState.StateName, Strings.RecurringJobsPage_Canceled)
                            }
                        </p>
                    }
                    else
                    {
                        <p class="ns-summary-value ns-summary-muted">@Strings.Common_NotAvailable</p>
                    }
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-created">
                    <h2 id="summary-created" class="ns-summary-label">@Html.Icon("calendar3") @Strings.Common_Created</h2>
                    @if (job.CreatedAt.HasValue)
                    {
                        <p class="ns-summary-value">@Html.RelativeTime(job.CreatedAt.Value)</p>
                        <p class="ns-summary-sub">@Html.LocalTime(job.CreatedAt.Value)</p>
                    }
                    else
                    {
                        <p class="ns-summary-value ns-summary-muted">@Strings.Common_NotAvailable</p>
                    }
                </section>
            </div>

            <div class="ns-recurring-columns">
                <section class="hf-card ns-recurring-definition" aria-labelledby="definition">
                    <div class="hf-card-header">
                        <h2 id="definition">@Strings.RecurringJobDetailsPage_Definition</h2>
                    </div>
                    <div class="hf-card-body">
                        <dl class="ns-kv">
                            <dt>@Strings.Common_Job</dt>
                            <dd><code class="ns-recurring-method">@(job.Job != null ? Html.JobName(job.Job) : Strings.Common_CannotFindTargetMethod)</code></dd>
                            <dt>@Strings.RecurringJobsPage_Queue</dt>
                            <dd><a class="ns-chip ns-chip-assist" href="@Url.Queue(job.Queue ?? EnqueuedState.DefaultQueue)">@Html.Icon("inbox-fill") @(job.Queue ?? EnqueuedState.DefaultQueue)</a></dd>
                            <dt>@Strings.RecurringJobsPage_Table_TimeZone</dt>
                            <dd>@job.TimeZoneId</dd>
                            <dt>@Strings.RecurringJobsPage_Misfire</dt>
                            <dd>@DescribeMisfire(job.MisfireHandling)</dd>
                            @if (job.Policy != null)
                            {
                                <dt>@Strings.RecurringJobDetailsPage_Policy</dt>
                                <dd><a href="@Url.To("/policies#policy-" + job.Policy)">@job.Policy</a></dd>
                            }
                            @if (job.SkipAfter.HasValue)
                            {
                                <dt>@Strings.RecurringJobDetailsPage_SkipAfter</dt>
                                <dd><code>@job.SkipAfter.Value</code></dd>
                            }
                            @if (job.StartAt.HasValue)
                            {
                                <dt>@String.Format(Strings.RecurringJobsPage_StartsAt, String.Empty).Trim()</dt>
                                <dd>@Html.LocalTime(job.StartAt.Value) <span class="text-muted">(@Html.RelativeTime(job.StartAt.Value))</span></dd>
                            }
                            @if (job.EndAt.HasValue)
                            {
                                <dt>@String.Format(Strings.RecurringJobsPage_EndsAt, String.Empty).Trim()</dt>
                                <dd>@Html.LocalTime(job.EndAt.Value) <span class="text-muted">(@Html.RelativeTime(job.EndAt.Value))</span></dd>
                            }
                        </dl>
                    </div>
                </section>

                <section class="hf-card ns-recurring-next" aria-labelledby="next-runs">
                    <div class="hf-card-header">
                        <h2 id="next-runs">@Strings.RecurringJobsPage_NextRuns</h2>
                    </div>
                    @if (nextRuns.Count == 0)
                    {
                        <div class="ns-empty-state ns-empty-state-compact">
                            @Html.Icon(job.Paused ? "pause-fill" : "hourglass-split")
                            <p>@(job.Paused ? Strings.RecurringJobsPage_Paused_Tooltip : Strings.RecurringJobDetailsPage_NoNextRuns)</p>
                        </div>
                    }
                    else
                    {
                        <ol class="ns-next-runs">
                            @foreach (DateTime next in nextRuns)
                            {
                                <li>
                                    <span class="ns-next-runs-time">@Html.LocalTime(next)</span>
                                    <span class="ns-next-runs-relative">@Html.RelativeTime(next)</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>

            <section class="hf-card ns-recurring-runs" aria-labelledby="runs">
                <div class="hf-card-header">
                    <h2 id="runs">@Strings.RecurringJobDetailsPage_Runs</h2>
                    @if (runs.Count > 0)
                    {
                        <span class="badge text-bg-secondary">@runs.Count.ToString(CultureInfo.CurrentCulture)</span>
                    }
                </div>
                @if (runs.Count == 0)
                {
                    <div class="ns-empty-state ns-empty-state-compact">
                        @Html.Icon("inbox-fill")
                        <p>@Strings.RecurringJobDetailsPage_NoRuns</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0 ns-table-reflow" aria-labelledby="runs">
                            <thead>
                                <tr>
                                    <th scope="col" class="min-width">@Strings.Common_Id</th>
                                    <th scope="col" class="min-width">@Strings.Common_State</th>
                                    <th scope="col">@Strings.RecurringJobDetailsPage_ScheduledFor</th>
                                    <th scope="col">@Strings.Common_Created</th>
                                    <th scope="col" class="align-right">@Strings.RecurringJobDetailsPage_Duration</th>
                                    <th scope="col" class="min-width align-right">@Strings.Common_Retry</th>
                                    <th scope="col">@Strings.Common_Server</th>
                                    <th scope="col">@Strings.Common_Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RecurringJobRun run in runs)
                                {
                                    <tr class="hover">
                                        <td class="min-width">@Html.JobIdLink(run.JobId)</td>
                                        @if (run.Expired)
                                        {
                                            <td colspan="7" class="text-muted"><em>@Strings.Common_JobExpired</em></td>
                                        }
                                        else
                                        {
                                            <td class="min-width">@Html.StateLabel(run.State)</td>
                                            <td>@(run.ScheduledFor.HasValue ? Html.RelativeTime(run.ScheduledFor.Value) : new NonEscapedString(String.Empty))</td>
                                            <td>@(run.CreatedAt.HasValue ? Html.RelativeTime(run.CreatedAt.Value) : new NonEscapedString(String.Empty))</td>
                                            <td class="align-right ns-tabular">@(run.Duration.HasValue ? FormatDuration(run.Duration.Value) : String.Empty)</td>
                                            <td class="min-width align-right">@(run.RetryCount > 0 ? run.RetryCount.ToString(CultureInfo.CurrentCulture) : String.Empty)</td>
                                            <td class="ns-run-server">@(run.ServerId != null ? Html.ServerId(run.ServerId) : new NonEscapedString(String.Empty))</td>
                                            <td class="ns-run-reason">@run.Reason</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>
