@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    var title = String.Format(Strings.TaggedJobsPage_Title, Tag);
    Layout = new LayoutPage(title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    List<KeyValuePair<string, JobData>> jobs;
    var expired = new List<string>();
    Pager finalPager;

    // Expired jobs leave their ids behind in the tag. A page must not write, so they are only hidden here;
    // the button below removes them with a POST.
    using (var connection = Storage.GetReadOnlyConnection())
    {
        finalPager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, JobTags.Count(connection, Tag));
        jobs = ReadJobs(connection, Tag, finalPager, expired);
    }

    var total = finalPager.TotalRecordCount;
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">
            @Html.Breadcrumbs(Tag, new Dictionary<string, string> { { Strings.TagsPage_Title, Url.To("/tags") } })
        </h1>

        @if (expired.Count > 0)
        {
            <div class="alert alert-info">
                @String.Format(Strings.TaggedJobsPage_Expired, expired.Count)
                @if (!IsReadOnly)
                {
                    <button class="btn btn-xs btn-default"
                            data-ajax="@(Url.To("/tags/forget-expired/" + Uri.EscapeDataString(Tag)) + "?from=" + finalPager.FromRecord + "&count=" + finalPager.RecordsPerPage)"
                            data-loading-text="@Strings.TaggedJobsPage_ForgetExpired">
                        <span class="glyphicon glyphicon-remove"></span>
                        @Strings.TaggedJobsPage_ForgetExpired
                    </button>
                }
            </div>
        }

        @if (jobs.Count == 0)
        {
            <div class="alert alert-info">@Strings.TaggedJobsPage_NoJobs</div>
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top">
                    <span class="hf-tag hf-tag-lg"><span class="glyphicon glyphicon-tag"></span> @Tag <span class="hf-tag-count">@total</span></span>
                    @Html.PerPageSelector(finalPager)
                </div>

                <div class="table-responsive">
                    <table class="table" aria-describedby="page-title">
                        <thead>
                            <tr>
                                <th class="min-width">@Strings.Common_Id</th>
                                <th class="min-width">@Strings.Common_State</th>
                                <th>@Strings.Common_Job</th>
                                <th class="align-right">@Strings.Common_Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in jobs)
                            {
                                <tr class="js-jobs-list-row hover">
                                    <td class="min-width">@Html.JobIdLink(job.Key)</td>
                                    <td class="min-width">@Html.StateLabel(job.Value.State)</td>
                                    <td class="word-break">@Html.JobNameLink(job.Key, job.Value.Job)</td>
                                    <td class="align-right">@Html.RelativeTime(job.Value.CreatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @Html.Paginator(finalPager)
            </div>
        }
    </div>
</div>
