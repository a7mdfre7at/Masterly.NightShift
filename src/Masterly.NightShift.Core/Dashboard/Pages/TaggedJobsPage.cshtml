@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage
@inherits RazorPage
@{
    string title = String.Format(Strings.TaggedJobsPage_Title, Tag);
    Layout = new LayoutPage(title);

    int from, perPage;
    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    List<KeyValuePair<string, JobData>> jobs;
    List<string> expired = [];
    Pager finalPager;

    // Expired jobs leave their ids behind in the tag. A page must not write, so they are only hidden here;
    // the button below removes them with a POST.
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        finalPager = new Pager(from, perPage, DashboardOptions.DefaultRecordsPerPage, JobTags.Count(connection, Tag));
        jobs = ReadJobs(connection, Tag, finalPager, expired);
    }

    long total = finalPager.TotalRecordCount;
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(Tag, new Dictionary<string, string> { { Strings.TagsPage_Title, Url.To("/tags") } })
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(title, null, total)
            </div>
        </header>

        @if (expired.Count > 0)
        {
            <div class="ns-note" role="note">
                @Html.Icon("info-circle-fill")
                <div class="ns-note-text">@String.Format(Strings.TaggedJobsPage_Expired, expired.Count)</div>
                @if (!IsReadOnly)
                {
                    <button class="btn btn-sm ns-btn-text"
                            data-ajax="@(Url.To("/tags/forget-expired/" + RouteValues.Encode(Tag)) + "?from=" + finalPager.FromRecord + "&count=" + finalPager.RecordsPerPage)"
                            data-loading-text="@Strings.TaggedJobsPage_ForgetExpired">
                        @Html.Icon("x-lg")
                        @Strings.TaggedJobsPage_ForgetExpired
                    </button>
                }
            </div>
        }

        @if (jobs.Count == 0)
        {
            @Html.EmptyState("tag-fill", Strings.TaggedJobsPage_NoJobs, null, Url.To("/tags"), Strings.TagsPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @Html.PerPageSelector(finalPager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="ns-time-cell">@Strings.Common_Created</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, JobData> job in jobs)
                                {
                                    <tr class="js-jobs-list-row hover">
                                        <td class="ns-job-cell">
                                            <div class="ns-job-title">
                                                @Html.StateDot(job.Value.State)
                                                @Html.JobNameLink(job.Key, job.Value.Job, false)
                                            </div>
                                            <div class="ns-job-meta">
                                                <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                <span>@Html.StateLabel(job.Value.State)</span>
                                                @if (job.Value.Job?.Queue != null)
                                                {
                                                    @Html.QueueChip(job.Value.Job.Queue)
                                                }
                                            </div>
                                        </td>
                                        <td class="ns-time-cell">@Html.RelativeTime(job.Value.CreatedAt)</td>
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(finalPager)
            </div>
        }
    </div>
</div>
