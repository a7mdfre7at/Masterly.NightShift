@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.AboutPage_Title);
    IReadOnlyList<JobMonitorStatus> monitors = ReadMonitors();
    IReadOnlyList<JobFunction> jobFunctions = JobFunctions.GetAll();
    List<JobFilter> filters = GlobalJobFilters.Filters.OrderBy(static x => x.Order).ToList();
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.AboutPage_Title)
            </div>
        </header>

        <nav class="ns-jump-nav" aria-label="@Strings.JobDetailsPage_OnThisPage">
            <a class="ns-chip ns-chip-assist" href="#settings">@Html.Icon("list-task") @Strings.AboutPage_Settings</a>
            <a class="ns-chip ns-chip-assist" href="#storage">@Html.Icon("hdd-fill") @Strings.AboutPage_Storage</a>
            <a class="ns-chip ns-chip-assist" href="#filters">@Html.Icon("shuffle") @Strings.AboutPage_GlobalFilters</a>
            <a class="ns-chip ns-chip-assist" href="#functions">@Html.Icon("lightning-fill") @Strings.AboutPage_Functions</a>
            <a class="ns-chip ns-chip-assist" href="#monitors">@Html.Icon("eye-fill") @Strings.AboutPage_Monitors</a>
        </nav>

        <div class="ns-about-grid">
            <section class="hf-card" aria-labelledby="settings">
                <div class="hf-card-header">
                    <h2 id="settings">@Strings.AboutPage_Settings</h2>
                </div>
                <div class="hf-card-body">
                    <dl class="ns-kv ns-about-kv">
                        @foreach (KeyValuePair<string, string> setting in GetSettings())
                        {
                            <dt><code>@setting.Key</code></dt>
                            <dd>@setting.Value</dd>
                        }
                    </dl>
                </div>
            </section>

            <section class="hf-card" aria-labelledby="storage">
                <div class="hf-card-header">
                    <h2 id="storage">@Strings.AboutPage_Storage</h2>
                </div>
                <div class="hf-card-body">
                    <p class="ns-about-storage">@Storage.ToString()</p>
                    <h3 class="ns-about-subhead">@Strings.AboutPage_Features</h3>
                    <ul class="ns-about-features">
                        @foreach (KeyValuePair<string, bool> feature in GetStorageFeatures())
                        {
                            <li class="@(feature.Value ? "ns-about-supported" : "ns-about-unsupported")">
                                @Html.Icon(feature.Value ? "check-circle-fill" : "x-circle-fill")
                                <code>@feature.Key</code>
                                <span class="visually-hidden">@(feature.Value ? Strings.AboutPage_Supported : Strings.AboutPage_NotSupported)</span>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        </div>

        <section class="hf-card ns-table-card" aria-labelledby="filters">
            <div class="hf-card-header">
                <h2 id="filters">@Strings.AboutPage_GlobalFilters</h2>
                <span class="ns-count-chip">@filters.Count.ToString(CultureInfo.CurrentCulture)</span>
            </div>
            <ol class="ns-list ns-about-list">
                @foreach (JobFilter filter in filters)
                {
                    <li class="ns-list-item">
                        <div class="ns-list-item-body"><code>@filter.Instance.GetType().Name</code></div>
                        <div class="ns-list-item-end"><span class="ns-chip ns-chip-status ns-tabular">@String.Format(Strings.AboutPage_FilterOrder, filter.Order)</span></div>
                    </li>
                }
            </ol>
        </section>

        <section class="hf-card ns-table-card" aria-labelledby="functions">
            <div class="hf-card-header">
                <h2 id="functions">@Strings.AboutPage_Functions</h2>
                <span class="ns-count-chip">@jobFunctions.Count.ToString(CultureInfo.CurrentCulture)</span>
            </div>
            @if (jobFunctions.Count == 0)
            {
                <div class="ns-empty-state ns-empty-state-compact">
                    @Html.Icon("lightning-fill")
                    <p>@Strings.AboutPage_None</p>
                </div>
            }
            else
            {
                <ul class="ns-list ns-about-list">
                    @foreach (JobFunction function in jobFunctions)
                    {
                        <li class="ns-list-item">
                            <div class="ns-list-item-body">
                                <div class="ns-job-title"><code>@function.Name</code></div>
                                @if (function.PayloadType != null || !String.IsNullOrEmpty(function.Description))
                                {
                                    <div class="ns-job-meta">
                                        @if (function.PayloadType != null)
                                        {
                                            <span class="ns-chip ns-chip-status">@function.PayloadType.Name</span>
                                        }
                                        @if (!String.IsNullOrEmpty(function.Description))
                                        {
                                            <span>@function.Description</span>
                                        }
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="hf-card ns-table-card" aria-labelledby="monitors">
            <div class="hf-card-header">
                <h2 id="monitors">@Strings.AboutPage_Monitors</h2>
                <span class="ns-count-chip">@monitors.Count.ToString(CultureInfo.CurrentCulture)</span>
            </div>
            @if (monitors.Count == 0)
            {
                <div class="ns-empty-state ns-empty-state-compact">
                    @Html.Icon("eye-fill")
                    <p>@Strings.AboutPage_None</p>
                </div>
            }
            else
            {
                <ul class="ns-list ns-about-list">
                    @foreach (JobMonitorStatus monitor in monitors)
                    {
                        <li class="ns-list-item">
                            <div class="ns-list-item-body">
                                <div class="ns-job-title"><code>@monitor.Name</code> @MonitorLabel(monitor.State)</div>
                                <div class="ns-job-meta">
                                    @if (!String.IsNullOrEmpty(monitor.Method))
                                    {
                                        <span>@monitor.Method</span>
                                    }
                                    @if (!String.IsNullOrEmpty(monitor.Reason))
                                    {
                                        <span>@monitor.Reason</span>
                                    }
                                </div>
                            </div>
                            @if (monitor.CheckedAt.HasValue)
                            {
                                <div class="ns-list-item-end ns-run-time">@Html.RelativeTime(monitor.CheckedAt.Value) <span class="ns-time-exact">@Html.LocalTime(monitor.CheckedAt.Value)</span></div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
