@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.ScheduledJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.ScheduledCount());
    JobList<ScheduledJobDto?> scheduledJobs = monitor.ScheduledJobs(pager.FromRecord, pager.RecordsPerPage);
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="hf-page-header">@Strings.ScheduledJobsPage_Title</h1>

        @if (pager.TotalPageCount == 0)
        {
            <div class="alert alert-info">
                @Strings.ScheduledJobsPage_NoJobs
            </div>
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/scheduled/export")" data-filename="nightshift-scheduled-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm btn-outline-secondary btn-delete-all"
                                data-ajax="@Url.To("/jobs/scheduled/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-primary"
                                data-url="@Url.To("/jobs/scheduled/enqueue")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                disabled="disabled">
                            @Html.Icon("play-fill")
                            @Strings.ScheduledJobsPage_EnqueueNow
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                data-url="@Url.To("/jobs/scheduled/delete")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                disabled="disabled">
                            @Html.Icon("x-lg")
                            @Strings.Common_DeleteSelected
                        </button>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="table-responsive">
                    <table class="table" aria-describedby="page-title">
                        <thead>
                            <tr>
                                @if (!IsReadOnly)
                                {
                                    <th scope="col" class="min-width">
                                        @Html.SelectAllCheckbox()
                                    </th>
                                }
                                <th scope="col" class="min-width">@Strings.Common_Id</th>
                                <th scope="col">@Strings.ScheduledJobsPage_Table_Enqueue</th>
                                <th scope="col">@Strings.Common_Job</th>
                                <th scope="col" class="align-right">@Strings.ScheduledJobsPage_Table_Scheduled</th>
                            </tr>
                        </thead>
                        @foreach (KeyValuePair<string, ScheduledJobDto?> job in scheduledJobs)
                        {
                            <tr class="js-jobs-list-row @(job.Value == null || !job.Value.InScheduledState ? "obsolete-data" : null) @(job.Value != null && job.Value.InScheduledState ? "hover" : null)">
                                @if (!IsReadOnly)
                                {
                                    <td>
                                        @if (job.Value != null && job.Value.InScheduledState)
                                        {
                                            @Html.JobCheckbox(job.Key)
                                        }
                                    </td>
                                }
                                <td class="min-width">
                                    @Html.JobIdLink(job.Key)
                                    @if (job.Value != null && !job.Value.InScheduledState)
                                    {
                                        <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                    }
                                </td>
                                @if (job.Value == null)
                                {
                                    <td colspan="3"><em>@Strings.Common_JobExpired</em></td>
                                }
                                else
                                {
                                    <td class="min-width">
                                        @* Storages answer DateTime.MinValue for a state without a readable EnqueueAt *@
                                        @if (job.Value.EnqueueAt != DateTime.MinValue)
                                        {
                                            @Html.RelativeTime(job.Value.EnqueueAt)
                                        }
                                    </td>
                                    <td class="word-break">
                                        @Html.JobNameLink(job.Key, job.Value.Job)
                                    </td>
                                    <td class="align-right">
                                        @if (job.Value.ScheduledAt.HasValue)
                                        {
                                            @Html.RelativeTime(job.Value.ScheduledAt.Value)
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </table>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>