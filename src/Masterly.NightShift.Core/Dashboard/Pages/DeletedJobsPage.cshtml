@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.DeletedJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.DeletedListCount());
    JobList<DeletedJobDto?> jobs = monitor.DeletedJobs(pager.FromRecord, pager.RecordsPerPage);
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.DeletedJobsPage_Title, null, pager.TotalRecordCount)
            </div>
            @if (pager.TotalPageCount > 0)
            {
                <div class="ns-page-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/deleted/export")" data-filename="nightshift-deleted-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                </div>
            }
        </header>

        @if (pager.TotalPageCount == 0)
        {
            @Html.EmptyState("trash-fill", Strings.DeletedJobsPage_NoJobs, null, Url.To("/jobs/succeeded"), Strings.SucceededJobsPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/jobs/deleted/requeue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("arrow-repeat")
                                @Strings.Common_RequeueJobs
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="ns-time-cell">@Strings.DeletedJobsPage_Table_Deleted</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, DeletedJobDto?> job in jobs)
                                {
                                    bool current = job.Value != null && job.Value.InDeletedState;
                                    <tr class="js-jobs-list-row @(current ? "hover" : "obsolete-data")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @if (current)
                                                {
                                                    @Html.JobCheckbox(job.Key)
                                                }
                                            </td>
                                        }
                                        @if (job.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="2">
                                                <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            ExceptionInfo? exception = null;
                                            string? typeName = null;
                                            if (job.Value.StateData != null
                                                && job.Value.StateData.TryGetValue("Exception", out string? serializedException)
                                                && !String.IsNullOrWhiteSpace(serializedException))
                                            {
                                                exception = Common.SerializationHelper.Deserialize<ExceptionInfo>(serializedException, Common.SerializationOption.Internal);
                                                int commaIndex = exception!.Type.IndexOf(",", StringComparison.OrdinalIgnoreCase);
                                                typeName = commaIndex > 0
                                                    ? exception.Type.Substring(0, commaIndex)
                                                    : exception.Type;
                                            }
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(DeletedState.StateName)
                                                    @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                    @if (!current)
                                                    {
                                                        <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                                    }
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                    @if (job.Value.Job?.Queue != null)
                                                    {
                                                        @Html.QueueChip(job.Value.Job.Queue)
                                                    }
                                                </div>
                                                @if (!String.IsNullOrEmpty(typeName))
                                                {
                                                    <div class="ns-job-error">
                                                        <code class="ns-exception-type">@typeName</code>
                                                        <span class="ns-job-error-message">@exception!.Message</span>
                                                    </div>
                                                }
                                            </td>
                                            <td class="ns-time-cell">@(job.Value.DeletedAt.HasValue ? Html.RelativeTime(job.Value.DeletedAt.Value) : null)</td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (current && !IsReadOnly)
                                                {
                                                    @Html.JobCommandButton(Url.To("/jobs/deleted/requeue"), job.Key, "arrow-repeat", Strings.Common_RequeueJob)
                                                }
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
