@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.SucceededJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.SucceededListCount());
    JobList<SucceededJobDto?> succeededJobs = monitor.SucceededJobs(pager.FromRecord, pager.RecordsPerPage);
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="hf-page-header">@Strings.SucceededJobsPage_Title</h1>

        @if (pager.TotalPageCount == 0)
        {
            <div class="alert alert-info">
                @Strings.SucceededJobsPage_NoJobs
            </div>
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/succeeded/export")" data-filename="nightshift-succeeded-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm btn-outline-secondary btn-delete-all"
                                data-ajax="@Url.To("/jobs/succeeded/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                    }
                    @if (!IsReadOnly)
                    {
                        <button class="js-jobs-list-command btn btn-sm btn-primary"
                                data-url="@Url.To("/jobs/succeeded/requeue")"
                                data-loading-text="@Strings.Common_Enqueueing"
                                disabled="disabled">
                            @Html.Icon("arrow-repeat")
                            @Strings.Common_RequeueJobs
                        </button>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="table-responsive">
                    <table class="table" aria-describedby="page-title">
                        <thead>
                            <tr>
                                @if (!IsReadOnly)
                                {
                                    <th scope="col" class="min-width">
                                        @Html.SelectAllCheckbox()
                                    </th>
                                }
                                <th scope="col" class="min-width">@Strings.Common_Id</th>
                                <th scope="col">@Strings.Common_Job</th>
                                @if (succeededJobs.Any(x => x.Value?.StateData != null))
                                {
                                    <th scope="col" class="min-width">@Strings.SucceededJobsPage_Table_Duration</th>
                                    <th scope="col" class="min-width">@Strings.SucceededJobsPage_Table_Latency</th>
                                }
                                else
                                {
                                    <th scope="col" class="min-width">@Strings.SucceededJobsPage_Table_TotalDuration</th>
                                }
                                <th scope="col" class="align-right">@Strings.SucceededJobsPage_Table_Succeeded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (KeyValuePair<string, SucceededJobDto?> job in succeededJobs)
                            {
                                <tr class="js-jobs-list-row @(job.Value == null || !job.Value.InSucceededState ? "obsolete-data" : null) @(job.Value != null && job.Value.InSucceededState ? "hover" : null)">
                                    @if (!IsReadOnly)
                                    {
                                        <td>
                                            @if (job.Value != null && job.Value.InSucceededState)
                                            {
                                                @Html.JobCheckbox(job.Key)
                                            }
                                        </td>
                                    }
                                    <td class="min-width">
                                        @Html.JobIdLink(job.Key)
                                        @if (job.Value != null && !job.Value.InSucceededState)
                                        {
                                            <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                        }
                                    </td>

                                    @if (job.Value == null)
                                    {
                                        if (succeededJobs.Any(x => x.Value?.StateData != null))
                                        {
                                            <td colspan="4"><em>@Strings.Common_JobExpired</em></td>
                                        }
                                        else
                                        {
                                            <td colspan="3"><em>@Strings.Common_JobExpired</em></td>
                                        }
                                    }
                                    else
                                    {
                                        <td class="word-break">
                                            @Html.JobNameLink(job.Key, job.Value.Job)
                                        </td>
                                        if (job.Value.StateData != null)
                                        {
                                            <td class="min-width align-right">
                                                @{ TimeSpan? duration = StateDataValues.ReadMilliseconds(job.Value.StateData.TryGetValue("PerformanceDuration", out string? durationText) ? durationText : null); }
                                                @if (duration.HasValue)
                                                {
                                                    @Html.ToHumanDuration(duration.Value, false)
                                                }
                                            </td>
                                            <td class="min-width align-right">
                                                @{ TimeSpan? latency = StateDataValues.ReadMilliseconds(job.Value.StateData.TryGetValue("Latency", out string? latencyText) ? latencyText : null); }
                                                @if (latency.HasValue)
                                                {
                                                    @Html.ToHumanDuration(latency.Value, false)
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="min-width align-right">
                                                @if (job.Value.TotalDuration.HasValue)
                                                {
                                                    @Html.ToHumanDuration(TimeSpan.FromMilliseconds(job.Value.TotalDuration.Value), false)
                                                }
                                            </td>
                                        }
                                        <td class="min-width align-right">
                                            @if (job.Value.SucceededAt.HasValue)
                                            {
                                                @Html.RelativeTime(job.Value.SucceededAt.Value)
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>