@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.SucceededJobsPage_Title);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.SucceededListCount());
    JobList<SucceededJobDto?> succeededJobs = monitor.SucceededJobs(pager.FromRecord, pager.RecordsPerPage);
    bool withStateData = succeededJobs.Any(x => x.Value?.StateData != null);
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.SucceededJobsPage_Title, null, pager.TotalRecordCount)
            </div>
            @if (pager.TotalPageCount > 0)
            {
                <div class="ns-page-actions">
                    @if (!IsReadOnly)
                    {
                        <button class="btn btn-sm ns-btn-outlined-error btn-delete-all"
                                data-ajax="@Url.To("/jobs/succeeded/delete-all")"
                                data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.Common_DeleteAllConfirm_Title, Strings.Common_DeleteAllConfirm, Strings.Common_DeleteAll, destructive: true)>
                            @Html.Icon("trash-fill")
                            @Strings.Common_DeleteAll
                        </button>
                        <span class="ns-actions-divider" aria-hidden="true"></span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary js-download" data-url="@Url.To("/jobs/succeeded/export")" data-filename="nightshift-succeeded-jobs.csv">
                        @Html.Icon("download")
                        @Strings.Common_DownloadCsv
                    </button>
                </div>
            }
        </header>

        @if (pager.TotalPageCount == 0)
        {
            @Html.EmptyState("check-circle", Strings.SucceededJobsPage_NoJobs, null, Url.To("/jobs/processing"), Strings.ProcessingJobsPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/jobs/succeeded/requeue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("arrow-repeat")
                                @Strings.Common_RequeueJobs
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    @if (withStateData)
                                    {
                                        <th scope="col" class="min-width align-right">@Strings.SucceededJobsPage_Table_Duration</th>
                                        <th scope="col" class="min-width align-right">@Strings.SucceededJobsPage_Table_Latency</th>
                                    }
                                    else
                                    {
                                        <th scope="col" class="min-width align-right">@Strings.SucceededJobsPage_Table_TotalDuration</th>
                                    }
                                    <th scope="col" class="ns-time-cell">@Strings.SucceededJobsPage_Table_Succeeded</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, SucceededJobDto?> job in succeededJobs)
                                {
                                    bool current = job.Value != null && job.Value.InSucceededState;
                                    <tr class="js-jobs-list-row @(current ? "hover" : "obsolete-data")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @if (current)
                                                {
                                                    @Html.JobCheckbox(job.Key)
                                                }
                                            </td>
                                        }
                                        @if (job.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="@(withStateData ? 4 : 3)">
                                                <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(SucceededState.StateName)
                                                    @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                    @if (!current)
                                                    {
                                                        <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                                    }
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                    @if (job.Value.Job?.Queue != null)
                                                    {
                                                        @Html.QueueChip(job.Value.Job.Queue)
                                                    }
                                                </div>
                                            </td>
                                            if (withStateData)
                                            {
                                                TimeSpan? duration = job.Value.StateData != null ? StateDataValues.ReadMilliseconds(job.Value.StateData.TryGetValue("PerformanceDuration", out string? durationText) ? durationText : null) : null;
                                                TimeSpan? latency = job.Value.StateData != null ? StateDataValues.ReadMilliseconds(job.Value.StateData.TryGetValue("Latency", out string? latencyText) ? latencyText : null) : null;
                                                <td class="min-width align-right ns-tabular" data-label="@Strings.SucceededJobsPage_Table_Duration">@(duration.HasValue ? Html.ToHumanDuration(duration.Value, false) : null)</td>
                                                <td class="min-width align-right ns-tabular" data-label="@Strings.SucceededJobsPage_Table_Latency">@(latency.HasValue ? Html.ToHumanDuration(latency.Value, false) : null)</td>
                                            }
                                            else
                                            {
                                                <td class="min-width align-right ns-tabular" data-label="@Strings.SucceededJobsPage_Table_TotalDuration">@(job.Value.TotalDuration.HasValue ? Html.ToHumanDuration(TimeSpan.FromMilliseconds(job.Value.TotalDuration.Value), false) : null)</td>
                                            }
                                            <td class="ns-time-cell">@(job.Value.SucceededAt.HasValue ? Html.RelativeTime(job.Value.SucceededAt.Value) : null)</td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (current && !IsReadOnly)
                                                {
                                                    @Html.JobCommandButton(Url.To("/jobs/succeeded/requeue"), job.Key, "arrow-repeat", Strings.Common_RequeueJob)
                                                }
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
