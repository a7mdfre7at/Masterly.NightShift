@* Generator: Template TypeVisibility: Public GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Reflection
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@inherits RazorPage
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <title>@Title – @(DashboardOptions.DashboardTitle.Contains("<") ? "Masterly.NightShift Dashboard" : DashboardOptions.DashboardTitle)</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="none">
    @if (!DashboardOptions.IgnoreAntiforgeryToken)
    {
        if (!String.IsNullOrWhiteSpace(Context.AntiforgeryHeader))
        {
            @: <meta name="csrf-header" content="@Context.AntiforgeryHeader">
        }
        if (!String.IsNullOrWhiteSpace(Context.AntiforgeryToken))
        {
            @: <meta name="csrf-token" content="@Context.AntiforgeryToken">
        }
    }
    @{
        Version version = GetType().GetTypeInfo().Assembly.GetName().Version!;
        Version storageVersion = Storage.GetType().GetTypeInfo().Assembly.GetName().Version!;
    }

    @if(!string.IsNullOrWhiteSpace(DashboardOptions.FaviconPath))
    {
        @: <link rel="shortcut icon" href="@DashboardOptions.FaviconPath" type="image/x-icon">
    }
    else
    {
        @: <link rel="shortcut icon" href="data:image/x-icon;," type="image/x-icon">
    }

    @if (DashboardOptions.DarkModeEnabled)
    {
        @* Applies the chosen theme before the first paint, so the page doesn't flash. "theme=" in the URL wins, then the saved choice, then the system. *@
        <script>(function(){try{var q=/[?&]theme=(light|dark|system)/.exec(location.search);var t=q?q[1]:localStorage.getItem('nightshift.theme');if(q){localStorage.setItem('nightshift.theme',t);}if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
    }

    <link rel="stylesheet" href="@Url.To($"/css{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.StylesheetsHashCode)}")">
    @if (DashboardOptions.DarkModeEnabled)
    {
        @: <link rel="stylesheet" id="hfDarkStylesheet" media="(prefers-color-scheme: dark)" href="@Url.To($"/css-dark{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.StylesheetsDarkModeHashCode)}")">
    }
</head>
    <body class="hf-app">
        <div id="wrap">
            <aside class="hf-sidebar" id="hfSidebar" aria-label="Navigation">
                <a class="hf-brand" href="@Url.Home()">
                    <span class="hf-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="hf-logo-sky" x1="0" y1="0" x2="256" y2="256" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#145A6B"/><stop offset="1" stop-color="#0A2530"/></linearGradient><mask id="hf-logo-moon"><rect width="256" height="256" fill="#000"/><circle cx="122" cy="132" r="58" fill="#fff"/><circle cx="152" cy="112" r="50" fill="#000"/></mask></defs><rect width="256" height="256" rx="58" fill="url(#hf-logo-sky)"/><circle cx="128" cy="128" r="86" fill="none" stroke="#5FE0C8" stroke-opacity=".28" stroke-width="12"/><path d="M128 42A86 86 0 1 1 53.5 171" fill="none" stroke="#5FE0C8" stroke-width="12" stroke-linecap="round"/><rect width="256" height="256" fill="#F6E9CF" mask="url(#hf-logo-moon)"/><circle cx="53.5" cy="171" r="17" fill="#FF7A45"/></svg>
                    </span>
                    <span class="hf-brand-text">@Html.Raw(DashboardOptions.DashboardTitle)</span>
                </a>

                <nav class="hf-nav">
                    @Html.RenderPartial(new Navigation())
                </nav>

                <div class="hf-watchlist js-watchlist" data-live-url="@Url.To("/jobs/live")" data-job-url="@Url.To("/jobs/details/")" data-text-title="@Strings.LayoutPage_Watchlist" data-text-empty="@Strings.LayoutPage_Watchlist_Empty" data-text-done="@Strings.LayoutPage_Watchlist_Done" style="display: none"></div>

                <div class="hf-sidebar-footer">
                    @if (DashboardOptions.DarkModeEnabled)
                    {
                        <div class="hf-theme js-theme" role="group" aria-label="@Strings.LayoutPage_Theme">
                            <button type="button" data-theme-choice="system" title="@Strings.LayoutPage_Theme_System" aria-label="@Strings.LayoutPage_Theme_System" aria-pressed="false">@Html.Icon("circle-half")</button>
                            <button type="button" data-theme-choice="light" title="@Strings.LayoutPage_Theme_Light" aria-label="@Strings.LayoutPage_Theme_Light" aria-pressed="false">@Html.Icon("sun-fill")</button>
                            <button type="button" data-theme-choice="dark" title="@Strings.LayoutPage_Theme_Dark" aria-label="@Strings.LayoutPage_Theme_Dark" aria-pressed="false">@Html.Icon("moon-stars")</button>
                        </div>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (AppPath != null)
                    {
                        <a href="@AppPath" title="@Strings.LayoutPage_Back">@Html.Icon("box-arrow-left") @Strings.LayoutPage_Back</a>
                    }
                    else
                    {
                        <span>Masterly.NightShift @($"{version.Major}.{version.Minor}.{version.Build}")</span>
                    }
                </div>
            </aside>

            <div class="hf-main">
                <header class="hf-topbar">
                    <button type="button" class="hf-topbar-toggle js-sidebar-toggle" aria-label="@Strings.LayoutPage_Menu">@Html.Icon("list")</button>
                    <div class="hf-topbar-title">@Title</div>
                    <div class="hf-topbar-spacer"></div>
                    <span class="hf-pulse" title="@Strings.LayoutPage_Search_Hint">
                        <span class="hf-pulse-dot js-pulse-dot"></span>
                        <span class="hf-pulse-text js-pulse-text">@Strings.LayoutPage_Live</span>
                    </span>
                    <button type="button" class="hf-icon-button js-page-refresh" title="@Strings.LayoutPage_Refresh" aria-label="@Strings.LayoutPage_Refresh">
                        @Html.Icon("arrow-clockwise")
                    </button>
                    <button type="button" class="hf-search js-palette-open" title="@Strings.LayoutPage_Search_Hint" aria-haspopup="dialog">
                        @Html.Icon("search")
                        <span class="hf-search-text">@Strings.LayoutPage_Search</span>
                        <kbd>Ctrl</kbd><kbd>K</kbd>
                    </button>
                </header>

                @Html.RenderPartial(new ErrorAlert())

                @{
                    DrainModeStatus? drainStatus = null;
                    IList<string> pausedServers = new List<string>();
                    try
                    {
                        using (IStorageConnection drainConnection = Storage.GetReadOnlyConnection())
                        {
                            drainStatus = DrainMode.Read(drainConnection);
                        }

                        // A pause left by a server that is gone holds nothing back; the Servers page lists it to be cleared
                        pausedServers = drainStatus.PausedServers.Keys.ToList();
                        if (pausedServers.Count > 0)
                        {
                            IReadOnlyList<string> stale = DashboardHealth.GetStalePausedServers(drainStatus, Storage.GetMonitoringApi().Servers());
                            pausedServers = pausedServers.Where(id => !stale.Contains(id, StringComparer.OrdinalIgnoreCase)).ToList();
                        }
                    }
                    catch (Exception)
                    {
                        // The storage is unreachable: the page itself will say so.
                    }
                }
                @if (drainStatus != null && !drainStatus.Active && (drainStatus.PausedQueues.Count > 0 || pausedServers.Count > 0))
                {
                    <div class="hf-drain-banner hf-drain-banner-queues" role="status">
                        @Html.Icon("pause-fill")
                        @if (drainStatus.PausedQueues.Count > 0)
                        {
                            <strong>@String.Format(Strings.LayoutPage_QueuesPaused, String.Join(", ", drainStatus.PausedQueues.Keys))</strong>
                            <a class="btn hf-btn-xs btn-outline-secondary" href="@Url.To("/jobs/enqueued")">@Strings.LayoutPage_QueuesPaused_Link &rarr;</a>
                        }
                        @if (pausedServers.Count > 0)
                        {
                            <strong>@String.Format(Strings.LayoutPage_ServersPaused, String.Join(", ", pausedServers))</strong>
                            <a class="btn hf-btn-xs btn-outline-secondary" href="@Url.To("/servers")">@Strings.NavigationMenu_Servers &rarr;</a>
                        }
                    </div>
                }
                @if (drainStatus != null && drainStatus.Active)
                {
                    <div class="hf-drain-banner" role="status">
                        @Html.Icon("pause-fill")
                        <strong>@Strings.LayoutPage_Drain_Banner</strong>
                        @if (drainStatus.Since.HasValue)
                        {
                            <span class="hf-drain-banner-since">@Html.Raw(String.Format(Strings.LayoutPage_Drain_Since, Html.RelativeTime(drainStatus.Since.Value)))</span>
                        }
                        @if (!String.IsNullOrEmpty(drainStatus.Reason))
                        {
                            <em class="hf-drain-banner-reason">@drainStatus.Reason</em>
                        }
                        @if (!IsReadOnly)
                        {
                            <button type="button" class="btn hf-btn-xs btn-success" data-ajax="@Url.To("/maintenance/resume")" data-loading-text="@Strings.LayoutPage_Drain_Resume">
                                @Html.Icon("play-fill") @Strings.LayoutPage_Drain_Resume
                            </button>
                        }
                    </div>
                }

                <main class="hf-content js-page-container">
                    @RenderBody()
                </main>

                <footer class="hf-footer" id="footer">
                    <ul class="list-inline credit">
                        <li class="list-inline-item">
                            <span>Masterly.NightShift @($"{version.Major}.{version.Minor}.{version.Build}")</span>
                        </li>
                        @if(DashboardOptions.DisplayStorageConnectionString){
                        <li class="list-inline-item">@Storage @($"{storageVersion.Major}.{storageVersion.Minor}.{storageVersion.Build}")</li>
                        }
                        @if (StorageUtcNow.HasValue)
                        {
                            <li class="list-inline-item">@Strings.LayoutPage_Footer_StorageTime @Html.LocalTime(StorageUtcNow.Value)</li>
                        }
                        <li class="list-inline-item">
                            @if (TimeDifference.HasValue && Math.Abs(TimeDifference.Value.TotalSeconds) > 30)
                            {
                                <span class="text-warning" title="@Strings.LayoutPage_Footer_TimeIsOutOfSync">
                                    @Html.Icon("exclamation-triangle-fill")&nbsp;@Strings.LayoutPage_Footer_Time @Html.LocalTime(ApplicationUtcNow)
                                </span>
                            }
                            else
                            {
                                <span>@Strings.LayoutPage_Footer_Time @Html.LocalTime(ApplicationUtcNow)</span>
                            }
                        </li>
                        <li class="list-inline-item">@String.Format(Strings.LayoutPage_Footer_Generatedms, GenerationTime.Elapsed.TotalMilliseconds.ToString("N"))</li>
                    </ul>
                </footer>
            </div>
        </div>

        <div id="nightshiftConfig"
             data-pollinterval="@DashboardOptions.StatsPollingInterval"
             data-pollurl="@(Url.To("/stats"))"
             data-liveurl="@(Url.To("/jobs/live"))"
             data-icons-url="@(Url.To(DashboardIcons.Path))"
             data-text-refresh="@Strings.LayoutPage_Refresh"
             data-text-live="@Strings.LayoutPage_LiveToggle"
             data-text-live-hint="@Strings.LayoutPage_LiveToggle_Hint"
             data-text-list-result="@Strings.Common_ListCommandResult"
             data-text-list-remaining="@Strings.Common_ListCommandRemaining"
             data-text-request-failed="@Strings.Common_RequestFailed"
             data-darkmode="@(DashboardOptions.DarkModeEnabled.ToString().ToLowerInvariant())">
        </div>

        <script src="@Url.To($"/js{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.JavaScriptsHashCode)}")"></script>
    </body>
</html>
