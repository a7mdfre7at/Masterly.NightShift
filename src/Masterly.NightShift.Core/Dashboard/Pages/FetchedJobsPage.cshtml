@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System.Collections
@using System.Collections.Generic
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Queue);

    int from, perPage;

    int.TryParse(Query("from"), out from);
    int.TryParse(Query("count"), out perPage);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    Pager pager = new(from, perPage, DashboardOptions.DefaultRecordsPerPage, monitor.FetchedCount(Queue));
    JobList<FetchedJobDto?> fetchedJobs = monitor.FetchedJobs(Queue, pager.FromRecord, pager.RecordsPerPage);
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(Strings.FetchedJobsPage_Title, new Dictionary<string, string>
        {
            { Strings.QueuesPage_Title, Url.LinkToQueues() },
            { Queue, Url.Queue(Queue) }
        })

        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Queue, Strings.FetchedJobsPage_Title, pager.TotalRecordCount)
            </div>
        </header>

        @if (pager.TotalPageCount == 0)
        {
            @Html.EmptyState("inbox-fill", Strings.FetchedJobsPage_NoJobs, null, Url.Queue(Queue), Strings.EnqueuedJobsPage_Title)
        }
        else
        {
            <div class="js-jobs-list">
                <div class="btn-toolbar btn-toolbar-top ns-list-toolbar">
                    @if (!IsReadOnly)
                    {
                        <div class="ns-list-commands">
                            <button class="js-jobs-list-command btn btn-sm ns-btn-tonal"
                                    data-list-primary="true"
                                    data-url="@Url.To("/jobs/enqueued/requeue")"
                                    data-loading-text="@Strings.Common_Enqueueing"
                                    disabled="disabled">
                                @Html.Icon("arrow-repeat")
                                @Strings.Common_RequeueJobs
                            </button>
                            <button class="js-jobs-list-command btn btn-sm btn-outline-secondary"
                                    data-url="@Url.To("/jobs/enqueued/delete")"
                                    data-loading-text="@Strings.Common_Deleting"
                                    @Html.ConfirmAttributes(Strings.Common_DeleteSelected_Title, Strings.Common_DeleteConfirm, Strings.Common_Delete, destructive: true) data-confirm-one="@Strings.Common_DeleteSelected_TitleOne"
                                    disabled="disabled">
                                @Html.Icon("trash-fill")
                                @Strings.Common_DeleteSelected
                            </button>
                        </div>
                    }
                    @Html.PerPageSelector(pager)
                </div>

                <div class="hf-card ns-table-card">
                    <div class="table-responsive">
                        <table class="table ns-job-table ns-table-reflow" aria-describedby="page-title">
                            <thead>
                                <tr>
                                    @if (!IsReadOnly)
                                    {
                                        <th scope="col" class="ns-select-cell">
                                            @Html.SelectAllCheckbox()
                                        </th>
                                    }
                                    <th scope="col">@Strings.Common_Job</th>
                                    <th scope="col" class="ns-time-cell">@Strings.Common_Fetched</th>
                                    @Html.ActionsColumnHeader()
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KeyValuePair<string, FetchedJobDto?> job in fetchedJobs)
                                {
                                    <tr class="js-jobs-list-row @(job.Value == null ? "obsolete-data" : "hover")">
                                        @if (!IsReadOnly)
                                        {
                                            <td class="ns-select-cell">
                                                @if (job.Value != null)
                                                {
                                                    @Html.JobCheckbox(job.Key)
                                                }
                                            </td>
                                        }
                                        @if (job.Value == null)
                                        {
                                            <td class="ns-job-cell" colspan="2">
                                                <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="ns-job-cell">
                                                <div class="ns-job-title">
                                                    @Html.StateDot(job.Value.State)
                                                    @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                </div>
                                                <div class="ns-job-meta">
                                                    <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                    <span>@Html.StateLabel(job.Value.State)</span>
                                                </div>
                                            </td>
                                            <td class="ns-time-cell">@(job.Value.FetchedAt.HasValue ? Html.RelativeTime(job.Value.FetchedAt.Value) : null)</td>
                                        }
                                        <td class="ns-actions-cell">
                                            <div class="ns-row-actions">
                                                @if (job.Value != null && !IsReadOnly)
                                                {
                                                    @Html.JobCommandButton(Url.To("/jobs/enqueued/requeue"), job.Key, "arrow-repeat", Strings.Common_RequeueJob)
                                                    @Html.JobDeleteButton(Url.To("/jobs/enqueued/delete"), job.Key)
                                                }
                                                @Html.CopyJobIdButton(job.Key)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @Html.Paginator(pager)
            </div>
        }
    </div>
</div>
