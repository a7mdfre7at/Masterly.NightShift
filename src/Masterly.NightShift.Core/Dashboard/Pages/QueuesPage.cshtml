@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.Storage.Monitoring
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.QueuesPage_Title);

    IMonitoringApi monitor = Storage.GetMonitoringApi();
    IList<QueueWithTopEnqueuedJobsDto> queues = monitor.Queues();

    IReadOnlyDictionary<string, QueueHealth> health;
    DrainModeStatus drain;
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        health = QueueInsights.ReadAll(connection);
        drain = DrainMode.Read(connection);
    }

    int queueIndex = 0;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.QueuesPage_Title, null, queues.Count)
            </div>
        </header>

        @if (queues.Count == 0)
        {
            @Html.EmptyState("inbox-fill", Strings.QueuesPage_NoQueues, null, Url.To("/servers"), Strings.ServersPage_Title)
        }
        else
        {
            <div class="ns-queue-grid">
                @foreach (QueueWithTopEnqueuedJobsDto queue in queues)
                {
                    string headingId = "queue-" + (++queueIndex).ToString(CultureInfo.InvariantCulture);
                    QueueHealth? queueHealth = health.TryGetValue(queue.Name, out QueueHealth? h) ? h : null;
                    bool paused = drain.PausedQueues.TryGetValue(queue.Name, out string? pauseReason);
                    TimeSpan? drainEstimate = queueHealth != null ? queueHealth.EstimateDrain(queue.Length) : null;
                    bool stalled = queueHealth != null && queueHealth.IsStalled(queue.Length) && !paused && !drain.Active;
                    <section class="hf-card ns-queue-card@(paused ? " hf-queue-paused" : null)" aria-labelledby="@headingId">
                        <div class="hf-card-header">
                            <h2 id="@headingId">
                                @Html.QueueLabel(queue.Name)
                                @if (paused)
                                {
                                    <span class="badge text-bg-warning text-uppercase" title="@pauseReason">@Strings.QueuesPage_Paused</span>
                                }
                                @if (stalled)
                                {
                                    <span class="badge text-bg-danger text-uppercase" title="@Strings.QueuesPage_Stalled_Tooltip">@Strings.QueuesPage_Stalled</span>
                                }
                            </h2>
                            @if (!IsReadOnly)
                            {
                                <div class="hf-queue-actions">
                                    @if (paused)
                                    {
                                        <button class="btn btn-sm btn-primary" data-ajax="@Url.To("/queues/resume/" + RouteValues.Encode(queue.Name))" data-loading-text="@Strings.QueuesPage_Resume">
                                            @Html.Icon("play-fill") @Strings.QueuesPage_Resume
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm ns-btn-text" data-ajax="@Url.To("/queues/pause/" + RouteValues.Encode(queue.Name))" data-loading-text="@Strings.QueuesPage_Pause" data-confirm="@Strings.QueuesPage_PauseConfirm">
                                            @Html.Icon("pause-fill") @Strings.QueuesPage_Pause
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <dl class="ns-queue-stats">
                            <div>
                                <dt>@Strings.QueuesPage_Table_Length</dt>
                                <dd>@queue.Length.ToString("N0", CultureInfo.CurrentCulture)</dd>
                            </div>
                            <div>
                                <dt>@Strings.Common_Fetched</dt>
                                <dd>
                                    @if (queue.Fetched.HasValue)
                                    {
                                        <a href="@Url.To("/jobs/enqueued/fetched/" + RouteValues.Encode(queue.Name))">@queue.Fetched.Value.ToString("N0", CultureInfo.CurrentCulture)</a>
                                    }
                                    else
                                    {
                                        <em class="text-muted">@Strings.Common_NotAvailable</em>
                                    }
                                </dd>
                            </div>
                            <div class="hf-queue-health">
                                <dt title="@Strings.QueuesPage_Table_Latency_Hint">@Strings.QueuesPage_Table_Latency</dt>
                                <dd>
                                    @if (queueHealth != null && queueHealth.Samples > 0)
                                    {
                                        <span title="@Strings.QueuesPage_Table_Latency_Hint">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(queueHealth.MedianLatencyMs), false) <span class="text-muted">&middot; @Html.ToHumanDuration(TimeSpan.FromMilliseconds(queueHealth.P95LatencyMs), false)</span></span>
                                    }
                                    else
                                    {
                                        <em class="text-muted" title="@Strings.QueuesPage_Insights_Hint">&ndash;</em>
                                    }
                                </dd>
                            </div>
                            <div class="hf-queue-health">
                                <dt>@Strings.QueuesPage_Table_Throughput</dt>
                                <dd class="js-queue-throughput">
                                    @if (queueHealth != null)
                                    {
                                        @queueHealth.PerMinute.ToString("0.#", CultureInfo.CurrentCulture)
                                    }
                                    else
                                    {
                                        <em class="text-muted">&ndash;</em>
                                    }
                                </dd>
                            </div>
                            <div class="hf-queue-health">
                                <dt>@Strings.QueuesPage_Table_ClearsIn</dt>
                                <dd>
                                    @if (queue.Length == 0)
                                    {
                                        <span class="text-muted">&ndash;</span>
                                    }
                                    else if (drainEstimate.HasValue)
                                    {
                                        <strong>@Html.ToHumanDuration(drainEstimate, false)</strong>
                                    }
                                    else if (queueHealth != null)
                                    {
                                        <span class="text-muted">&infin;</span>
                                    }
                                    else
                                    {
                                        <em class="text-muted">&ndash;</em>
                                    }
                                </dd>
                            </div>
                        </dl>
                        <div class="ns-queue-next">
                            <h3>@Strings.QueuesPage_Table_NextsJobs</h3>
                            @if (queue.FirstJobs.Count == 0)
                            {
                                <p><em>@Strings.QueuesPage_NoJobs</em></p>
                            }
                            else
                            {
                                <ul class="ns-list">
                                    @foreach (KeyValuePair<string, EnqueuedJobDto?> job in queue.FirstJobs)
                                    {
                                        bool current = job.Value != null && job.Value.InEnqueuedState;
                                        <li class="ns-list-item@(current ? null : " obsolete-data")">
                                            @if (job.Value == null)
                                            {
                                                <div class="ns-list-item-body">
                                                    <div class="ns-job-title">@Html.JobIdLink(job.Key)</div>
                                                    <div class="ns-job-meta"><em>@Strings.Common_JobExpired</em></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ns-list-item-body">
                                                    <div class="ns-job-title">
                                                        @Html.StateDot(job.Value.State)
                                                        @Html.JobNameLink(job.Key, job.Value.Job, false)
                                                        @if (!current)
                                                        {
                                                            <span class="hf-icon" title="@Strings.Common_JobStateChanged_Text" role="img" aria-label="@Strings.Common_JobStateChanged_Text">@Html.Icon("question-circle-fill")</span>
                                                        }
                                                    </div>
                                                    <div class="ns-job-meta">
                                                        <span class="ns-job-id">@Html.JobId(job.Key)</span>
                                                        @if (!current)
                                                        {
                                                            <span>@Html.StateLabel(job.Value.State)</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="ns-list-item-end">
                                                    @if (job.Value.EnqueuedAt.HasValue)
                                                    {
                                                        @Html.RelativeTime(job.Value.EnqueuedAt.Value)
                                                    }
                                                    else
                                                    {
                                                        <em>@Strings.Common_NotAvailable</em>
                                                    }
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="ns-card-footer">
                            <a class="btn btn-sm ns-btn-text" href="@Url.Queue(queue.Name)">@Strings.EnqueuedJobsPage_Title @Html.Icon("chevron-right")</a>
                        </div>
                    </section>
                }
            </div>
        }
    </div>
</div>
