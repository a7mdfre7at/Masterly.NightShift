@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Common
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.TimelinePage_Title);

    DateTime now = StorageUtcNow ?? ApplicationUtcNow;
    long nowMs = (long)(now - new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalMilliseconds;

    IReadOnlyList<ActivityEntry> entries;
    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        entries = ActivityFeed.Read(connection, ActivityFeed.MaxEntries);
    }

    ClusterTimeline timeline = ClusterTimeline.Build(entries, nowMs, TimeSpan.FromMinutes(15));
    long windowMs = Math.Max(1, timeline.ToMs - timeline.FromMs);
    const int ticks = 6;

    // The latest runs, newest first, from the lanes the page has read already
    List<KeyValuePair<TimelineLane, TimelineSpan>> recentRuns = timeline.Lanes
        .SelectMany(lane => lane.Spans.Select(span => new KeyValuePair<TimelineLane, TimelineSpan>(lane, span)))
        .OrderByDescending(x => x.Value.StartMs)
        .Take(25)
        .ToList();
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.TimelinePage_Title)
                <p class="ns-page-subtitle">@Strings.TimelinePage_Hint</p>
            </div>
        </header>

        @if (timeline.IsEmpty)
        {
            @Html.EmptyState("list-task", Strings.TimelinePage_Empty_Title, Strings.TimelinePage_Empty, Url.To("/catalog"), Strings.NavigationMenu_Catalog)
        }
        else
        {
            <div class="ns-section-head">
                <h2 id="timeline-workers">@Strings.ServersPage_Table_Workers</h2>
                <span class="ns-section-hint">@String.Format(Strings.TimelinePage_Summary, timeline.Runs, timeline.Lanes.Count, timeline.Servers, Html.ToHumanDuration(timeline.Window, false))</span>
            </div>
            <ul class="ns-graph-legend hf-tl-legend">
                <li><i class="hf-tl-swatch hf-tl-succeeded" aria-hidden="true"></i> @Strings.JobsSidebarMenu_Succeeded</li>
                <li><i class="hf-tl-swatch hf-tl-failed" aria-hidden="true"></i> @Strings.JobsSidebarMenu_Failed</li>
                <li><i class="hf-tl-swatch hf-tl-held" aria-hidden="true"></i> @Strings.TimelinePage_Legend_Held</li>
                <li><i class="hf-tl-swatch hf-tl-deleted" aria-hidden="true"></i> @Strings.JobsSidebarMenu_Deleted</li>
                <li><i class="hf-tl-swatch hf-tl-running" aria-hidden="true"></i> @Strings.TimelinePage_Running</li>
            </ul>

            <div class="hf-card hf-tl" role="group" aria-labelledby="timeline-workers">
                <div class="hf-tl-row hf-tl-axis">
                    <div class="hf-tl-label"></div>
                    <div class="hf-tl-track">
                        @for (int t = 0; t <= ticks; t++)
                        {
                            long tickMs = timeline.FromMs + windowMs * t / ticks;
                            @* Server-side UTC with seconds: windows are often shorter than a minute *@
                            <span class="hf-tl-tick @(t == ticks ? "hf-tl-tick-last" : t == 0 ? "hf-tl-tick-first" : null)" style="left: @((100.0 * t / ticks).ToString("0.##", CultureInfo.InvariantCulture))%">@JobHelper.FromTimestamp(tickMs / 1000).ToString("HH:mm:ss", CultureInfo.InvariantCulture)@(t == ticks ? " UTC" : "")</span>
                        }
                    </div>
                </div>
                @{ string? lastServer = null; }
                @foreach (TimelineLane lane in timeline.Lanes)
                {
                    if (lane.ServerId != lastServer)
                    {
                        lastServer = lane.ServerId;
                        <div class="hf-tl-server">@Html.ServerId(lane.ServerId)</div>
                    }
                    <div class="hf-tl-row">
                        <div class="hf-tl-label" title="@lane.WorkerId"><code>@lane.ShortWorkerId</code></div>
                        <div class="hf-tl-track">
                            @foreach (TimelineSpan span in lane.Spans)
                            {
                                double left = 100.0 * (Math.Max(span.StartMs, timeline.FromMs) - timeline.FromMs) / windowMs;
                                double width = Math.Max(0.25, 100.0 * (span.EndMs - Math.Max(span.StartMs, timeline.FromMs)) / windowMs);
                                string css = span.IsRunning ? "hf-tl-running"
                                    : span.Outcome == SucceededState.StateName ? "hf-tl-succeeded"
                                    : span.Outcome == FailedState.StateName ? "hf-tl-failed"
                                    : span.Outcome == DeletedState.StateName ? "hf-tl-deleted"
                                    : "hf-tl-held";
                                string title = (span.Method ?? span.JobId) + " · " + (span.IsRunning ? Strings.TimelinePage_Running : HtmlHelper.StateDisplayName(span.Outcome ?? String.Empty)) + " · " + Html.ToHumanDuration(TimeSpan.FromMilliseconds(span.DurationMs), false);
                                <a class="hf-tl-span @css" href="@Url.JobDetails(span.JobId)" style="left: @left.ToString("0.###", CultureInfo.InvariantCulture)%; width: @width.ToString("0.###", CultureInfo.InvariantCulture)%" title="@title"></a>
                            }
                        </div>
                    </div>
                }
            </div>

            @* The same runs as a list: the state's dot, the job, where it ran, and when *@
            <section class="hf-card ns-table-card" aria-labelledby="timeline-runs">
                <div class="hf-card-header">
                    <h2 id="timeline-runs">@Strings.TimelinePage_RecentRuns</h2>
                </div>
                <ol class="ns-run-list">
                    @foreach (KeyValuePair<TimelineLane, TimelineSpan> run in recentRuns)
                    {
                        TimelineSpan span = run.Value;
                        string state = span.Outcome ?? ProcessingState.StateName;
                        DateTime startedAt = DateTimeOffset.FromUnixTimeMilliseconds(span.StartMs).UtcDateTime;
                        <li class="ns-run">
                            @Html.StateDot(state)
                            <div class="ns-run-main">
                                <div class="ns-job-title"><a class="job-method" href="@Url.JobDetails(span.JobId)">@(span.Method ?? "#" + span.JobId)</a></div>
                                <div class="ns-job-meta">
                                    <span class="ns-job-id">#@span.JobId</span>
                                    @Html.StateLabel(state, span.IsRunning ? Strings.TimelinePage_Running : HtmlHelper.StateDisplayName(state))
                                    <span>@Html.ToHumanDuration(TimeSpan.FromMilliseconds(span.DurationMs), false)</span>
                                    <span>@Html.ServerId(run.Key.ServerId) <code title="@run.Key.WorkerId">@run.Key.ShortWorkerId</code></span>
                                </div>
                            </div>
                            <div class="ns-run-time">@Html.RelativeTime(startedAt) <span class="ns-time-exact">@Html.LocalTime(startedAt)</span></div>
                        </li>
                    }
                </ol>
            </section>
        }
    </div>
</div>
