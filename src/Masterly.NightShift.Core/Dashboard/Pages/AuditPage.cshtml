@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.AuditPage_Title);

    int count;
    if (!int.TryParse(Query("count"), out count) || count <= 0) count = 100;
    count = Math.Min(count, AuditLog.MaxEntries);

    IReadOnlyList<AuditEntry> entries;
    long total;

    using (IStorageConnection connection = Storage.GetReadOnlyConnection())
    {
        entries = AuditLog.Read(connection, count);
        total = AuditLog.Count(connection);
    }

    // Addresses are personal data: read-only users see them only when the options say so
    bool showIpAddresses = !IsReadOnly || DashboardOptions.DisplayAuditIpAddressesToReadOnlyUsers;
}

<div class="row">
    <div class="col-md-12">
        <header class="ns-page-head">
            <div class="ns-page-heading">
                @Html.PageTitle(Strings.AuditPage_Title, null, total)
                <p class="ns-page-subtitle">@Strings.AuditPage_Hint</p>
            </div>
        </header>

        @if (!AuditLog.Enabled)
        {
            <div class="alert alert-warning">@Strings.AuditPage_Disabled</div>
        }

        @if (entries.Count == 0)
        {
            @Html.EmptyState("list-task", Strings.AuditPage_EmptyTitle, Strings.AuditPage_NoEntries)
        }
        else
        {
            <div class="ns-audit-toolbar">
                <div class="ns-catalog-search">
                    @Html.Icon("search")
                    <label for="auditFilter" class="visually-hidden">@Strings.AuditPage_Filter</label>
                    <input type="search" id="auditFilter" class="form-control js-audit-filter" placeholder="@Strings.AuditPage_Filter" autocomplete="off" spellcheck="false" />
                </div>
                <label class="ns-chip ns-chip-filter">
                    <input type="checkbox" class="js-audit-failed" />
                    @Html.Icon("x-circle-fill") @Strings.AuditPage_FailedOnly
                </label>
                <nav class="ns-audit-count js-audit-count" aria-label="@Strings.AuditPage_Show">
                    @foreach (int size in new[] { 50, 100, 250, 1000 })
                    {
                        <a class="ns-chip ns-chip-filter@(size == count ? " selected" : null)" href="@Url.To("/audit?count=" + size)"@Html.Raw(size == count ? " aria-current=\"page\"" : null)>@size</a>
                    }
                </nav>
                <span class="hf-catalog-summary">@entries.Count / @total</span>
            </div>

            <section class="hf-card ns-table-card" aria-labelledby="audit-entries">
                <div class="hf-card-header">
                    <h2 id="audit-entries">@Strings.AuditPage_Entries</h2>
                </div>
                <ol class="ns-run-list ns-audit-list">
                    @foreach (AuditEntry entry in entries)
                    {
                        bool failed = entry.Status >= 400;
                        // The address is searchable only where it is shown
                        string search = String.Join(" ", new[] { entry.User, showIpAddresses ? entry.RemoteIpAddress : null, entry.Action, AuditLog.Describe(entry.Action), entry.Detail }.Concat(entry.Targets ?? Array.Empty<string>()).Where(x => !String.IsNullOrEmpty(x)));
                        <li class="ns-run js-audit-entry@(failed ? " ns-audit-failed" : null)" data-search="@search" data-failed="@(failed ? "true" : "false")">
                            @Html.StateDot(failed ? FailedState.StateName : SucceededState.StateName)
                            <div class="ns-run-main">
                                <div class="ns-job-title">
                                    <span class="ns-audit-action">@AuditLog.Describe(entry.Action)</span>
                                    @if (failed)
                                    {
                                        @Html.StateLabel(FailedState.StateName, $"{HtmlHelper.StateDisplayName(FailedState.StateName)} · {entry.Status.ToString(CultureInfo.InvariantCulture)}")
                                    }
                                </div>
                                <div class="ns-job-meta">
                                    @if (String.IsNullOrEmpty(entry.User))
                                    {
                                        <span class="ns-chip ns-chip-status ns-audit-user"><em>@Strings.AuditPage_Anonymous</em></span>
                                    }
                                    else
                                    {
                                        <span class="ns-chip ns-chip-status ns-audit-user"><strong>@entry.User</strong></span>
                                    }
                                    @if (showIpAddresses && !String.IsNullOrEmpty(entry.RemoteIpAddress))
                                    {
                                        <span class="hf-audit-ip">@entry.RemoteIpAddress</span>
                                    }
                                    <code>@entry.Action</code>
                                </div>
                                @if (entry.Targets != null && entry.Targets.Count > 0)
                                {
                                    <div class="ns-audit-targets">
                                        @foreach (string target in entry.Targets)
                                        {
                                            if (target.All(Char.IsDigit) && entry.Action.StartsWith("/jobs", StringComparison.OrdinalIgnoreCase) || entry.Action.StartsWith("/catalog", StringComparison.OrdinalIgnoreCase) && target.All(Char.IsDigit))
                                            {
                                                <a class="ns-chip ns-chip-assist" href="@Url.JobDetails(target)">@Html.JobId(target)</a>
                                            }
                                            else
                                            {
                                                <code>@target</code>
                                            }
                                        }
                                        @if (entry.TargetCount.HasValue)
                                        {
                                            <span class="ns-audit-more">@String.Format(Strings.AuditPage_More, entry.TargetCount.Value - entry.Targets.Count)</span>
                                        }
                                    </div>
                                }
                                @if (!String.IsNullOrEmpty(entry.Detail))
                                {
                                    <p class="ns-audit-detail">@entry.Detail</p>
                                }
                            </div>
                            <div class="ns-run-time">@Html.RelativeTime(entry.OccurredAt) <span class="ns-time-exact">@Html.LocalTime(entry.OccurredAt)</span></div>
                        </li>
                    }
                </ol>
                <div class="ns-empty-state ns-empty-state-compact js-audit-nomatch" hidden="hidden">
                    @Html.Icon("search")
                    <p>@Strings.AuditPage_NoMatch</p>
                </div>
            </section>
        }
    </div>
</div>
