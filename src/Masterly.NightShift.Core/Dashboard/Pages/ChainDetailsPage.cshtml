@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@inherits RazorPage
@{
    JobChainInfo? chain = Storage.GetChain(Id);
    string title = String.Format(Strings.ChainDetailsPage_Title, Id.Substring(0, Math.Min(8, Id.Length)));
    Layout = new LayoutPage(title);
}

<div class="row">
    <div class="col-md-12">
        @Html.Breadcrumbs(title, new Dictionary<string, string> { { Strings.ChainsPage_Title, Url.To("/chains") } })

        @if (chain == null)
        {
            @Html.PageTitle(title)
            <div class="alert alert-warning">@String.Format(Strings.ChainDetailsPage_NotFound, Id)</div>
        }
        else
        {
            ChainFlowchart chart = ChainFlowchart.Build(Storage, chain, StorageUtcNow ?? ApplicationUtcNow);
            ChainFlowStatus status = ChainFlowchart.StatusOf(chain);
            ChainStepCounts counts = ChainsPage.CountSteps(chain);
            bool canRetry = !IsReadOnly && chain.IsSettled;

            <header class="ns-page-head">
                <div class="ns-page-heading">
                    @Html.PageTitle(title)
                    <div class="ns-page-facts">
                        <span class="ns-job-state">@ChainFlowchart.StatusLabel(Html, status)</span>
                        <code class="ns-job-id">@chain.ChainId</code>
                        <span class="ns-chip ns-chip-status">@Html.Icon("trash-fill") @String.Format(Strings.ChainFlow_Deletion, chain.DeleteBehavior)</span>
                        <span class="ns-chip ns-chip-status">@String.Format(Strings.ChainFlow_Summary, chain.Steps.Count, chart.GroupCount)</span>
                        <span class="ns-chip ns-chip-status">@String.Format(Strings.ChainDetailsPage_Generation, chain.Generation)</span>
                    </div>
                </div>
                @if (!IsReadOnly && !chain.IsSettled)
                {
                    <div class="ns-page-actions">
                        <button class="btn btn-sm ns-btn-outlined-error" data-ajax="@Url.To("/chains/delete/" + RouteValues.Encode(chain.ChainId))" data-loading-text="@Strings.Common_Deleting"
                                @Html.ConfirmAttributes(Strings.ChainDetailsPage_DeleteConfirm, null, Strings.Common_Delete, destructive: true)>
                            @Html.Icon("trash-fill") @Strings.Common_Delete
                        </button>
                    </div>
                }
            </header>

            <div class="ns-summary">
                <section class="ns-summary-tile" aria-labelledby="summary-steps summary-steps-value">
                    <h2 id="summary-steps" class="ns-summary-label">@Html.Icon("list-task") @Strings.ChainsPage_Steps</h2>
                    <p id="summary-steps-value" class="ns-summary-value">@counts.Finished.ToString(CultureInfo.CurrentCulture) / @counts.Total.ToString(CultureInfo.CurrentCulture)</p>
                    <div class="ns-meter" role="progressbar" aria-label="@Strings.BatchesPage_Table_Progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@counts.Percent.ToString("0", CultureInfo.InvariantCulture)">
                        <span style="width: @counts.Percent.ToString("0.#", CultureInfo.InvariantCulture)%"></span>
                    </div>
                </section>
                <section class="ns-summary-tile ns-state-succeeded" aria-labelledby="summary-succeeded">
                    <h2 id="summary-succeeded" class="ns-summary-label">@Html.Icon(JobHistoryRenderer.GetStateIcon(SucceededState.StateName)) @Strings.JobsSidebarMenu_Succeeded</h2>
                    <p class="ns-summary-value">@counts.Succeeded.ToString(CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile@(counts.Failed > 0 ? " ns-state-failed" : null)" aria-labelledby="summary-failed">
                    <h2 id="summary-failed" class="ns-summary-label">@Html.Icon(JobHistoryRenderer.GetStateIcon(FailedState.StateName)) @Strings.JobsSidebarMenu_Failed</h2>
                    <p class="ns-summary-value">@counts.Failed.ToString(CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-pending">
                    <h2 id="summary-pending" class="ns-summary-label">@Html.Icon("hourglass-split") @Strings.BatchDetailsPage_Pending</h2>
                    <p class="ns-summary-value">@counts.Pending.ToString(CultureInfo.CurrentCulture)</p>
                </section>
                <section class="ns-summary-tile" aria-labelledby="summary-created">
                    <h2 id="summary-created" class="ns-summary-label">@Html.Icon("calendar3") @Strings.Common_Created</h2>
                    <p class="ns-summary-value">@Html.RelativeTime(chain.CreatedAt)</p>
                    <p class="ns-summary-sub">@Html.LocalTime(chain.CreatedAt)</p>
                </section>
            </div>

            @* The flowchart: one row per level, groups in boxes, each step a card *@
            <section class="hf-card hf-flow js-flow" aria-labelledby="chain-flow">
                <div class="hf-card-header hf-flow-header">
                    <h2 id="chain-flow">@Html.Icon("shuffle") @Strings.ChainDetailsPage_Diagram</h2>
                    <div class="hf-flow-toolbar" role="toolbar" aria-labelledby="chain-flow">
                        <button type="button" class="btn hf-btn-xs btn-outline-secondary js-flow-zoom" data-zoom="out" title="@Strings.ChainFlow_ZoomOut" aria-label="@Strings.ChainFlow_ZoomOut">@Html.Icon("zoom-out")</button>
                        <span class="hf-flow-zoom-level js-flow-level">100%</span>
                        <button type="button" class="btn hf-btn-xs btn-outline-secondary js-flow-zoom" data-zoom="in" title="@Strings.ChainFlow_ZoomIn" aria-label="@Strings.ChainFlow_ZoomIn">@Html.Icon("zoom-in")</button>
                        <button type="button" class="btn hf-btn-xs btn-outline-secondary js-flow-zoom" data-zoom="fit" title="@Strings.ChainFlow_Fit" aria-label="@Strings.ChainFlow_Fit">@Html.Icon("arrows")</button>
                        <button type="button" class="btn hf-btn-xs btn-outline-secondary js-flow-fullscreen" title="@Strings.ChainFlow_Fullscreen" aria-label="@Strings.ChainFlow_Fullscreen" aria-pressed="false">@Html.Icon("arrows-fullscreen")</button>
                    </div>
                </div>
                @ChainFlowchartRenderer.Render(this, chart)
            </section>

            @* Every step in a list: its state, start condition and the commands it has *@
            <section class="hf-card ns-table-card" aria-labelledby="chain-steps">
                <div class="hf-card-header">
                    <h2 id="chain-steps">@Strings.ChainsPage_Steps</h2>
                    @if (chart.Hidden.Count > 0)
                    {
                        <span class="ns-section-hint">@String.Format(Strings.ChainFlow_Truncated, ChainFlowchart.MaxSteps)</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table ns-job-table ns-table-reflow" aria-labelledby="chain-steps">
                        <thead>
                            <tr>
                                <th scope="col">@Strings.Common_Job</th>
                                <th scope="col" class="min-width">@Strings.Common_State</th>
                                <th scope="col" class="ns-time-cell">@Strings.ProcessingJobsPage_Table_Started</th>
                                @Html.ActionsColumnHeader()
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (KeyValuePair<JobChainStepInfo, ChainFlowStep?> row in chart.Levels.SelectMany(static x => x.Steps).Select(static x => new KeyValuePair<JobChainStepInfo, ChainFlowStep?>(x.Info, x)).Concat(chart.Hidden.Select(static x => new KeyValuePair<JobChainStepInfo, ChainFlowStep?>(x, null))))
                            {
                                JobChainStepInfo step = row.Key;
                                ChainFlowStep? drawn = row.Value;
                                <tr class="hover@(step.State == null ? " obsolete-data" : null)">
                                    <td class="ns-job-cell">
                                        <div class="ns-job-title">
                                            @Html.StateDot(step.StateOrOutcome)
                                            <code class="ns-step-key">@step.Key</code>
                                            <a class="job-method" href="@Url.JobDetails(step.JobId)">@ChainFlowchartRenderer.StepName(this, step)</a>
                                        </div>
                                        <div class="ns-job-meta">
                                            <span class="ns-job-id">@Html.JobId(step.JobId)</span>
                                            <span>@ChainFlowchart.DescribeCondition(step)</span>
                                            <code class="ns-step-args">@ChainFlowchartRenderer.FormatArguments(step.Job)</code>
                                            @if (drawn != null && drawn.RetryCount > 0)
                                            {
                                                <span>@Html.Icon("arrow-repeat") @String.Format(Strings.ChainFlow_Retries, drawn.RetryCount)</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="min-width">
                                        @if (step.State != null)
                                        {
                                            @Html.StateLabel(step.State)
                                        }
                                        else if (step.FinishedAs != null)
                                        {
                                            <span class="ns-step-outcome">@Html.StateLabel(step.FinishedAs) <em>@Strings.ChainDetailsPage_JobExpired</em></span>
                                        }
                                        else
                                        {
                                            <em>@Strings.Common_JobExpired</em>
                                        }
                                    </td>
                                    <td class="ns-time-cell">@(drawn != null && drawn.Time.HasValue ? Html.RelativeTime(drawn.Time.Value) : null)</td>
                                    <td class="ns-actions-cell">
                                        <div class="ns-row-actions">
                                            @if (canRetry && ChainFlowchartRenderer.CanRetryFrom(step))
                                            {
                                                <button type="button" class="ns-icon-button" data-ajax="@ChainFlowchartRenderer.RetryUrl(this, chain.ChainId, step.JobId)" data-loading-text="@Strings.ChainDetailsPage_Retrying"
                                                        aria-label="@Strings.ChainDetailsPage_RetryFromHere" title="@Strings.ChainDetailsPage_RetryFromHere" @ChainFlowchartRenderer.RetryConfirm(this)>
                                                    @Html.Icon("arrow-repeat")
                                                </button>
                                            }
                                            @Html.CopyJobIdButton(step.JobId)
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @* Every step's console, merged in time order *@
            <details class="hf-card hf-chain-logs"@(new NonEscapedString(chart.Logs.Count > 0 ? " open" : String.Empty))>
                <summary class="hf-card-header"><h2>@Html.Icon("terminal-fill") @Strings.ChainLogs_Title</h2></summary>
                @if (chart.LogLineCount > chart.Logs.Count)
                {
                    <p class="text-muted hf-chain-logs-note">@String.Format(Strings.ChainLogs_Truncated, ChainFlowchart.MaxLogLines)</p>
                }
                <div class="job-console hf-chain-logs-console" role="log" aria-label="@Strings.ChainLogs_Title" tabindex="0">@ChainFlowchartRenderer.RenderLogs(this, chart)</div>
            </details>
        }
    </div>
</div>
