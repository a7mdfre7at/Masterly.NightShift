@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Masterly.NightShift
@using Masterly.NightShift.Dashboard
@using Masterly.NightShift.Dashboard.Pages
@using Masterly.NightShift.Dashboard.Resources
@using Masterly.NightShift.States
@inherits RazorPage
@{
    JobChainInfo? chain = Storage.GetChain(Id);
    string title = String.Format(Strings.ChainDetailsPage_Title, Id.Substring(0, Math.Min(8, Id.Length)));
    Layout = new LayoutPage(title);
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">
            @Html.Breadcrumbs(title, new Dictionary<string, string> { { Strings.ChainsPage_Title, Url.To("/chains") } })
        </h1>

        @if (chain == null)
        {
            <div class="alert alert-warning">@String.Format(Strings.ChainDetailsPage_NotFound, Id)</div>
        }
        else
        {
            ChainFlowchart chart = ChainFlowchart.Build(Storage, chain, StorageUtcNow ?? ApplicationUtcNow);
            <section class="hf-card">
                <div class="hf-batch-head">
                    <div>
                        @ChainsPage.StatusLabel(chain)
                        <code class="hf-batch-id">@chain.ChainId</code>
                        <span class="text-muted">&middot; @Strings.Common_Created @Html.RelativeTime(chain.CreatedAt) &middot; @String.Format(Strings.ChainDetailsPage_Generation, chain.Generation)</span>
                    </div>
                    <div class="hf-batch-actions">
                        <span class="hf-flow-facts">
                            <span class="hf-flow-pill"><span class="glyphicon glyphicon-trash"></span> @String.Format(Strings.ChainFlow_Deletion, chain.DeleteBehavior)</span>
                            <span class="text-muted">@String.Format(Strings.ChainFlow_Summary, chain.Steps.Count, chart.GroupCount)</span>
                        </span>
                        @if (!IsReadOnly && !chain.IsSettled)
                        {
                            <button class="btn btn-sm btn-default" data-ajax="@Url.To("/chains/delete/" + chain.ChainId)" data-loading-text="@Strings.Common_Deleting" data-confirm="@Strings.ChainDetailsPage_DeleteConfirm">
                                <span class="glyphicon glyphicon-remove"></span> @Strings.Common_Delete
                            </button>
                        }
                    </div>
                </div>
            </section>

            @* The flowchart: one row per level, groups in boxes, each step a card *@
            <section class="hf-card hf-flow js-flow" aria-labelledby="chain-flow">
                <div class="hf-card-header hf-flow-header">
                    <h3 id="chain-flow"><span class="glyphicon glyphicon-random"></span> @Strings.ChainDetailsPage_Diagram</h3>
                    <div class="hf-flow-toolbar" role="toolbar">
                        <button type="button" class="btn btn-xs btn-default js-flow-zoom" data-zoom="out" title="@Strings.ChainFlow_ZoomOut" aria-label="@Strings.ChainFlow_ZoomOut"><span class="glyphicon glyphicon-zoom-out"></span></button>
                        <span class="hf-flow-zoom-level js-flow-level">100%</span>
                        <button type="button" class="btn btn-xs btn-default js-flow-zoom" data-zoom="in" title="@Strings.ChainFlow_ZoomIn" aria-label="@Strings.ChainFlow_ZoomIn"><span class="glyphicon glyphicon-zoom-in"></span></button>
                        <button type="button" class="btn btn-xs btn-default js-flow-zoom" data-zoom="fit" title="@Strings.ChainFlow_Fit" aria-label="@Strings.ChainFlow_Fit"><span class="glyphicon glyphicon-resize-horizontal"></span></button>
                        <button type="button" class="btn btn-xs btn-default js-flow-fullscreen" title="@Strings.ChainFlow_Fullscreen" aria-label="@Strings.ChainFlow_Fullscreen" aria-pressed="false"><span class="glyphicon glyphicon-fullscreen"></span></button>
                    </div>
                </div>
                @ChainFlowchartRenderer.Render(this, chart)
            </section>

            if (chart.Hidden.Count > 0)
            {
                <p class="text-muted">@String.Format(Strings.ChainFlow_Truncated, ChainFlowchart.MaxSteps)</p>
                <div class="table-responsive">
                    <table class="table table-condensed">
                        <tbody>
                            @foreach (JobChainStepInfo step in chart.Hidden)
                            {
                                <tr class="hover">
                                    <td class="min-width"><code>@step.Key</code></td>
                                    <td class="min-width">@Html.JobIdLink(step.JobId)</td>
                                    <td class="min-width">@(step.State != null ? Html.StateLabel(step.State) : new NonEscapedString("<em>" + Html.HtmlEncode(Strings.Common_JobExpired) + "</em>"))</td>
                                    <td class="word-break">@ChainFlowchartRenderer.StepName(this, step) <span class="text-muted">@ChainFlowchartRenderer.FormatArguments(step.Job)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* Every step's console, merged in time order *@
            <details class="hf-card hf-chain-logs"@(new NonEscapedString(chart.Logs.Count > 0 ? " open" : String.Empty))>
                <summary class="hf-card-header"><h3><span class="glyphicon glyphicon-console"></span> @Strings.ChainLogs_Title</h3></summary>
                @if (chart.LogLineCount > chart.Logs.Count)
                {
                    <p class="text-muted hf-chain-logs-note">@String.Format(Strings.ChainLogs_Truncated, ChainFlowchart.MaxLogLines)</p>
                }
                <div class="job-console hf-chain-logs-console">@ChainFlowchartRenderer.RenderLogs(this, chart)</div>
            </details>
        }
    </div>
</div>
