<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SQL Server storage for Masterly.NightShift background jobs, on Microsoft.Data.SqlClient. Creates and upgrades its own tables; Hangfire databases keep working.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeSource>README.md</PackageReadmeSource>
    <RootNamespace>Masterly.NightShift.SqlServer</RootNamespace>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.Core\Masterly.NightShift.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Lifts a transitive dependency of Microsoft.Data.SqlClient to a version without known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7), so apps don't get NU1902/NU1903 warnings from this package -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- The installer loads the script by this name, so it doesn't follow the folder -->
    <EmbeddedResource Include="Schema\Install.sql" LogicalName="Masterly.NightShift.SqlServer.Install.sql" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Schema\DefaultInstall.sql">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DefaultInstall.tt</DependentUpon>
    </None>
    <None Update="Schema\DefaultInstall.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>DefaultInstall.sql</LastGenOutput>
    </None>
  </ItemGroup>
  <!-- Global usings, next to the implicit ones of the SDK -->
  <ItemGroup>
    <Using Include="System.Data" />
    <Using Include="System.Data.Common" />
    <Using Include="System.Globalization" />
    <Using Include="Dapper" />
    <Using Include="Masterly.NightShift.Annotations" />
    <Using Include="Masterly.NightShift.Storage" />
  </ItemGroup>
</Project>