<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Masterly.NightShift for ASP.NET Core: the dashboard as an endpoint or middleware, health checks, and /health and Prometheus /metrics endpoints.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeSource>README.md</PackageReadmeSource>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Masterly.NightShift</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.NetCore\Masterly.NightShift.NetCore.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>