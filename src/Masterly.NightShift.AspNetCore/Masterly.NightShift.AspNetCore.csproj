<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Masterly.NightShift for ASP.NET Core: the dashboard as an endpoint or middleware, health checks, and /health and Prometheus /metrics endpoints.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeSource>README.md</PackageReadmeSource>
    <RootNamespace>Masterly.NightShift</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.NetCore\Masterly.NightShift.NetCore.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The clock heartbeats are compared with, shared with the dashboard's /health and /metrics; internal to each assembly -->
    <Compile Include="..\Masterly.NightShift.Core\Dashboard\StorageClock.cs" Link="HealthChecks\StorageClock.cs" />
  </ItemGroup>
  <!-- Global usings, next to the implicit ones of the SDK -->
  <ItemGroup>
    <Using Include="Masterly.NightShift.Annotations" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>