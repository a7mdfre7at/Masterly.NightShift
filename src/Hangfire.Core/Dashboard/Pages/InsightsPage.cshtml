@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True *@
@using System
@using System.Collections.Generic
@using System.Linq
@using Hangfire
@using Hangfire.Common
@using Hangfire.Dashboard
@using Hangfire.Dashboard.Pages
@using Hangfire.Dashboard.Resources
@using Hangfire.Storage
@inherits RazorPage
@{
    Layout = new LayoutPage(Strings.InsightsPage_Title);

    IReadOnlyList<JobInsight> insights = new List<JobInsight>();
    var circuits = new List<CircuitBreakerAttribute.CircuitState>();
    bool supported;

    using (var connection = Storage.GetReadOnlyConnection())
    {
        supported = connection is JobStorageConnection;

        if (supported)
        {
            insights = JobInsightsAttribute.ReadAll(connection);
            circuits = connection.GetAllItemsFromSet(CircuitBreakerAttribute.CircuitsSetKey)
                .Select(resource => CircuitBreakerAttribute.ReadCircuit(connection, resource))
                .OrderBy(circuit => circuit.State == CircuitBreakerAttribute.ClosedState ? 1 : 0)
                .ThenBy(circuit => circuit.Resource)
                .ToList();
        }
    }

    var invokers = JobInvokerRegistry.GetStatistics();
    var totalRuns = insights.Sum(x => x.Total);
    var totalFailed = insights.Sum(x => x.Failed);
    var now = StorageUtcNow ?? ApplicationUtcNow;
}

<div class="row">
    <div class="col-md-12">
        <h1 id="page-title" class="page-header">@Strings.InsightsPage_Title</h1>

        @if (!supported)
        {
            <div class="alert alert-warning">@Strings.InsightsPage_NotSupported</div>
        }
        else
        {
            <div class="row insights-summary">
                <div class="col-sm-3">
                    <div class="insights-tile">
                        <div class="insights-tile-value">@insights.Count</div>
                        <div class="insights-tile-label">@Strings.InsightsPage_Summary_Methods</div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="insights-tile">
                        <div class="insights-tile-value">@totalRuns.ToString("N0")</div>
                        <div class="insights-tile-label">@Strings.InsightsPage_Summary_Runs</div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="insights-tile @(totalRuns > 0 && totalFailed * 10 > totalRuns ? "insights-tile-danger" : null)">
                        <div class="insights-tile-value">@(totalRuns == 0 ? "–" : ((double)totalFailed / totalRuns).ToString("P1"))</div>
                        <div class="insights-tile-label">@Strings.InsightsPage_Summary_FailureRate</div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="insights-tile" title="@Strings.InsightsPage_Summary_Invokers_Hint">
                        <div class="insights-tile-value">
                            <span class="label label-success">@invokers.Generated</span>
                            <span class="label label-info">@invokers.Compiled</span>
                            <span class="label label-default">@invokers.Reflection</span>
                        </div>
                        <div class="insights-tile-label">@Strings.InsightsPage_Summary_Invokers</div>
                    </div>
                </div>
            </div>

            if (circuits.Count > 0)
            {
                <h3 id="insights-circuits">@Strings.InsightsPage_Circuits</h3>
                <div class="table-responsive">
                    <table class="table" aria-describedby="insights-circuits">
                        <thead>
                            <tr>
                                <th>@Strings.InsightsPage_Circuits_Resource</th>
                                <th class="min-width">@Strings.Common_State</th>
                                <th class="min-width">@Strings.InsightsPage_Circuits_Failures</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Circuits_Since</th>
                                @if (!IsReadOnly)
                                {
                                    <th class="min-width"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var circuit in circuits)
                            {
                                var labelClass = circuit.State == CircuitBreakerAttribute.OpenState ? "label-danger"
                                    : circuit.State == CircuitBreakerAttribute.HalfOpenState ? "label-warning"
                                    : "label-success";

                                <tr>
                                    <td class="word-break"><code>@circuit.Resource</code></td>
                                    <td class="min-width"><span class="label @labelClass text-uppercase">@circuit.State</span></td>
                                    <td class="min-width">@circuit.Failures</td>
                                    <td class="min-width align-right">
                                        @if (circuit.OpenedAt > DateTime.MinValue)
                                        {
                                            @Html.RelativeTime(circuit.OpenedAt)
                                        }
                                    </td>
                                    @if (!IsReadOnly)
                                    {
                                        <td class="min-width">
                                            @if (circuit.State != CircuitBreakerAttribute.ClosedState || circuit.Failures > 0)
                                            {
                                                <button class="btn btn-xs btn-default" data-ajax="@Url.To("/insights/circuits/reset/" + Uri.EscapeDataString(circuit.Resource))" data-loading-text="@Strings.InsightsPage_Circuits_Reset">
                                                    <span class="glyphicon glyphicon-refresh"></span> @Strings.InsightsPage_Circuits_Reset
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            if (insights.Count == 0)
            {
                <div class="alert alert-info">@Html.Raw(Strings.InsightsPage_NoData_Html)</div>
            }
            else
            {
                <h3 id="insights-jobs">@Strings.Common_Job</h3>
                <div class="table-responsive">
                    <table class="table insights-table" aria-describedby="insights-jobs">
                        <thead>
                            <tr>
                                <th>@Strings.Common_Job</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_Runs</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_Failed</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_Median</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_P95</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_Max</th>
                                <th class="min-width">@Strings.InsightsPage_Table_Trend</th>
                                <th class="min-width">@Strings.InsightsPage_Table_Invoker</th>
                                <th class="min-width align-right">@Strings.InsightsPage_Table_LastRun</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var insight in insights)
                            {
                                var failureClass = insight.FailureRate >= 0.25 ? "label-danger" : insight.FailureRate > 0 ? "label-warning" : "label-default";

                                <tr>
                                    <td class="word-break">
                                        <code>@insight.Key</code>
                                        @if (insight.LastRunWasSlow)
                                        {
                                            <span class="glyphicon glyphicon-warning-sign text-warning" title="@Strings.InsightsPage_SlowRun_Tooltip"></span>
                                        }
                                    </td>
                                    <td class="min-width align-right">@insight.Total.ToString("N0")</td>
                                    <td class="min-width align-right">
                                        <span class="label @failureClass">@insight.Failed.ToString("N0") (@insight.FailureRate.ToString("P0"))</span>
                                    </td>
                                    <td class="min-width align-right">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.MedianMs), false)</td>
                                    <td class="min-width align-right">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.P95Ms), false)</td>
                                    <td class="min-width align-right">@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.MaxMs), false)</td>
                                    <td class="min-width">@Sparkline.Render(insight.Durations, 120, 26, insight.LastFailed)</td>
                                    <td class="min-width">
                                        @if (insight.Invoker != null)
                                        {
                                            var invokerClass = insight.Invoker == "Generated" ? "label-success" : insight.Invoker == "Compiled" ? "label-info" : "label-default";
                                            <span class="label @invokerClass">@insight.Invoker</span>
                                        }
                                    </td>
                                    <td class="min-width align-right">
                                        @if (insight.LastRunAt.HasValue)
                                        {
                                            if (insight.LastJobId != null)
                                            {
                                                <a href="@Url.JobDetails(insight.LastJobId)" class="text-decoration-none">@Html.RelativeTime(insight.LastRunAt.Value)</a>
                                            }
                                            else
                                            {
                                                @Html.RelativeTime(insight.LastRunAt.Value)
                                            }
                                            <span class="text-muted">(@Html.ToHumanDuration(TimeSpan.FromMilliseconds(insight.LastDurationMs), false))</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
