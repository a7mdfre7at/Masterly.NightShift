@* Generator: Template TypeVisibility: Internal GeneratePrettyNames: True TrimLeadingUnderscores : true *@
@using System
@using Hangfire.Dashboard
@using Hangfire.Dashboard.Resources
@inherits RazorPage
@{
    var jobsUrl = Url.LinkToQueues();
}
@if (NavigationMenu.Items.Count > 0)
{
    <div class="hf-nav-section">@Strings.NavigationMenu_Section_Monitor</div>
    foreach (var item in NavigationMenu.Items)
    {
        var itemValue = item(this);

        if (itemValue == null) { continue; }

        var isJobs = String.Equals(itemValue.Url, jobsUrl, StringComparison.OrdinalIgnoreCase);

        <a href="@itemValue.Url" class="hf-nav-item @(itemValue.Active ? "active" : null)">
            <span class="hf-nav-icon glyphicon glyphicon-@(itemValue.Icon ?? "chevron-right")" aria-hidden="true"></span>
            <span class="hf-nav-text">@itemValue.Text</span>
            <span class="hf-nav-metrics">
                @foreach (var metric in itemValue.GetAllMetrics())
                {
                    @Html.InlineMetric(metric)
                }
            </span>
        </a>

        if (isJobs && JobsSidebarMenu.Items.Count > 0)
        {
            <ul class="hf-nav-sub">
                @foreach (var subItem in JobsSidebarMenu.Items)
                {
                    var subValue = subItem(this);
                    if (subValue == null) { continue; }

                    <li>
                        <a href="@subValue.Url" class="hf-nav-item @(subValue.Active ? "active" : null)">
                            <span class="hf-nav-text">@subValue.Text</span>
                            <span class="hf-nav-metrics">
                                @foreach (var metric in subValue.GetAllMetrics())
                                {
                                    @Html.InlineMetric(metric)
                                }
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
}
