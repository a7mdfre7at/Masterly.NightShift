@* Generator: Template TypeVisibility: Public GeneratePrettyNames: True *@
@using System
@using System.Globalization
@using System.Reflection
@using Hangfire.Dashboard
@using Hangfire.Dashboard.Pages
@using Hangfire.Dashboard.Resources
@inherits RazorPage
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <title>@Title – @(DashboardOptions.DashboardTitle.Contains("<") ? "Hangfire Dashboard" : DashboardOptions.DashboardTitle)</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="none">
    @if (!DashboardOptions.IgnoreAntiforgeryToken)
    {
        if (!String.IsNullOrWhiteSpace(Context.AntiforgeryHeader))
        {
            @: <meta name="csrf-header" content="@Context.AntiforgeryHeader">
        }
        if (!String.IsNullOrWhiteSpace(Context.AntiforgeryToken))
        {
            @: <meta name="csrf-token" content="@Context.AntiforgeryToken">
        }
    }
    @{
        var version = GetType().GetTypeInfo().Assembly.GetName().Version;
        var storageVersion = Storage.GetType().GetTypeInfo().Assembly.GetName().Version;
    }

    @if(!string.IsNullOrWhiteSpace(DashboardOptions.FaviconPath))
    {
        @: <link rel="shortcut icon" href="@DashboardOptions.FaviconPath" type="image/x-icon">
    }
    else
    {
        @: <link rel="shortcut icon" href="data:image/x-icon;," type="image/x-icon">
    }

    @if (DashboardOptions.DarkModeEnabled)
    {
        @* Applies the chosen theme before the first paint, so the page doesn't flash. "theme=" in the URL wins, then the saved choice, then the system. *@
        <script>(function(){try{var q=/[?&]theme=(light|dark|system)/.exec(location.search);var t=q?q[1]:localStorage.getItem('hangfire.theme');if(q){localStorage.setItem('hangfire.theme',t);}if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
    }

    <link rel="stylesheet" href="@Url.To($"/css{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.StylesheetsHashCode)}")">
    @if (DashboardOptions.DarkModeEnabled)
    {
        @: <link rel="stylesheet" id="hfDarkStylesheet" media="(prefers-color-scheme: dark)" href="@Url.To($"/css-dark{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.StylesheetsDarkModeHashCode)}")">
    }
</head>
    <body class="hf-app">
        <div id="wrap">
            <aside class="hf-sidebar" id="hfSidebar" aria-label="Navigation">
                <a class="hf-brand" href="@Url.Home()">
                    <span class="hf-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M3 1.5h2v5.3h6V1.5h2v13h-2V8.8H5v5.7H3z"/></svg>
                    </span>
                    <span class="hf-brand-text">@Html.Raw(DashboardOptions.DashboardTitle)</span>
                </a>

                <nav class="hf-nav">
                    @Html.RenderPartial(new Navigation())
                </nav>

                <div class="hf-sidebar-footer">
                    @if (DashboardOptions.DarkModeEnabled)
                    {
                        <div class="hf-theme js-theme" role="group" aria-label="@Strings.LayoutPage_Theme">
                            <button type="button" data-theme-choice="system" title="@Strings.LayoutPage_Theme_System"><span class="glyphicon glyphicon-adjust"></span></button>
                            <button type="button" data-theme-choice="light" title="@Strings.LayoutPage_Theme_Light"><span class="glyphicon glyphicon-certificate"></span></button>
                            <button type="button" data-theme-choice="dark" title="@Strings.LayoutPage_Theme_Dark"><span class="glyphicon glyphicon-star-empty"></span></button>
                        </div>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if (AppPath != null)
                    {
                        <a href="@AppPath" title="@Strings.LayoutPage_Back"><span class="glyphicon glyphicon-log-out"></span> @Strings.LayoutPage_Back</a>
                    }
                    else
                    {
                        <span>Hangfire @($"{version.Major}.{version.Minor}.{version.Build}")</span>
                    }
                </div>
            </aside>

            <div class="hf-main">
                <header class="hf-topbar">
                    <button type="button" class="hf-topbar-toggle js-sidebar-toggle" aria-label="@Strings.LayoutPage_Menu"><span class="glyphicon glyphicon-menu-hamburger"></span></button>
                    <div class="hf-topbar-title">@Title</div>
                    <div class="hf-topbar-spacer"></div>
                    <span class="hf-pulse" title="@Strings.LayoutPage_Search_Hint">
                        <span class="hf-pulse-dot js-pulse-dot"></span>
                        <span class="hf-pulse-text js-pulse-text">@Strings.LayoutPage_Live</span>
                    </span>
                    <button type="button" class="hf-icon-button js-page-refresh" title="@Strings.LayoutPage_Refresh" aria-label="@Strings.LayoutPage_Refresh">
                        <span class="glyphicon glyphicon-refresh"></span>
                    </button>
                    <button type="button" class="hf-search js-palette-open" title="@Strings.LayoutPage_Search_Hint">
                        <span class="glyphicon glyphicon-search"></span>
                        <span class="hf-search-text">@Strings.LayoutPage_Search</span>
                        <kbd>Ctrl</kbd><kbd>K</kbd>
                    </button>
                </header>

                @Html.RenderPartial(new ErrorAlert())

                <main class="hf-content js-page-container">
                    @RenderBody()
                </main>

                <footer class="hf-footer" id="footer">
                    <ul class="list-inline credit">
                        <li>
                            <a href="https://www.hangfire.io/" target="_blank" rel="noopener noreferrer">Hangfire @($"{version.Major}.{version.Minor}.{version.Build}")</a>
                        </li>
                        @if(DashboardOptions.DisplayStorageConnectionString){
                        <li>@Storage @($"{storageVersion.Major}.{storageVersion.Minor}.{storageVersion.Build}")</li>
                        }
                        @if (StorageUtcNow.HasValue)
                        {
                            <li>@Strings.LayoutPage_Footer_StorageTime @Html.LocalTime(StorageUtcNow.Value)</li>
                        }
                        <li>
                            @if (TimeDifference.HasValue && Math.Abs(TimeDifference.Value.TotalSeconds) > 30)
                            {
                                <span class="text-warning" title="@Strings.LayoutPage_Footer_TimeIsOutOfSync">
                                    <span class="glyphicon glyphicon-warning-sign"></span>&nbsp;@Strings.LayoutPage_Footer_Time @Html.LocalTime(ApplicationUtcNow)
                                </span>
                            }
                            else
                            {
                                <span>@Strings.LayoutPage_Footer_Time @Html.LocalTime(ApplicationUtcNow)</span>
                            }
                        </li>
                        <li>@String.Format(Strings.LayoutPage_Footer_Generatedms, GenerationTime.Elapsed.TotalMilliseconds.ToString("N"))</li>
                    </ul>
                </footer>
            </div>
        </div>

        <div id="hangfireConfig"
             data-pollinterval="@DashboardOptions.StatsPollingInterval"
             data-pollurl="@(Url.To("/stats"))"
             data-liveurl="@(Url.To("/jobs/live"))"
             data-text-refresh="@Strings.LayoutPage_Refresh"
             data-text-live="@Strings.LayoutPage_LiveToggle"
             data-text-live-hint="@Strings.LayoutPage_LiveToggle_Hint"
             data-darkmode="@(DashboardOptions.DarkModeEnabled.ToString().ToLowerInvariant())">
        </div>

        <script src="@Url.To($"/js{version.Major}{version.Minor}{version.Build}0{Math.Abs(DashboardRoutes.JavaScriptsHashCode)}")"></script>
    </body>
</html>
