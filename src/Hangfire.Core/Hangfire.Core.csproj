<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Hangfire</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoreLinq.Source.MoreEnumerable.Pairwise" PrivateAssets="all" />
    <PackageReference Include="LibLog" PrivateAssets="all" />
    <PackageReference Include="Cronos" />
    <PackageReference Include="StackTraceFormatter.Source" PrivateAssets="all" />
    <PackageReference Include="StackTraceParser.Source" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Lowest supported version on purpose, so consumers are free to pick any newer one -->
    <PackageReference Include="Newtonsoft.Json" VersionOverride="11.0.1" NoWarn="NU1903" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="Microsoft.CSharp" />
  </ItemGroup>
  
  <!-- Full MSBuild is required to generate Razor classes -->
  <PropertyGroup>
    <MSBuild14FullPath>$(MSBuildProgramFiles32)\..\Windows\Microsoft.NET\Framework64\v4.0.30319\MSBuild.exe</MSBuild14FullPath>
    <!-- RazorGenerator is a .NET Framework task. The .NET 10 SDK ships its own MSBuild.exe, which can't load it -->
    <MSBuildCurrentFullPath Condition="'$(MSBuildRuntimeType)' == 'Full'">$(MSBuildBinPath)\MSBuild.exe</MSBuildCurrentFullPath>
    <RazorProjectFile>Razor.build</RazorProjectFile>
    <RazorGeneratorTargets>$(MSBuildThisFileDirectory)..\..\packages\RazorGenerator.MsBuild.2.5.0\build\RazorGenerator.MsBuild.targets</RazorGeneratorTargets>
  </PropertyGroup>

  <Target Name="GenerateRazorClasses" BeforeTargets="Build" Condition="Exists('$(RazorGeneratorTargets)')">
    <Exec Command="&quot;$(MSBuildCurrentFullPath)&quot; $(RazorProjectFile) /v:quiet /nologo" Condition="Exists('$(MSBuildCurrentFullPath)')" />
    <Exec Command="&quot;$(MSBuild14FullPath)&quot; $(RazorProjectFile) /v:quiet /nologo" Condition="Exists('$(MSBuild14FullPath)') and !Exists('$(MSBuildCurrentFullPath)')" />
    <Warning Text="Classes for Razor files (*.cshtml) weren't re-generated: couldn't find the '$(MSBuild14FullPath)' or '$(MSBuildCurrentFullPath)' file" Condition="!Exists('$(MSBuild14FullPath)') and !Exists('$(MSBuildCurrentFullPath)')" />
  </Target>

  <Target Name="WarnRazorGeneratorMissing" BeforeTargets="Build" Condition="!Exists('$(RazorGeneratorTargets)')">
    <Warning Text="Classes for Razor files (*.cshtml) weren't re-generated: RazorGenerator.MsBuild isn't restored into the 'packages' folder (run build.bat once)" />
  </Target>
  
