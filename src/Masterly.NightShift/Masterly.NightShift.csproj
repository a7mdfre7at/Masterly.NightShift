<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version, authors, repository, license, icon and packed files come from src/Directory.Build.props. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Background jobs that work the night shift: fire-and-forget, delayed, recurring and continuation jobs for .NET, stored in SQL Server, with a dashboard. Installs the core library, SQL Server storage and the ASP.NET Core integration.</Description>
    <PackageTags>Background;Jobs;Scheduler;Recurring;Delayed;FireAndForget;Queue;Dashboard;Cron;SqlServer;Worker;OpenTelemetry;Hangfire;Masterly;Csharp;DotNet</PackageTags>
    <RootNamespace>Masterly.NightShift</RootNamespace>
    <!-- A meta-package: it has no assembly of its own, only the dependencies below -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>false</EnablePackageValidation>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.Core\Masterly.NightShift.Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Masterly.NightShift.SqlServer\Masterly.NightShift.SqlServer.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Masterly.NightShift.AspNetCore\Masterly.NightShift.AspNetCore.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
