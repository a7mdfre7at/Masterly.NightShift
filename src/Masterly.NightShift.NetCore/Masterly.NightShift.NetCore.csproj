<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Masterly.NightShift for the generic host: dependency injection, ILogger logging and the job server as a hosted service, for Worker Services and console apps.</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeSource>README.md</PackageReadmeSource>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Masterly.NightShift</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.Core\Masterly.NightShift.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- Versions differ per target framework, see Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
