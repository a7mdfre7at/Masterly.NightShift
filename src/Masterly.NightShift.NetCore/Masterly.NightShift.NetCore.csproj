<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version, authors, repository, license, icon and packed files come from src/Directory.Build.props. -->
  <PropertyGroup>
    <!-- This package ships its own README.md; only the meta-package packs README.nuget.md. -->
    <PackageReadmeSource>$(MSBuildProjectDirectory)/README.md</PackageReadmeSource>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Masterly.NightShift for the generic host: dependency injection, ILogger logging and the job server as a hosted service, for Worker Services and console apps.</Description>
    <PackageTags>Background;Jobs;Hosting;DependencyInjection;DI;Logging;HostedService;Worker;Hangfire;Masterly;Csharp;DotNet</PackageTags>
    <RootNamespace>Masterly.NightShift</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.NightShift.Core\Masterly.NightShift.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- Versions differ per target framework, see Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- Global usings, next to the implicit ones of the SDK -->
  <ItemGroup>
    <Using Include="Masterly.NightShift.Annotations" />
    <Using Include="System.Diagnostics.CodeAnalysis.NotNullWhenAttribute" Alias="NotNullWhenAttribute" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
