<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <!-- The SDK writes the version attributes (AssemblyVersion, AssemblyFileVersion, AssemblyInformationalVersion) from
         <Version> below, and AssemblyCompany, AssemblyProduct and AssemblyCopyright from the properties next to it. Titles
         and descriptions are written by hand in each project's Properties/AssemblyInfo.cs, the rest in SharedAssemblyInfo.cs. -->
    <PropertyGroup>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <LangVersion>Latest</LangVersion>
        <CheckNotRecommendedTargetFramework>false</CheckNotRecommendedTargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    </ItemGroup>

    <!-- Plugging in Roslyn Analysers -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <!-- CA1510-CA1513, CA1837, CA1845-CA1847, CA1850, CA1863-CA1867, CA1870, CA2249 and CA2263 suggest APIs that
         netstandard2.0 doesn't have (ArgumentNullException.ThrowIfNull, span overloads, SearchValues, generic Enum
         methods...). Every file also compiles for netstandard2.0, so following them would need #if at each call. -->
    <PropertyGroup>
        <NoWarn>CA1200;CA1859;1591;CA1510;CA1511;CA1512;CA1513;CA1837;CA1845;CA1846;CA1847;CA1850;CA1863;CA1864;CA1865;CA1866;CA1867;CA1870;CA2249;CA2263</NoWarn>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Package metadata shared by every Masterly.NightShift package. Raise <Version> to publish a new release; the
         assembly versions follow it. The packages contain code under the MIT license and code derived from Hangfire under
         the LGPL v3 or later (see NOTICE.md), so both licenses apply and both texts, with the GPL v3 the LGPL builds on,
         are packed. -->
    <PropertyGroup>
        <Version>1.0.0</Version>
        <Authors>Ahmad Omar Al-Freihat</Authors>
        <Company>Masterly</Company>
        <Product>Masterly.NightShift</Product>
        <Copyright>Copyright © 2026 Ahmad Al-Freihat</Copyright>
        <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.NightShift</PackageProjectUrl>
        <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.NightShift</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Background;Jobs;Scheduler;Recurring;Delayed;FireAndForget;Queue;Dashboard;Cron</PackageTags>
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseExpression>MIT AND LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReleaseNotes>See https://github.com/a7mdfre7at/Masterly.NightShift/blob/main/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <!-- What every package ships next to the assemblies -->
    <ItemGroup>
        <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE-LGPL-3.0.txt" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE-GPL-3.0.txt" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Every `dotnet pack` checks that the public API agrees across target frameworks. There is no
         baseline release yet. Set PackageValidationBaselineVersion once the first release is on nuget.org. -->
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
