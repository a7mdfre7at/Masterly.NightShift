<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <!-- The SDK writes the version attributes (AssemblyVersion, AssemblyFileVersion, AssemblyInformationalVersion) from
         <Version> below, and AssemblyCompany, AssemblyProduct and AssemblyCopyright from the properties next to it. Titles
         and descriptions are written by hand in each project's Properties/AssemblyInfo.cs, the rest in SharedAssemblyInfo.cs. -->
    <PropertyGroup>
        <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Symbols and reproducible builds. SourceLink for GitHub ships with the .NET 8+ SDK, so no package reference is
         needed. ContinuousIntegrationBuild (below) normalises the PDB source paths, so it is on only in GitHub Actions:
         local builds keep real paths for debugging. -->
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
    </ItemGroup>

    <!-- Plugging in Roslyn Analysers -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <!-- CA1863 (cache a CompositeFormat) doesn't fit: the dashboard formats localized resource strings, which change
         with the UI culture, so a cached format would freeze one language. -->
    <PropertyGroup>
        <NoWarn>CA1200;CA1859;CA1863;1591</NoWarn>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Package metadata shared by every Masterly.NightShift package; Description and PackageTags are in each .csproj.
         Raise <Version> to publish a new release; the assembly versions follow it. Core, SqlServer, NetCore and
         AspNetCore contain code under the MIT license and code derived from Hangfire under the LGPL v3 or later (see
         NOTICE.md), so both licenses apply and both texts, with the GPL v3 the LGPL builds on, are packed. A package
         without Hangfire-derived files (the other storages and the meta-package) sets PackageLicenseExpression to MIT
         in its .csproj, and the LGPL and GPL texts are then left out. -->
    <PropertyGroup>
        <Version>1.0.0</Version>
        <Authors>Ahmad Omar Al-Freihat</Authors>
        <Company>Masterly</Company>
        <Product>Masterly.NightShift</Product>
        <Copyright>Copyright (c) 2026 Ahmad Omar Al-Freihat</Copyright>
        <!-- The "Project website" link on nuget.org: the documentation site. The source is RepositoryUrl. -->
        <PackageProjectUrl>https://a7mdfre7at.github.io/Masterly.NightShift/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.NightShift</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- The packed README.md. The meta-package packs README.nuget.md; every other package sets this to its own
             src/<Package>/README.md. Links in these files are absolute, because relative links break on nuget.org. -->
        <PackageReadmeSource>$(MSBuildThisFileDirectory)..\README.nuget.md</PackageReadmeSource>
        <PackageIcon>repo_image.png</PackageIcon>
        <PackageLicenseExpression>MIT AND LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReleaseNotes>Release notes for version $(Version): https://github.com/a7mdfre7at/Masterly.NightShift/blob/master/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <!-- What every package ships next to the assemblies. Items are evaluated after every property, so a
         PackageReadmeSource or PackageLicenseExpression set in a .csproj takes effect here. -->
    <ItemGroup>
        <None Include="$(PackageReadmeSource)" Pack="true" PackagePath="\README.md" Visible="false" />
        <None Include="..\..\repo_image.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
    <ItemGroup Condition="$(PackageLicenseExpression.Contains('LGPL'))">
        <None Include="..\..\LICENSE-LGPL-3.0.txt" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE-GPL-3.0.txt" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Every `dotnet pack` checks that the public API agrees across target frameworks. There is no
         baseline release yet. Set PackageValidationBaselineVersion once the first release is on nuget.org. -->
    <PropertyGroup>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
