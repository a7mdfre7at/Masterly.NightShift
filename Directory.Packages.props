<Project>
    <!-- Central Package Management: every package version used in the repository lives here.
         Library packages intentionally reference the lowest versions they support, so consumers
         are free to choose newer ones. Raising them changes the public dependency surface. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Build tooling">
        <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup Label="Hangfire.Core">
        <PackageVersion Include="Cronos" Version="0.11.1" />
        <PackageVersion Include="LibLog" Version="1.5.0" />
        <PackageVersion Include="Microsoft.CSharp" Version="4.4.0" />
        <PackageVersion Include="MoreLinq.Source.MoreEnumerable.Pairwise" Version="1.0.1" />
        <!-- Hangfire.Core overrides this with its lowest supported version, 11.0.1 -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageVersion Include="StackTraceFormatter.Source" Version="1.1.0" />
        <PackageVersion Include="StackTraceParser.Source" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup Label="Hangfire.SqlServer">
        <PackageVersion Include="Dapper" Version="2.1.28" />
    </ItemGroup>

    <ItemGroup Label="Hangfire.AspNetCore (netstandard2.0)">
        <PackageVersion Include="Microsoft.AspNetCore.Antiforgery" Version="2.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.0.0" />
        <!-- First patched versions of vulnerable transitive dependencies of Antiforgery 2.0.0 -->
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="4.7.1" />
        <PackageVersion Include="System.Text.Encodings.Web" Version="4.5.1" />
    </ItemGroup>

    <!-- Hangfire.NetCore depends on the lowest abstractions version of each target framework -->
    <ItemGroup Label="Hangfire.NetCore (netstandard2.0)" Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="2.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="2.0.0" />
    </ItemGroup>

    <ItemGroup Label="Hangfire.NetCore (net8.0)" Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Label="Hangfire.NetCore (net10.0)" Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup Label="Build-time dashboard page generator (never shipped)">
        <PackageVersion Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
        <!-- The oldest Roslyn the generator needs, so it also loads in older compilers -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <!-- Don't upgrade to 4.20 or higher, please refer to https://github.com/HangfireIO/Hangfire/issues/2266 -->
        <PackageVersion Include="Moq" Version="4.10.0" />
        <PackageVersion Include="Moq.Sequences" Version="2.1.0" />
        <PackageVersion Include="System.Data.SqlClient" Version="4.9.0" />
        <!-- mtp-off: the classic VSTest runner, so `dotnet test` and its filters work as before -->
        <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup Label="Samples">
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    </ItemGroup>
</Project>
