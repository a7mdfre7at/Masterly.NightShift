<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a sample to copy: it builds job code as C# 7.3, the default language version of .NET Framework and
       netstandard2.0 projects, so the build fails if the job invoker generator ever emits newer syntax -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Masterly.NightShift.Core\Masterly.NightShift.Core.csproj" />
    <ProjectReference Include="..\..\src\Masterly.NightShift.SourceGenerator\Masterly.NightShift.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
